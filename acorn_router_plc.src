IF LimitOverridePD && Input_IsLimit_M && (!INP80 ^ Input_IsInverted_M) THEN BITSET Limit_Invert_W 15
IF LimitOverridePD && Input_IsLimit_M && (INP80 ^ Input_IsInverted_M) THEN BITRST Limit_Invert_W 15

;Invert Limit Inputs
IF LimitOverridePD THEN SV_INVERT_INP65_80_BITS = Limit_Invert_W

;=============================================================================
                            LubeUsePumpTimersStage
;=============================================================================

; METHOD 1 (SS == 0) For lube pumps with internal timers.
;
; When using this method, P179 should be set such that MMM is a
; value that is greater than the cycle time set on the internal timers and
; SS should be set to zero. How much greater MMM needs to be depends on the
; accuracy of the lube pump timers, but it is better to be on the long side
; to ensure proper operation.
;
; Example 1. The internal lube cycle interval is set to 60 minutes.
;            Set P179 = 7500. In this example, as long as the accuracy
;            of the lube timer interval causes the lube to turn on
;            within 75 minutes, it will work. Note that the amount of time
;            that lube is output is usually set with another timer control
;            on the lube pump and it does not factor into the setting of P179.
;
; It should be noted that lube pumps with internal timers may differ on how
; they operate.
;
; (a) For pumps that lube immediately when power is applied and then start timing
; until the next cycle, it is possible to run out of lube quickly on short job
; runs if, after the program has been run, lube power is removed.
;
; (b) For pumps that do not lube until it has been turned on for the interval time,
; it is possible that lube never gets applied if, after the short program has been run,
; lube power is removed.
;
; A short program or job run is defined as a job that finishes before
; the interval setting (60 minutes in the above example).
;
; For the above mentioned reasons, we want the power to be applied for at least
; the amount of time set by the interval timer, noting that if the user decides
; to engage the E-stop to remove power after short jobs, then they risk the
; above mentioned problems according to the type of pump.
;
; On the start of SV_PROGRAM_RUNNING, the lube pump turns on.
; The lube pump is turned off when a program has NOT been
; running continuously for MMM minutes or E-stop is engaged.
; The reason the lube pump is turned off after a program has NOT been
; running for MMM minutes is to prevent lubing when the user leaves for the
; weekend, leaving the machine on and E-stop disengaged.

IF SV_PROGRAM_RUNNING THEN SET LubePump, RST LubeM_T
IF !SV_PROGRAM_RUNNING THEN LubeM_T = LubeM_W, SET LubeM_T
IF LubeM_T || SV_STOP THEN RST LubePump

;=============================================================================
                             LubeUsePLCTimersStage
;=============================================================================
;
; METHOD 2 (SS != 0) For lube pumps that do not have internal timers.
;
;  When using this method P179 should be set so the lube turns on
;  every MMM minutes for SS seconds.
;
;  Example 1.
;    To set the lube pump power to come on for 5 seconds
;    every 10 minutes, set P179 =  1005.
;                                 MMMSS
;  Example 2.
;    To set the lube pump power to come on for 30 seconds
;    every 2 hours, set P179 = 12030
;                              MMMSS
;
; This method will accumulate time while a program is running until
; it reaches MMM minutes, at which time it will apply power
; for SS seconds (unless E-stop is engaged) and then start over. It is
; possible with frequent use of E-stop that a lube cycle is cut short.
;
IF SkinManualLube_M && !LubePump THEN (ManualLubePD)
IF SV_PROGRAM_RUNNING  THEN LubeM_T = LubeM_W, SET LubeM_T
IF StopRunningPD THEN LubeAccumTime_W = LubeAccumTime_W + LubeM_T, RST LubeM_T
IF LubeM_T || ManualLubePump_SV || ManualLubePD || (LubeAccumTime_W + LubeM_T > LubeM_W)
  THEN SET LubePump, LubeS_T = LubeS_W, SET LubeS_T, RST LubeM_T, LubeAccumTime_W = 0
IF LubeS_T || SV_STOP THEN RST LubePump, RST LubeS_T, RST ManualLubePump_SV
IF LubePump THEN (ManualLubeLED)

;==============================================================================
                              KeyboardEventsStage
;==============================================================================
; This stage handles functions that are required for menu navigation
; by CNC12, require multiple keypresses and/or need to be interlocked
; with SV_PC_VIRTUAL_JOGPANEL_ACTIVE and/or AllowKbInput_M.  Regarding
; "AllowKbInput_M": This PLC program reads a bit from a system parameter,
; in this case bit 0 of SV_MACHINE_PARAMETER_170, and sets "AllowKbInput_M"
; If the operator wishes to allow keyboard input
; to trigger PLC events, they must set parameter 170 to a "1"
; (or any odd number for that matter).  It should be mentioned that
; the programmer will not want to interlock all keyboard keys with
; SV_PC_VIRTUAL_JOGPANEL_ACTIVE and/or AllowKbInput_M.  For example:
; The "escape" key must be echoed by the PLC to CNC12 to aid in menu
; navigation.  NOTE: For backward compatibility with CNC10, setting bit 1
; of SV_MACHINE_PARAMETER_148 OR clearing bit 0 of SV_MACHINE_PARAMETER_170
; will disable keyboard jogging.

;To Make following logic easier to read, will combine L & R ctrl, shift, and
; alt keys. We should not only look for the key combination, but ensure other
; modifier keys are not pressed. Example, If Ctrl + Alt + F are pressed, the
; toggle for Fast/Slow jog should not activate, this key combination is used
; by menus in CNC12 and should not be acted on by the PLC unless that specific
; combination is required for the action.
IF Kb_L_Shift_SV || Kb_R_Shift_SV THEN (KbShiftPressed_M)
IF Kb_L_Ctrl_SV || Kb_R_Ctrl_SV THEN (KbCtrlPressed_M)
IF Kb_L_Alt_SV || Kb_R_Alt_SV THEN (KbAltPressed_M)

;-------------------------Not interlocked------------------------
; The code for cycle cancel has been moved to the main stage.
; It is commented out below but remains for reference
;Cycle Cancel
;IF Kb_Escape THEN (KbCycleCancel_M)

;Rapidoverride: Ctrl-r
IF Kb_r_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M THEN (KbTogRapidOver_M)

;----------------Interlocked with AllowKbInput_M-------------------
;KbCycle Start: alt-s
IF Kb_s_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (KbCycleStart_M)

;KbToolCheck_M: Ctrl-t
IF Kb_t_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbToolCheck_M)

;KbTogSingleBlock_M: ctrl-b
IF Kb_b_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbTogSingleBlock_M)

;KbTogSpinAutoMan_M: ctrl-a
IF Kb_a_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbTogSpinAutoMan_M)

;KbSpinCW_M: ctrl-c
IF Kb_c_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN SET KbSpinCW_M,
                                                                                             RST KbSpinCCW_M

;KbSpinCCW_M: ctrl-w
IF Kb_w_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN SET KbSpinCCW_M,
                                                                                             RST KbSpinCW_M

;KbSpinStart_M:  ctrl-s
IF Kb_s_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbSpinStart_M)

;KbSpindle stop: Ctrl-q
IF Kb_q_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbSpinStop_M)

;KbIncSpinOver_M: ctrl (">")
IF Kb_Period_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbIncSpinOver_M)

;KbDecSpinOver_M: ctrl ("<")
IF Kb_Comma_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbDecSpinOver_M)

;KbSpinOver100_M: ctrl + /
IF Kb_Slash_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbSpinOver100_M)

;KbTogCoolAutoMan_M: Ctrl-m
IF Kb_m_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbTogCoolAutoMan_M)

;KbFloodOnOff_M: Ctrl-n
IF Kb_n_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbFloodOnOff_M)

;KbMistOnOff_M: Ctrl-k
IF Kb_k_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbMistOnOff_M)

;KbTogIncContJog_M: "ctrl" +  "i"
IF Kb_i_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbTogIncContJog_M)

;KbTogFastSlowJog_M: "ctrl" + "f"
IF Kb_f_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbTogFastSlowJog_M)

;KbAux1Key_M: "ctrl" + "F1"
IF Kb_F1_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux1Key_M)

;KbAux2Key_M: "ctrl" + "F2"
IF Kb_F2_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux2Key_M)

;KbAux3Key_M: "ctrl" + "F3"
IF Kb_F3_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux3Key_M)

;KbAux4Key_M: "ctrl" + "F4"
IF Kb_F4_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux4Key_M)

;KbAux5Key_M: "ctrl" + "F5"
IF Kb_F5_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux5Key_M)

;KbAux6Key_M: "ctrl" + "F6"
IF Kb_F6_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux6Key_M)

;KbAux7Key_M: "ctrl" + "F7"
IF Kb_F7_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux7Key_M)

;KbAux8Key_M: "ctrl" + "F8"
IF Kb_F8_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux8Key_M)

;KbAux9Key_M: "ctrl" + "F9"
IF Kb_F9_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux9Key_M)

;KbAux10Key_M: "ctrl" + "F10"
IF Kb_F10_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux10Key_M)

;KbAux11Key_M: "ctrl" + "F11"
IF Kb_F11_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux11Key_M)

;KbAux12Key_M: "ctrl" + "F12"
IF Kb_F12_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux12Key_M)

;KbAux13Key_M: "ctrl" + "1"
IF Kb_1_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux13Key_M)

;KbAux14Key_M: "ctrl" + "2"
IF Kb_2_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux14Key_M)

;KbAux15Key_M: "ctrl" + "3"
IF Kb_3_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux15Key_M)

;KbAux16Key_M: "ctrl" + "4"
IF Kb_4_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (KbAux16Key_M)

;KbIncFeedOver_M: "ctrl" + "keyboard +" (actually "=")
IF (Kb_Equals_SV || Kb_Num_Plus_SV) && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M
  THEN (KbIncFeedOver_M)

;KbDecFeedOver_M: "ctrl" + "keyboard -"
IF (Kb_Hyphen_SV || Kb_Num_Sub_SV) && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M
  THEN (KbDecFeedOver_M)

;KbFeedOver100_M: "ctrl" + "keyboard \"
IF Kb_Backslash_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M
  THEN (KbFeedOver100_M)

;--------Interlocked with AllowKbInput_M && KbJpActive_M-----------

;KbIncreaseJogInc_M: "insert"
IF Kb_Ins_SV && !KbShiftPressed_M && !KbCtrlPressed_M && !KbAltPressed_M &&
  AllowKbInput_M && KbJpActive_M THEN (KbIncreaseJogInc_M)
IF KbIncreaseJogInc_M && x1JogLED_O && !X1_M && !X10_M && !X100_M
  THEN SET X10_M
IF KbIncreaseJogInc_M && x10JogLED_O && !X1_M && !X10_M && !X100_M
  THEN SET X100_M

;KbDecreaseJogInc_M: "delete"
IF Kb_Del_SV && !KbShiftPressed_M && !KbCtrlPressed_M && !KbAltPressed_M &&
  AllowKbInput_M && KbJpActive_M THEN (KbDecreaseJogInc_M)
IF KbDecreaseJogInc_M && x10JogLED_O && !X1_M && !X10_M && !X100_M
  THEN SET X1_M
IF KbDecreaseJogInc_M && x100JogLED_O && !X1_M && !X10_M && !X100_M
  THEN SET X10_M

IF !KbIncreaseJogInc_M && !KbDecreaseJogInc_M THEN RST X1_M, RST X10_M,
  RST X100_M

;KbJogAx1Plus_M: "ctrl" + "right arrow" or "numpad 6"
IF (Kb_Right_SV || Kb_Num_6_SV) && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M &&
  AllowKbInput_M && KbJpActive_M THEN (KbJogAx1Plus_M)

;KbJogAx1Minus_M: "ctrl" + "left arrow" or "numpad 4"
IF (Kb_Left_SV || Kb_Num_4_SV) && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M &&
  AllowKbInput_M && KbJpActive_M THEN (KbJogAx1Minus_M)

;KbJogAx2Plus_M: "ctrl" + "up arrow" or "numpad 8"
IF (Kb_Up_SV || Kb_Num_8_SV) && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M &&
  AllowKbInput_M && KbJpActive_M THEN (KbJogAx2Plus_M)

;KbJogAx1Minus_M: "ctrl" + "down arrow" or "numpad 2"
IF (Kb_Down_SV || Kb_Num_2_SV) && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M &&
  AllowKbInput_M && KbJpActive_M THEN (KbJogAx2Minus_M)

;KbJogAx3Plus_M: "ctrl" + "page up"
IF Kb_PgUp_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx3Plus_M)

;KbJogAx3Minus_M: "ctrl" + "page down"
IF Kb_PgDown_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx3Minus_M)

;KbAx4PlusJog: "ctrl" + "home"
IF Kb_Home_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx4Plus_M)

;KbAx4MinusJog: "ctrl" + "end"
IF Kb_End_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx4Minus_M)

;KbJogAx1MinusAx2Plus: "ctrl" + "numpad 7"
IF Kb_Num_7_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx1MinusAx2Plus_M)

;KbJogAx1Ax2Plus: "ctrl" + "numpad 9"
IF Kb_Num_9_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx1Ax2Plus_M)

;KbJogAx1Ax2Minus: "ctrl" + "numpad 1"
IF Kb_Num_1_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx1Ax2Minus_M)

;KbJogAx1PlusAx2Minus: "ctrl" + "numpad 3"
IF Kb_Num_3_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M && KbJpActive_M
  THEN (KbJogAx1PlusAx2Minus_M)

IF True_M THEN RST KeyboardEventsStage

;==============================================================================
                                 ShuttleStage
;==============================================================================
;--Cycle Selected Axis
IF Kb_9_SV && !KbShiftPressed_M && KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M
  THEN (ShuttleAxisSelectKey)

IF (!SV_PROGRAM_RUNNING || SV_MDI_MODE) && ShuttleAxisSelectKey THEN (ShuttleAxisSelectPD)

;Increment ShuttleAxisSelect_W by 1
IF ShuttleAxisSelectPD THEN ShuttleAxisSelect_W = ShuttleAxisSelect_W + 1

;Handle Rollover
IF ShuttleAxisSelect_W > 4 THEN ShuttleAxisSelect_W = 0

;Disable Axis Selection if Fault or Program Running
IF SV_STOP || (SV_PROGRAM_RUNNING && !SV_MDI_MODE) THEN ShuttleAxisSelect_W = 0

;Enable Selected Axis
IF ShuttleAxisSelect_W == 1 THEN (ShuttleAxis1Selected)
IF ShuttleAxisSelect_W == 2 THEN (ShuttleAxis2Selected)
IF ShuttleAxisSelect_W == 3 THEN (ShuttleAxis3Selected)
IF ShuttleAxisSelect_W == 4 THEN (ShuttleAxis4Selected)

;Enable Shuttle
IF ShuttleAxisSelect_W > 0 && (!SV_PROGRAM_RUNNING || SV_MDI_MODE) THEN (ShuttleEnabled)

;--Jogging
;Plus Continuous Jogging Keys
IF Kb_q_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle10_OverPlusKey)
IF Kb_w_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle35_OverPlusKey)
IF Kb_e_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle75_OverPlusKey)
IF Kb_r_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle100_OverPlusKey)
IF Kb_y_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle135_OverPlusKey)
IF Kb_u_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle175_OverPlusKey)
IF Kb_o_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle200_OverPlusKey)
IF (Shuttle10_OverPlusKey || Shuttle35_OverPlusKey || Shuttle75_OverPlusKey ||
  Shuttle100_OverPlusKey || Shuttle135_OverPlusKey || Shuttle175_OverPlusKey ||
  Shuttle200_OverPlusKey) THEN (ShuttleAxisJogContPlus)

;Minus Continuous Jogging Keys
IF Kb_z_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle10_OverMinusKey)
IF Kb_x_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle35_OverMinusKey)
IF Kb_c_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle75_OverMinusKey)
IF Kb_b_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle100_OverMinusKey)
IF Kb_n_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle135_OverMinusKey)
IF Kb_g_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle175_OverMinusKey)
IF Kb_h_SV && !KbShiftPressed_M && !KbCtrlPressed_M && KbAltPressed_M && AllowKbInput_M THEN (Shuttle200_OverMinusKey)
IF (Shuttle10_OverMinusKey || Shuttle35_OverMinusKey || Shuttle75_OverMinusKey ||
  Shuttle100_OverMinusKey || Shuttle135_OverMinusKey || Shuttle175_OverMinusKey ||
  Shuttle200_OverMinusKey) THEN (ShuttleAxisJogContMinus)

;Incremental Jogging Keys
IF Kb_PgUp_SV && !KbShiftPressed_M && !KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (ShuttleIncJogPlus)
IF Kb_PgDown_SV && !KbShiftPressed_M && !KbCtrlPressed_M && !KbAltPressed_M && AllowKbInput_M THEN (ShuttleIncJogMinus)

;Jog Plus
IF ShuttleAxisJogContPlus || ShuttleIncJogPlus THEN (ShuttleAxisJogPlusKey)

;Jog Minus
IF ShuttleAxisJogContMinus || ShuttleIncJogMinus THEN (ShuttleAxisJogMinusKey)

;--Set Jog Rate
IF ShuttleEnabled && (Shuttle10_OverMinusKey  || Shuttle10_OverPlusKey)  THEN KbOverride_W = 10
IF ShuttleEnabled && (Shuttle35_OverMinusKey  || Shuttle35_OverPlusKey)  THEN KbOverride_W = 35
IF ShuttleEnabled && (Shuttle75_OverMinusKey  || Shuttle75_OverPlusKey)  THEN KbOverride_W = 75
IF ShuttleEnabled && (Shuttle100_OverMinusKey || Shuttle100_OverPlusKey) THEN KbOverride_W = 100
IF ShuttleEnabled && (Shuttle135_OverMinusKey || Shuttle135_OverPlusKey) THEN KbOverride_W = 135
IF ShuttleEnabled && (Shuttle175_OverMinusKey || Shuttle175_OverPlusKey) THEN KbOverride_W = 175
IF ShuttleEnabled && (Shuttle200_OverMinusKey || Shuttle200_OverPlusKey) THEN KbOverride_W = 200

;--Display Messages
;Increase Incremental Jog
IF KbIncreaseJogInc_M THEN InfoMsg_W = JOG_INCREMENT_INCREASED

;Decrease Incremental Jog
IF KbDecreaseJogInc_M THEN InfoMsg_W = JOG_INCREMENT_DECREASED

;-Select Axis Messages
IF ShuttleAxisSelectPD && ShuttleAxis1Selected THEN InfoMsg_W = SHUTTLE_AXIS1_SELECTED
IF ShuttleAxisSelectPD && ShuttleAxis2Selected THEN InfoMsg_W = SHUTTLE_AXIS2_SELECTED
IF ShuttleAxisSelectPD && ShuttleAxis3Selected THEN InfoMsg_W = SHUTTLE_AXIS3_SELECTED
IF ShuttleAxisSelectPD && ShuttleAxis4Selected THEN InfoMsg_W = SHUTTLE_AXIS4_SELECTED
IF ShuttleAxisSelectPD && ShuttleAxisSelect_W == 0 THEN InfoMsg_W = SHUTTLE_DISABLED

;Display when No Axis is selected and Jog Key are pressed.
IF (Shuttle10_OverPlusKey || Shuttle35_OverPlusKey || Shuttle75_OverPlusKey || Shuttle100_OverPlusKey ||
  Shuttle135_OverPlusKey || Shuttle175_OverPlusKey || Shuttle200_OverPlusKey || Shuttle10_OverMinusKey ||
  Shuttle35_OverMinusKey || Shuttle75_OverMinusKey || Shuttle100_OverMinusKey || Shuttle135_OverMinusKey ||
  Shuttle175_OverMinusKey || Shuttle200_OverMinusKey) && (ShuttleAxisSelect_W == 0)
  THEN InfoMsg_W = PLEASE_SELECT_AN_AXIS

;==============================================================================
                                   MPGStage
;==============================================================================
;                        MPG Functions
; Turn off the MPG LED if this is first time run.
IF OnAtPowerUp_M THEN RST MPGLED

; Read in the axes set in Parameter 218.
IF True_M THEN UsbMpgActiveAxes_W = SV_MACHINE_PARAMETER_218

; Translate UsbMpgActiveAxes_W to 8 consecutive memory locations starting at UsbMpgAxis1Active_M
IF True_M THEN WTB UsbMpgActiveAxes_W UsbMpgAxis1Active_M 8

; Read in the Axis select knob value.
; Check to see if Knob changed since last scan for later logic.
IF UsbAxisMonitor_W != SV_USB_MPG_AXIS_SELECT THEN (UsbAxisKnobChanged_M)
IF True_M THEN UsbAxisMonitor_W = SV_USB_MPG_AXIS_SELECT

; Read Scale Selector Knob
IF True_M THEN UsbScaleMonitor_W = SV_USB_MPG_SCALE_SELECT

;Use echoed word value for usb mpg axis select so it can be explicitly set to 0 for invalid axes.
IF (SV_USB_MPG_SCALE_SELECT > 100) ||
  ((UsbAxisMonitor_W == 1) && !UsbMpgAxis1Active_M) ||
  ((UsbAxisMonitor_W == 2) && !UsbMpgAxis2Active_M) ||
  ((UsbAxisMonitor_W == 3) && !UsbMpgAxis3Active_M) ||
  ((UsbAxisMonitor_W == 4) && !UsbMpgAxis4Active_M) ||
  ((UsbAxisMonitor_W == 5) && !UsbMpgAxis5Active_M) ||
  ((UsbAxisMonitor_W == 6) && !UsbMpgAxis6Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 0, UsbAxisMonitor_W = 0

;Determine if Axis is Currently Selected
;IF UsbAxisMonitor_W > 0 THEN SET UsbMpgPresent_M

; Enable usb mpg handwheel jogging.
IF SV_USB_MPG_POWER && ((UsbAxisMonitor_W > 0) && UsbScaleMonitor_W <= 100) THEN (UsbMpgOn_M)

;--MPG 1 Enable
; SV_MPG_1_ENABLED must be set for CNC12 to allow handwheel jogging.
; Determine if Valid Axis is Selected
IF ((ShuttleAxis1Selected || (UsbAxisMonitor_W == 1)) && SV_AXIS_VALID_1) ||
   ((ShuttleAxis2Selected || (UsbAxisMonitor_W == 2)) && SV_AXIS_VALID_2) ||
   ((ShuttleAxis3Selected || (UsbAxisMonitor_W == 3)) && SV_AXIS_VALID_3) ||
   ((ShuttleAxis4Selected || (UsbAxisMonitor_W == 4)) && SV_AXIS_VALID_4) ||
   (UsbAxisMonitor_W == 5) && SV_AXIS_VALID_5 ||
   (UsbAxisMonitor_W == 6) && SV_AXIS_VALID_6
   THEN (ValidMpgAxisSelected_M)

; Select axis to move
IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 1) && UsbMpgAxis1Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 1

IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 2) && UsbMpgAxis2Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 2

IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 3) && UsbMpgAxis3Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 3

IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 4) && UsbMpgAxis4Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 4
  
IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 5) && UsbMpgAxis5Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 5
  
IF (SV_USB_MPG_SCALE_SELECT <= 100) && ((UsbAxisMonitor_W == 6) && UsbMpgAxis6Active_M)
  THEN SV_MPG_1_AXIS_SELECT = 6

IF UsbAxisMonitor_W == 0 THEN SV_MPG_1_AXIS_SELECT = 0

;HandWheel Axis Selection
;SV_MACHINE_PARAMETER_441-449 Determines Axis for Encoder Inputs 1-9
IF HandWheel_M && !MPG_M THEN SV_MPG_1_AXIS_SELECT = SV_MACHINE_PARAMETER_441
IF HandWheel_M THEN SV_MPG_2_AXIS_SELECT = SV_MACHINE_PARAMETER_442
IF HandWheel_M THEN SV_MPG_3_AXIS_SELECT = SV_MACHINE_PARAMETER_443
IF HandWheel_M THEN SV_MPG_4_AXIS_SELECT = SV_MACHINE_PARAMETER_444
IF HandWheel_M THEN SV_MPG_5_AXIS_SELECT = SV_MACHINE_PARAMETER_445
IF HandWheel_M THEN SV_MPG_6_AXIS_SELECT = SV_MACHINE_PARAMETER_446
IF HandWheel_M THEN SV_MPG_7_AXIS_SELECT = SV_MACHINE_PARAMETER_447
IF HandWheel_M THEN SV_MPG_8_AXIS_SELECT = SV_MACHINE_PARAMETER_448
IF HandWheel_M THEN SV_MPG_9_AXIS_SELECT = SV_MACHINE_PARAMETER_449

;Handle External Usb Axis Selection for All MPGs
IF True_M THEN ExtUsb_MPGAxisSelect_W = 0
IF ExtUsb_MPGAxis1Select_SV && SV_AXIS_VALID_1 THEN ExtUsb_MPGAxisSelect_W = 1, (ExtUsb_MPGAxis1SelectOut_SV)
IF ExtUsb_MPGAxis2Select_SV && SV_AXIS_VALID_2 THEN ExtUsb_MPGAxisSelect_W = 2, (ExtUsb_MPGAxis2SelectOut_SV)
IF ExtUsb_MPGAxis3Select_SV && SV_AXIS_VALID_3 THEN ExtUsb_MPGAxisSelect_W = 3, (ExtUsb_MPGAxis3SelectOut_SV)
IF ExtUsb_MPGAxis4Select_SV && SV_AXIS_VALID_4 THEN ExtUsb_MPGAxisSelect_W = 4, (ExtUsb_MPGAxis4SelectOut_SV)
IF ExtUsb_MPGAxis5Select_SV && SV_AXIS_VALID_5 THEN ExtUsb_MPGAxisSelect_W = 5, (ExtUsb_MPGAxis5SelectOut_SV)
IF ExtUsb_MPGAxis6Select_SV && SV_AXIS_VALID_6 THEN ExtUsb_MPGAxisSelect_W = 6, (ExtUsb_MPGAxis6SelectOut_SV)

;If Parameters 441-449 are 0 we assume the axis has an axis selector.
IF !MPG_M && SV_MACHINE_PARAMETER_441 == 0 THEN SV_MPG_1_AXIS_SELECT = ExtUsb_MPGAxisSelect_W
IF SV_MACHINE_PARAMETER_442 == 0 THEN SV_MPG_2_AXIS_SELECT = ExtUsb_MPGAxisSelect_W
IF SV_MACHINE_PARAMETER_443 == 0 THEN SV_MPG_3_AXIS_SELECT = ExtUsb_MPGAxisSelect_W
IF SV_MACHINE_PARAMETER_444 == 0 THEN SV_MPG_4_AXIS_SELECT = ExtUsb_MPGAxisSelect_W
IF SV_MACHINE_PARAMETER_445 == 0 THEN SV_MPG_5_AXIS_SELECT = ExtUsb_MPGAxisSelect_W
IF SV_MACHINE_PARAMETER_446 == 0 THEN SV_MPG_6_AXIS_SELECT = ExtUsb_MPGAxisSelect_W
IF SV_MACHINE_PARAMETER_447 == 0 THEN SV_MPG_7_AXIS_SELECT = ExtUsb_MPGAxisSelect_W
IF SV_MACHINE_PARAMETER_448 == 0 THEN SV_MPG_8_AXIS_SELECT = ExtUsb_MPGAxisSelect_W
IF SV_MACHINE_PARAMETER_449 == 0 THEN SV_MPG_9_AXIS_SELECT = ExtUsb_MPGAxisSelect_W

; Enable the Software to read the Wireless MPG or Hardwired MPGs with MPGLED
IF ((MPGLED && HandWheel_M && !MPG_M) || (UsbMpgOn_M && ValidMpgAxisSelected_M)) THEN (SV_MPG_1_ENABLED)
IF MPGLED && SV_MPG_2_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_2_ENABLED)
IF MPGLED && SV_MPG_3_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_3_ENABLED)
IF MPGLED && SV_MPG_4_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_4_ENABLED)
IF MPGLED && SV_MPG_5_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_5_ENABLED)
IF MPGLED && SV_MPG_6_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_6_ENABLED)
IF MPGLED && SV_MPG_7_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_7_ENABLED)
IF MPGLED && SV_MPG_8_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_8_ENABLED)
IF MPGLED && SV_MPG_9_AXIS_SELECT > 0 && !UsbMpgOn_M THEN (SV_MPG_9_ENABLED)

;Select Multiplier
IF x100JogLED_O THEN SV_MPG_1_MULTIPLIER = 100, SV_MPG_2_MULTIPLIER = 100, SV_MPG_3_MULTIPLIER = 100,
                   SV_MPG_4_MULTIPLIER = 100, SV_MPG_5_MULTIPLIER = 100, SV_MPG_6_MULTIPLIER = 100,
                   SV_MPG_7_MULTIPLIER = 100, SV_MPG_8_MULTIPLIER = 100, SV_MPG_9_MULTIPLIER = 100
IF x10JogLED_O THEN SV_MPG_1_MULTIPLIER = 10, SV_MPG_2_MULTIPLIER = 10, SV_MPG_3_MULTIPLIER = 10,
                  SV_MPG_4_MULTIPLIER = 10, SV_MPG_5_MULTIPLIER = 10, SV_MPG_6_MULTIPLIER = 10,
                  SV_MPG_7_MULTIPLIER = 10, SV_MPG_8_MULTIPLIER = 10, SV_MPG_9_MULTIPLIER = 10
IF x1JogLED_O THEN SV_MPG_1_MULTIPLIER = 1, SV_MPG_2_MULTIPLIER = 1, SV_MPG_3_MULTIPLIER = 1,
                 SV_MPG_4_MULTIPLIER = 1, SV_MPG_5_MULTIPLIER = 1, SV_MPG_6_MULTIPLIER = 1,
                 SV_MPG_7_MULTIPLIER = 1, SV_MPG_8_MULTIPLIER = 1, SV_MPG_9_MULTIPLIER = 1

;            Disable "Windup" mode IF anything above x1 selected
IF (SV_MPG_1_MULTIPLIER < 10) THEN (SV_MPG_1_WINDUP_MODE)
IF (SV_MPG_2_MULTIPLIER < 10) THEN (SV_MPG_2_WINDUP_MODE)
IF (SV_MPG_3_MULTIPLIER < 10) THEN (SV_MPG_3_WINDUP_MODE)
IF (SV_MPG_4_MULTIPLIER < 10) THEN (SV_MPG_4_WINDUP_MODE)
IF (SV_MPG_5_MULTIPLIER < 10) THEN (SV_MPG_5_WINDUP_MODE)
IF (SV_MPG_6_MULTIPLIER < 10) THEN (SV_MPG_6_WINDUP_MODE)
IF (SV_MPG_7_MULTIPLIER < 10) THEN (SV_MPG_7_WINDUP_MODE)
IF (SV_MPG_8_MULTIPLIER < 10) THEN (SV_MPG_8_WINDUP_MODE)
IF (SV_MPG_9_MULTIPLIER < 10) THEN (SV_MPG_9_WINDUP_MODE)

;			Set Data to be seen by set axis Macro 0
IF ((SV_USB_MPG_AXIS_SELECT == 1) && UsbMpgAxis1Active_M) THEN (MpgAxis1Selected_M)
IF ((SV_USB_MPG_AXIS_SELECT == 2) && UsbMpgAxis2Active_M) THEN (MpgAxis2Selected_M)
IF ((SV_USB_MPG_AXIS_SELECT == 3) && UsbMpgAxis3Active_M) THEN (MpgAxis3Selected_M)
IF ((SV_USB_MPG_AXIS_SELECT == 4) && UsbMpgAxis4Active_M) THEN (MpgAxis4Selected_M)
IF ((SV_USB_MPG_AXIS_SELECT == 5) && UsbMpgAxis5Active_M) THEN (MpgAxis5Selected_M)
IF ((SV_USB_MPG_AXIS_SELECT == 6) && UsbMpgAxis6Active_M) THEN (MpgAxis6Selected_M)

;Handle WMPG Wheel Delta
; UsbWheelDelta_W is used throughout PLC, we handle the calculation here.
IF True_M THEN UsbWheelCurrent = SV_USB_MPG_ENCODER_WHEEL
IF True_M THEN UsbWheelDelta_W = (UsbWheelCurrent - UsbWheelLast)
IF True_M THEN UsbWheelLast = UsbWheelCurrent

;Set Bit for Wheel Moving.
; Depending on wheel speed, delta may be 0 for some passes of the PLC.
; So we hold the Bit on for set time before turning bit off.
IF True_M THEN SET UsbMpgWheelStopped_T
IF UsbWheelDelta_W != 0 THEN RST UsbMpgWheelStopped_T
IF !UsbMpgWheelStopped_T THEN (UsbMpgWheelMoving_M)

;==============================================================================
                               G540SpindleStage
;The Gecko G540 requires that the spindle outputs for Fwd and Rev are inverted
;==============================================================================

IF OnAtPowerUp_M || SV_STOP || SpinStop_M || M51_SV THEN SET SpindleDisable_M

IF SpinStart_M && !SpinStop_M THEN RST SpindleDisable_M

IF SpindleDisable_M || SpinStop_M
  THEN SET SpindleDisable_M, RST SpindleForward_M, RST SpindleReverse_M

;Outputs must be OFF for spindle to run on G540
;Set some MEM bits if spindle should be on in forward or reverse direction
IF !SpindleDisable_M && !SpindleDirectionOut_M THEN SET SpindleForward_M, RST SpindleReverse_M
IF !SpindleDisable_M && SpindleDirectionOut_M THEN SET SpindleReverse_M, RST SpindleForward_M

;Set state of spindle direction outputs to the inverse of mem bits
;Set state of spindle direction outputs to the inverse of mem bits
IF SpindleForward_M && SpindleBrakeTimer THEN RST G540SpinFwdOff, SET G540SpinRevOff
IF SpindleReverse_M && SpindleBrakeTimer THEN RST G540SpinRevOff, SET G540SpinFwdOff

IF !SpindleForward_M || !SpindleBrakeTimer THEN SET G540SpinFwdOff
IF !SpindleReverse_M || !SpindleBrakeTimer THEN SET G540SpinRevOff

IF (!SpindleForward_M && !SpindleReverse_M) || SpindleDisable_M THEN (DoSpindleStop)

;==============================================================================
                             StandardSpindleStage
;==============================================================================
IF (SpindleEnableOut_M || SpinStart_M ) && !SpinStop_M THEN SET SpindleEnableOut_M
IF !((SpindleEnableOut_M || SpinStart_M ) && !SpinStop_M) THEN RST SpindleEnableOut_M
IF SpindleEnableOut_M && !M37 THEN (VFDEnable_O)
IF  SpindleEnableOut_M && !M37 && !SpindleDirectionOut_M && SpindleBrakeTimer THEN (SpinFWD)
IF  SpindleEnableOut_M && !M37 && SpindleDirectionOut_M && SpindleBrakeTimer THEN (SpinREV), (VFDDirection_O)
IF !SpindleEnableOut_M && SpindleStage THEN (DoSpindleStop)
IF DoSpindleStop THEN (ExtUsb_SpinStopOut_SV)
IF !DoSpindleStop THEN (ExtUsb_SpinStartOut_SV), (ExtUsb_SpinOnOffOut_SV)

;==============================================================================
                          CheckExternalUSBPanelStage
;==============================================================================
;Set Memory Bit to remember that panel was online.
IF ExtUsbPanel1Online_M THEN SET ExtUsbPanel1CheckFault_M
IF ExtUsbPanel2Online_M THEN SET ExtUsbPanel2CheckFault_M
IF ExtUsbPanel3Online_M THEN SET ExtUsbPanel3CheckFault_M
IF ExtUsbPanel4Online_M THEN SET ExtUsbPanel4CheckFault_M

;Check Panels for Faults
IF !SoftwareNotReady_M && ExtUsbPanel1CheckFault_M && !ExtUsbPanel1Online_M
  THEN FaultMsg_W = EXT_USB_PANEL_1_FLT_C
IF !SoftwareNotReady_M && ExtUsbPanel2CheckFault_M && !ExtUsbPanel2Online_M
  THEN FaultMsg_W = EXT_USB_PANEL_2_FLT_C
IF !SoftwareNotReady_M && ExtUsbPanel3CheckFault_M && !ExtUsbPanel3Online_M
  THEN FaultMsg_W = EXT_USB_PANEL_3_FLT_C
IF !SoftwareNotReady_M && ExtUsbPanel4CheckFault_M && !ExtUsbPanel4Online_M
  THEN FaultMsg_W = EXT_USB_PANEL_4_FLT_C

;Input Checking
;Check Certain Inputs on Startup to ensure they are configured properly.
; Assume if a Input is On when Initialize_T is finished, that the input
; is not configured properly for the type of switch and fault.
;Prevents erroneous inputs at startup
;Combine all Inputs into one easy memory Bit
IF ExtUsb_CycleStart_SV || ExtUsb_CycleCancel_SV || ExtUsb_SpinStart_SV || ExtUsb_SpinStop_SV || ExtUsb_ToolRelease_SV
  THEN (ExtUsb_CriticalInputPressed_M)

IF Initialize_T THEN (Initalized_PD)
IF Initalized_PD && ExtUsb_CriticalInputPressed_M THEN SET ExtUsb_InputOnStartup_M

;Clear Fault if no inputs are On.
IF !ExtUsb_CriticalInputPressed_M THEN RST ExtUsb_InputOnStartup_M

;Set a fault if inputs are on and were on during startup.
IF ExtUsb_CriticalInputPressed_M && ExtUsb_InputOnStartup_M THEN FaultMsg_W = EXT_USB_INPUT_SETUP_FLT_C, SET OtherFault_M

;==============================================================================
                                 JogPanelStage
;==============================================================================
;--MPG Key
IF MPGKey || SkinMPG_M || ExtUsb_MPG_SV THEN (MpgPD)
IF MpgPD && MPGLED THEN SET MPGManOffFlag_M
IF (!SV_MPG_1_ENABLED && MPG_M && MPGManOffFlag_M) || (MpgPD && !MPGLED && HandWheel_M) ||
   (UsbAxisKnobChanged_M && ValidMpgAxisSelected_M && MPGManOffFlag_M)
  THEN RST MPGManOffFlag_M

;MPG LED On/Off
IF MPG_M && !SV_MPG_1_ENABLED THEN (MPGOff_PD)
IF ((MpgPD ^ MPGLED) || (SV_MPG_1_ENABLED && MPG_M && !MPGManOffFlag_M) ||
  (ShuttleEnabled && !SV_PROGRAM_RUNNING)) && !MPGOff_PD && !AllJogDisabled_M
  THEN (MPG_LED_OUT), (MPGLED)

IF MPGLED THEN (ExtUsb_MPGOut_SV)

;Lockout X100 Z-Axis if Selected by MPG
IF MpgX100LockOut_M && MPGLED &&
  (((SV_MPG_1_AXIS_SELECT == 3 || ExtUsb_MPGAxisSelect_W == 3) && !MachineIsLathe_M) ||
  ((SV_MPG_1_AXIS_SELECT == 1 || ExtUsb_MPGAxisSelect_W == 1) && MachineIsLathe_M))
  THEN (MpgZAxisLocked_M)

;--Select x1, x10, x100
; When ExtUsb or WMPG Selectors are active, we disable JogPanel/VCP/Keyboard Buttons.
;
; WMPG Dial and ExtUsb Inputs are assumed to be non-momentary switches. WMPG Dial will
; take precedence over all other inputs when WMPG is Active. When not active, ExtUsb
; inputs will then be used if any.
;
; WMPG > ExtUsb > JogPanel/Skinning/Kb
;
; If multiple Inputs are on simultaneously from the ExtUsb, due to the scanning nature of the PLC,
; the last set of logic will overrule above logic, 100X > 10X > 1X
;
;--X1
IF (x1JogKey || SkinX1_M || X1_M) && !(ExtUsb_x10Jog_SV || ExtUsb_x100Jog_SV ||
  (UsbMpgOn_M && MPGLED && ((UsbScaleMonitor_W == 10) || (UsbScaleMonitor_W == 100))))
  THEN (x1JogPD)
IF x1JogPD || OnAtPowerUp_M || (UsbMpgOn_M && MPGLED && (UsbScaleMonitor_W == 1)) ||
  (!(UsbMpgOn_M && MPGLED) && ExtUsb_x1Jog_SV) THEN SET x1JogLED_O, RST x10JogLED_O, RST x100JogLED_O
IF x1JogLED_O THEN (ExtUsb_x1JogOut_SV)

;--X10
IF (x10JogKey || SkinX10_M || X10_M) && !(ExtUsb_x1Jog_SV || ExtUsb_x100Jog_SV ||
  (UsbMpgOn_M && MPGLED && ((UsbScaleMonitor_W == 1) || (UsbScaleMonitor_W == 100))))
  THEN (x10JogPD)
IF x10JogPD || (UsbMpgOn_M && MPGLED && ((UsbScaleMonitor_W == 10) || ((UsbScaleMonitor_W == 100) && (MpgZAxisLocked_M || DoorOpenSlowJog_M)))) ||
  (!(UsbMpgOn_M && MPGLED) && (ExtUsb_x10Jog_SV || (ExtUsb_x100Jog_SV && (MpgZAxisLocked_M || DoorOpenSlowJog_M)))) ||
  (x100JogLED_O && MpgZAxisLocked_M)
  THEN RST x1JogLED_O, SET x10JogLED_O, RST x100JogLED_O
IF x10JogLED_O THEN (ExtUsb_x10JogOut_SV)

;--X100
IF (x100JogKey || SkinX100_M || X100_M) && !(ExtUsb_x1Jog_SV || ExtUsb_x10Jog_SV ||
  (UsbMpgOn_M && MPGLED && ((UsbScaleMonitor_W == 1) || (UsbScaleMonitor_W == 10))))
  THEN (x100JogPD)
IF (x100JogPD || ((UsbMpgOn_M && MPGLED && (UsbScaleMonitor_W == 100)) ||
  (!(UsbMpgOn_M && MPGLED) && ExtUsb_x100Jog_SV))) && !MpgZAxisLocked_M && !DoorOpenSlowJog_M
  THEN RST x1JogLED_O, RST x10JogLED_O, SET x100JogLED_O
IF x100JogLED_O THEN (ExtUsb_x100JogOut_SV)

;----Incremental/Continuous and Jogging Modes----
;SV_MACHINE_PARAMETER_856 = Default jog behavior on startup
;0 = fast/incremental, 1 = fast/continuous,
;2 = slow/incremental, 3 = slow/continuous
IF True_M THEN DefaultJogging_W = SV_MACHINE_PARAMETER_856
IF OnAtPowerUp_M THEN BITTST DefaultJogging_W 0 ContinuousJog_M,
                      BITTST DefaultJogging_W 1 FastJog_M

;--Select Incremental or Continuous Jog Mode
;WMPG Sets Incremental Mode when X1 is selected
IF IncrContKey || KbTogIncContJog_M || SkinIncCont_M || ExtUsb_IncrCont_SV
  THEN (IncrContPD)
IF (IncrContPD && !IncrContLED) || OnAtPowerUp_M && !ContinuousJog_M ||
  x1JogPD || x10JogPD || x100JogPD || ShuttleIncJogPlus || ShuttleIncJogMinus ||
  (UsbMpgOn_M && MPGLED && UsbScaleMonitor_W == 1) THEN SET IncrContLED
IF (IncrContPD && IncrContLED) || (ShuttleAxisJogContPlus || ShuttleAxisJogContMinus) ||
  (UsbMpgOn_M && MPGLED && (UsbScaleMonitor_W == 10 || UsbScaleMonitor_W == 100)) THEN RST IncrContLED
IF IncrContLED THEN (ExtUsb_IncrContOut_SV)

;--Select Fast or Slow Jog Mode
IF (FastSlowKey || KbTogFastSlowJog_M || SkinFastSlowJog_M || ExtUsb_FastSlowJog_SV) THEN (SlowFastPD)
IF (SlowFastPD && !FastSlowLED_O) || (OnAtPowerUp_M && !FastJog_M) ||
  (UsbMpgOn_M && MPGLED && (UsbScaleMonitor_W == 1 || UsbScaleMonitor_W == 10 ||
  (UsbScaleMonitor_W == 100 && MpgZAxisLocked_M))) || DoorOpenSlowJog_M
  THEN SET FastSlowLED_O

IF ((SlowFastPD &&  FastSlowLED_O) || (OnAtPowerUp_M && FastJog_M) ||
  (UsbMpgOn_M && MPGLED && !MpgZAxisLocked_M && UsbScaleMonitor_W == 100)) &&
  !DoorOpenSlowJog_M THEN RST FastSlowLED_O

;Displays Message for selecting fast and slow jog
IF (FastSlowLED_O && SlowFastPD) && !DoorOpenSlowJog_M THEN InfoMsg_W = FAST_JOG_SELECTED
IF !FastSlowLED_O && SlowFastPD THEN InfoMsg_W = SLOW_JOG_SELECTED

;--Single Block Mode
IF SingleBlockKey || KbTogSingleBlock_M || SkinSingleBlock_M || ExtUsb_SingleBlock_SV THEN (SingleBlockPD)
IF SingleBlockPD && !SingleBlockLED && !SV_PROGRAM_RUNNING
  THEN SET SingleBlockLED
IF SingleBlockPD && SingleBlockLED THEN RST SingleBlockLED
IF SingleBlockLED THEN (SelectSingleBlock), (ExtUsb_SingleBlockOut_SV)

;--Toolcheck
;Perform standard Toolcheck unless Plasma Software
IF (ToolCheckKey || KbToolCheck_M || SkinToolCheck_M || MpgToolCheck_M ||
    ToolCheck2 || ExtUsb_ToolCheck_SV) && EStopOk_M &&
    !MachineIsPlasma_M THEN (ToolCheckPD), (ExtUsb_ToolCheckOut_SV)
IF ToolCheckPD THEN (DoToolCheck)

;--Feed Hold Mode
; Note: the feedrate override values used here for testing against P146
; are those calculated in the previous scan.  There is no problem with that.
IF FeedHoldKey || KbFeedHold_M || SkinFeedHold_M || FeedHold2 ||
    (MpgFeedHold_M && !PlasmaWMPG_M) || ExtUsb_FeedHold_SV
    THEN (FeedHoldPD)
IF FeedHoldPD || ActivateFeedHold_M ||
   (FinalFeedOverride_W < P146Value_W && !OnAtPowerUp_M)
  THEN SET FeedHoldLED
IF DoCycleStart || DoCycleCancel || DoToolCheck ||
   (FinalFeedOverride_W >= P146Value_W &&
    PrevFeedOverride_W < P146Value_W)
  THEN RST FeedHoldLED
IF True_M THEN PrevFeedOverride_W = FinalFeedOverride_W

;Echo FeedHold State to ExtUsb
IF FeedHoldLED THEN (ExtUsb_FeedHoldOut_SV)

; (FeedHoldLED will be used later to signal MPU11 to do Feed Hold)

;--Feedrate Override Section
;------------------------------------------------------------------------------
; Feedrate override works as follows:
;
; 1. The PLC reads the 8 bit value of the FeedrateKnob_W directly (0-255)
; 2. The PLC scales this value to a 0-200 value (0-200%) by dividing by
;    the knob value by 127.5 and then multiplying the result by 100
; 3. If keyboard jogging is enabled, the PLC
;    determines whether the operator is using the keyboard override or
;    the FeedrateKnob_W to override the feedrate by watching which was changed
;    most recently.  The most recently changed value is saved as
;    "FinalFeedOverride_W"
; 4. Parameter 39 in (From the "params" screen in CNC12 software) stores
;    a value which the PLC program must use to limit the amount
;    of override applied to the programmed feedrate. This value is specified
;    as a percentage.
; 5. The PLC limits the override percentage by reading parameter 39 and, if
;    the feedrate override percentage as read from the knob is greater than
;    parameter 39, it sets the FinalFeedOverride_W value to the value of
;    parameter 39.
; 6. Once the override percentage has been determined and limited (if needed)
;    The PLC send this value up to the CNC12 software by setting
;    SV_PLC_FEEDRATE_KNOB = FinalFeedOverride_W
; 7. CNC12 reads SV_PLC_FEEDRATE_KNOB, factors in its own override based
;    on parameter 78 (see operators manual for more info on parm 78) and then
;    returns an override value to the PLC in the system variable
;    SV_PC_FEEDRATE_PERCENTAGE
; 8. The PLC reads SV_PC_FEEDRATE_PERCENTAGE and (typically) echoes the system
;    variable to SV_PLC_FEEDRATE_OVERRIDE which the MPU11 uses as the final
;    determination of the feedrate override percentage.
;------------------------------------------------------------------------------
; 1. The PLC reads the 8 bit value of the FeedrateKnob_W directly (0-255)
; NOTE: BTW = Bit To Word
; BTW reads the specified number of bits (if none is specified it defaults to 8)
; starting from a bit location and writes them to a word with the starting bit
; location being written to the LSB of the word used.  Below, BTW reads the bit
; values from JpFeedOrKnobBit0 to JpFeedOrKnobBit7 and writes them into to the
; word "FeedrateKnob_W" which sets FeedrateKnob_W to a value of 0-255
;------------------------------------------------------------------------------
IF True_M THEN FeedrateKnob_W = 1, BTW FeedrateKnob_W JpFeedOrKnobBit0 8

;------------------------------------------------------------------------------
; 2. Scale this value to a 0-200 value (0-200%)
;------------------------------------------------------------------------------
IF True_M THEN FeedrateKnob_W = (FeedrateKnob_W/127.5)*100
IF FeedrateKnob_W <= 1 THEN FeedrateKnob_W = 1

IF FeedrateKnob_W > SV_MACHINE_PARAMETER_39
  THEN FeedrateKnob_W = SV_MACHINE_PARAMETER_39
  
;------------------------------------------------------------------------------
; 3.  Determine whether to use FeedrateKnob_W or KbOverride_W
;------------------------------------------------------------------------------
; This section determines when to use the feedrate override value sent down
; by the jog panel (FeedrateKnob_W) or the feedrate override as determined
; by the PLC monitoring the keyboard override keys (KbOverride_W).
;------------------------------------------------------------------------------
;     At powerup, default feedrate override is Keyboard (KbOverride_W)
;       To use both keyboard or jog panel overrides set p170 to 0 (default)
;       To use jog panel override only set p170 to 2
;       To use keyboard only set p170 to 4
;-----------------------------------------------------------------------------
IF OnAtPowerUp_M && KbOverOnly_M THEN KbOverride_W = 100
IF OnAtPowerUp_M && JogOverOnly_M THEN SET UsingFeedrateKnob_M,
                                       KbOverride_W = FeedrateKnob_W,
									   Last_FeedrateKnob_W = FeedrateKnob_W

;----------------Calculate keyboard and VCP feedrate override-----------------
; SleepTimer is used to limit the KbOverride_W update rate
;-----------------------------------------------------------------------------
IF True_M THEN SkinFeedOverTimer = 200
IF SkinFeedOverMinus_M THEN (SkinFeedOverMinusPD), SET SkinFeedOverTimer
IF SkinFeedOverPlus_M THEN (SkinFeedOverPlusPD), SET SkinFeedOverTimer
IF !SkinFeedOverPlus_M && !SkinFeedOverMinus_M THEN RST SkinFeedOverTimer

IF !WaitingForSleepTimer_M && ((KbIncFeedOver_M || SkinFeedOverPlusPD) || (SkinFeedOverTimer && SkinFeedOverPlus_M))
  THEN KbOverride_W = KbOverride_W + 1,
       RST UsingFeedrateKnob_M,
       SET WaitingForSleepTimer_M,
       SleepTimer = 30, SET SleepTimer

IF !WaitingForSleepTimer_M && ((KbDecFeedOver_M || SkinFeedOverMinusPD) || (SkinFeedOverTimer && SkinFeedOverMinus_M))
  THEN KbOverride_W = KbOverride_W - 1,
		RST UsingFeedrateKnob_M,
		SET WaitingForSleepTimer_M,
		SleepTimer = 30, SET SleepTimer

;MPG Feedrate Override Logic
IF !MpgFeedWheelSelect_M || UsingFeedrateKnob_M THEN RST MpgFeedWheelSet_M
IF (MpgFeedWheelSelect_M && MpgFeedWheelSet_M)
  THEN SET MpgFeedWheelSet_M, RST UsingFeedrateKnob_M
;IF MpgFeedWheelSelect_M && !MpgSetAxisZero_M THEN UsbWheelCurrent = SV_USB_MPG_ENCODER_WHEEL
;IF MpgFeedWheelSelect_M && !MpgSetAxisZero_M THEN UsbWheelDelta_W = (UsbWheelCurrent - UsbWheelLast)
;IF MpgFeedWheelSelect_M && !MpgSetAxisZero_M THEN UsbWheelLast = UsbWheelCurrent
IF MpgFeedWheelSelect_M && !MpgSetAxisZero_M THEN KbOverride_W = (KbOverride_W + UsbWheelDelta_W)

;Ext Usb Feedrate Override Logic
;Divide Knob by 4 as every "tick" is 4 counts.

;Initialize LastKnob Value to Current on Startup. Prevents a "jump" in value
; from occurring on startup if the knob value reported by External panel is not 0.
IF !Initialize_T THEN ExtUsbLastFeedKnob_W = ExtUsbFeedKnob_W / 4
IF Initialize_T THEN ExtUsbFeedDelta_W = (((ExtUsbFeedKnob_W / 4) - ExtUsbLastFeedKnob_W) * SV_MACHINE_PARAMETER_450)
IF Initialize_T && (ExtUsbFeedDelta_W != 0) THEN RST UsingFeedrateKnob_M
IF Initialize_T THEN ExtUsbLastFeedKnob_W = ExtUsbFeedKnob_W / 4

;Check if Software is Ready and if Panel is Online.
; If Software is not ready, then assume panel is still connected but
; 	software was restarted. In this case, we set Delta to 0 until software
;   comes back online.
; If Software is ready and panel is not online, then assume board was unplugged
;	and lost power, we need to set delta to 0 and also set Last Feed Knob to 0.
IF SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbFeedDelta_W = 0
IF !SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbFeedDelta_W = 0,
                                                     ExtUsbLastFeedKnob_W = 0

IF True_M THEN KbOverride_W = (KbOverride_W + ExtUsbFeedDelta_W)

;Feed Rate Override % Buttons
IF SkinFeedOver100_M || KbFeedOver100_M || ExtUsb_FeedOver100_SV THEN KbOverride_W = 100, RST UsingFeedrateKnob_M
IF SkinFeedOver75_M || ExtUsb_FeedOver75_SV THEN KbOverride_W = 75, RST UsingFeedrateKnob_M
IF SkinFeedOver50_M || ExtUsb_FeedOver50_SV THEN KbOverride_W = 50, RST UsingFeedrateKnob_M
IF SkinFeedOver25_M || ExtUsb_FeedOver25_SV THEN KbOverride_W = 25, RST UsingFeedrateKnob_M

;"Custom" % to set Feedrate determined by P454
IF ExtUsb_FeedOverCustom_SV THEN KbOverride_W = SV_MACHINE_PARAMETER_454, RST UsingFeedrateKnob_M

;------------Switch to FeedrateKnob_W if it changes more than 3%--------------
; Once it has changed by more than 3%, it will update as normal (1% increments)
; until it sees another KbOverride_W command at which point it will take
; another 3% change to re-activate the FeedrateKnob_W
IF (ABS(Last_FeedrateKnob_W - FeedrateKnob_W) >= 3) || UsingFeedrateKnob_M
  THEN FinalFeedOverride_W = FeedrateKnob_W, KbOverride_W = FeedrateKnob_W,
       Last_FeedrateKnob_W = FeedrateKnob_W, Set UsingFeedrateKnob_M

;Switch to using Skinning Data
IF SV_SKINNING_DATA_W_1 != 0 THEN KbOverride_W = SV_SKINNING_DATA_W_1, RST UsingFeedrateKnob_M

;Restore Previous KbOverride_W when Skinning Data is Set to 0
IF SV_SKINNING_DATA_W_1 == 0 THEN (RestoreKbOver_PD)
IF RestoreKbOver_PD THEN KbOverride_W = LastSkinFeedOverride_W
IF SV_SKINNING_DATA_W_1 == 0 THEN LastSkinFeedOverride_W = KbOverride_W

;Limit keyboard override to parm 39.  Allowing the FeedrateKnob_W to go past
;parm 39, but keeping the KbOverride_W limited keeps the "dead space"
;down and allows the PLC to respond to changes in the FeedrateKnob_W even if
;above 120. Overall override is still limited later but this gives better
;response in changing between KbOverride_W & the FeedrateKnob_W
IF KbOverride_W > SV_MACHINE_PARAMETER_39
  THEN KbOverride_W = SV_MACHINE_PARAMETER_39

IF KbOverride_W < MIN_FROR_PCT THEN KbOverride_W = MIN_FROR_PCT

If !UsingFeedrateKnob_M && !JogOverOnly_M
  THEN FinalFeedOverride_W = KbOverride_W
  
IF OnAtPowerUp_M THEN FinalFeedOverride_W = 100, KbOverride_W = 100

;Feed Rate Variation (FRV)
;This feature helps reduce chip buildup on the tool by varying the feedrate.
; this causes the tool to in theory cut over the previous cut as the spindle
; turns, removing the chip in the process.
IF ExtUsb_FeedrateVariationMode_SV THEN (FeedrateVariationMode_PD)
IF FeedrateVariationMode_PD ^ FeedrateVariation_SV THEN (FeedrateVariation_SV)

;Set timer when FRV is enabled
IF FeedrateVariation_SV THEN SET FeedrateVariation_T
IF !FeedrateVariation_SV THEN RST FeedrateVariation_T

;Adjust FinalFeedOverride_W over period of time.
;We take the modulo of the the FeedrateVariation_T Timer using P984 and "normalize" it so its a value from 0 to 2.
;This value is then used in the equation F/2 * (1 + Cos (pi * t)), where F is max feedrate %, t is the normalized
; Feedrate Variation cycle time. This will produce a sine wave that will go from Max Feedrate % to 0 and back to
; Max Feedrate %.
IF FeedrateVariation_SV THEN FeedrateVariationCycle_FW = (FeedrateVariation_T % FeedrateVariationCycle_W) / (FeedrateVariationCycle_W / 2.0)
IF FeedrateVariation_SV THEN FinalFeedOverride_W = (KbOverride_W / 2.0) * (1.0 + COS (3.14 * FeedrateVariationCycle_FW))

;FRV Status LED
IF FeedrateVariation_SV THEN (ExtUsb_FeedrateVariationModeOut_SV)

;------------------------------------------------------------------------------
; 4 & 5. Limit override percentage to value set in Parameter 39
;------------------------------------------------------------------------------
;------------------Limit final override percentage to parm 39-------------------
IF FinalFeedOverride_W > SV_MACHINE_PARAMETER_39
  THEN FinalFeedOverride_W = SV_MACHINE_PARAMETER_39

IF FinalFeedOverride_W <= 1 THEN FinalFeedOverride_W = 1

;------------------------------------------------------------------------------
;  Override Controls
;  It is important that the plc program only writes to SV_PLC_FEEDRATE_KNOB once per pass
;------------------------------------------------------------------------------
; Override control bit for the feedrate override
; 1 == feedrate override knob will affect feedrate
; 0 == override knob has NO effect on feedrate
IF  !SV_PC_OVERRIDE_CONTROL_FEEDRATE_OVERRIDE THEN FinalFeedOverride_W = 100

;------------------------------------------------------------------------------
; 6. Send override percentage to CNC12
;------------------------------------------------------------------------------
;----------------Send override to PC for modification if needed---------------
IF True_M THEN SV_PLC_FEEDRATE_KNOB = FinalFeedOverride_W

;Activate LED's
IF FinalFeedOverride_W == 100 THEN (FeedOver100LED), (ExtUsb_FeedOver100Out_SV)
IF FinalFeedOverride_W == 75 THEN (FeedOver75LED), (ExtUsb_FeedOver75Out_SV)
IF FinalFeedOverride_W == 50 THEN (FeedOver50LED), (ExtUsb_FeedOver50Out_SV)
IF FinalFeedOverride_W == 25 THEN (FeedOver25LED), (ExtUsb_FeedOver25Out_SV)
IF FinalFeedOverride_W == SV_MACHINE_PARAMETER_454 THEN (ExtUsb_FeedOverCustomOut_SV)

;------------------------------------------------------------------------------
; 7. Copy the feedrate override sent from the PC to the MPU11.
;------------------------------------------------------------------------------
;------------------------------------------------------------------------------
; Normally a number from 0.0-2.0, no limitations although V will not exceed
; Vmax. A negative number in here would be extremely bad.
;------------------------------------------------------------------------------
IF True_M THEN SV_PLC_FEEDRATE_OVERRIDE = SV_PC_FEEDRATE_PERCENTAGE/100.0

;--Rapidrate Override Section
;Rapid Override Button
IF KbTogRapidOver_M || SV_PC_TOGGLE_RAPID_OVERRIDE || RapidOver_M
  THEN (RapidOverPD), RST SV_PC_TOGGLE_RAPID_OVERRIDE
IF (RapidOverPD ^ SelectRapidOverride) || OnAtPowerUp_M THEN (SelectRapidOverride)

IF RapidOverPD THEN OverrideMsgTimer = 100, SET OverrideMsgTimer

IF SelectRapidOverride THEN (RapidOverLED), (OverrideRapidsEnabled_M)
IF !SelectRapidOverride THEN (OverrideRapidsDisabled_M)

IF RapidOverPD && OverrideRapidsEnabled_M THEN InfoMsg_W = RAPID_OVERRIDE_ENABLED
IF RapidOverPD && OverrideRapidsDisabled_M THEN InfoMsg_W = RAPID_OVERRIDE_DISABLED

IF ((InfoMsg_W == RAPID_OVERRIDE_ENABLED) || (InfoMsg_W == RAPID_OVERRIDE_DISABLED)) && 
  OverrideMsgTimer THEN InfoMsg_W = 0, RST OverrideMsgTimer, RST ShowInfoStage
  
;FeedRapid Link Button
IF SkinFeedRapidLink_M || SV_PC_TOGGLE_RAPID_FEED_LINK || ExtUsb_RapidFeedLink_SV
  THEN (FeedRapid_PD), RST SV_PC_TOGGLE_RAPID_FEED_LINK
IF FeedRapid_PD && UsingFeedrateKnob_M THEN RST UsingFeedrateKnob_M
IF (FeedRapid_PD ^ SelectRapidLink) || (UsingLinkedFeature_M && OnAtPowerUp_M)
  THEN (SelectRapidLink)
  
IF SelectRapidLink THEN (FeedRapidLinkLED), (ExtUsb_RapidFeedLinkOut_SV)

;Rapid Rate Override % Buttons
IF SkinRapidOver100_M || ExtUsb_RapidOver100_SV THEN RapidRateOverride_W = 100, RST UsingFeedrateKnob_M
IF SkinRapidOver75_M || ExtUsb_RapidOver75_SV THEN RapidRateOverride_W = 75, RST UsingFeedrateKnob_M
IF SkinRapidOver50_M || ExtUsb_RapidOver50_SV THEN RapidRateOverride_W = 50, RST UsingFeedrateKnob_M
IF SkinRapidOver25_M || ExtUsb_RapidOver25_SV THEN RapidRateOverride_W = 25, RST UsingFeedrateKnob_M

;"Custom" % to set Rapid Rate determined by P456
IF ExtUsb_RapidOverCustom_SV THEN RapidRateOverride_W = SV_MACHINE_PARAMETER_456, RST UsingFeedrateKnob_M

;Set Rapid Override Initial Value
IF OnAtPowerUp_M THEN RapidRateOverride_W = 100

;VCP Plus/Minus Buttons
IF True_M THEN SkinRapidOverTimer_T = 200
IF SkinRapidOverMinus_M THEN (SkinRapidOverMinusPD), SET SkinRapidOverTimer_T
IF SkinRapidOverPlus_M THEN (SkinRapidOverPlusPD), SET SkinRapidOverTimer_T
IF !SkinRapidOverPlus_M && !SkinRapidOverMinus_M THEN RST SkinRapidOverTimer_T

IF !WaitingForSleepTimer_M && ((SkinRapidOverPlusPD) || (SkinRapidOverTimer_T && SkinRapidOverPlus_M))
  THEN RapidRateOverride_W = RapidRateOverride_W + 1,
       RST UsingFeedrateKnob_M,
       SET WaitingForSleepTimer_M,
       SleepTimer = 30, SET SleepTimer

IF !WaitingForSleepTimer_M && ((SkinRapidOverMinusPD) || (SkinRapidOverTimer_T && SkinRapidOverMinus_M))
  THEN RapidRateOverride_W = RapidRateOverride_W - 1,
		RST UsingFeedrateKnob_M,
		SET WaitingForSleepTimer_M,
		SleepTimer = 30, SET SleepTimer

IF SleepTimer THEN RST WaitingForSleepTimer_M, RST SleepTimer

;WMPG Rapid Rate Logic
; Reset UsingFeedrateKnob to allow changes to Rapid Rate by WMPG.
IF MpgFeedWheelSelect_M && MpgSetAxisZero_M && (UsbWheelDelta_W != 0) THEN RST UsingFeedrateKnob_M
  
;Ext Usb Rapid Rate Override Logic
;Divide Knob by 4 as every "tick" is 4 counts.
;Initialize LastKnob Value to Current on Startup. Prevents a "jump" in value
; from occurring on startup if the knob value reported by External panel is not 0.
IF !Initialize_T THEN ExtUsbLastRapidKnob_W = ExtUsbRapidKnob_W / 4
IF Initialize_T THEN ExtUsbRapidDelta_W = (((ExtUsbRapidKnob_W / 4) - ExtUsbLastRapidKnob_W) * SV_MACHINE_PARAMETER_452)
IF Initialize_T && (ExtUsbRapidDelta_W != 0) THEN RST UsingFeedrateKnob_M
IF Initialize_T THEN ExtUsbLastRapidKnob_W = ExtUsbRapidKnob_W / 4

;Check if Panel is Online, if not then we set Delta to 0, this prevents
; "jumps" to RapidRate value in the case panel is disconnected/reconnected.
IF SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbRapidDelta_W = 0

;Check if Software is Ready and if Panel is Online.
; If Software is not ready, then assume panel is still connected but
; 	software was restarted. In this case, we set Delta to 0 until software
;   comes back online.
; If Software is ready and panel is not online, then assume board was unplugged
;	and lost power, we need to set delta to 0 and also set Last Rapid Knob to 0.
IF SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbRapidDelta_W = 0
IF !SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbRapidDelta_W = 0,
                                                     ExtUsbLastRapidKnob_W = 0

;Add the delta to RapidRateOverride_W
IF SelectRapidOverride && Initialize_T
  THEN RapidRateOverride_W = (RapidRateOverride_W + ExtUsbRapidDelta_W)

;MPG add delta to RapidRateOverride_W
IF MpgFeedWheelSelect_M && MpgSetAxisZero_M
  THEN RapidRateOverride_W = (RapidRateOverride_W + UsbWheelDelta_W)

;When UsingPhysical Knob, Set RapidRateOverride_W to FinalFeedOverride_W
IF UsingFeedrateKnob_M THEN RapidRateOverride_W = FeedrateKnob_W

;Bound RapidRateOverride_W between 1-100%
IF RapidRateOverride_W > 100 THEN RapidRateOverride_W = 100
IF RapidRateOverride_W < 1 THEN RapidRateOverride_W = 1
  
;When Rapid Override is Not Selected, PC side controls Rate, PLC word has no effect.
; We set it to 100% in this case for graphical clarification.
IF True_M THEN FinalRapidRateOverride_W = RapidRateOverride_W
IF !SelectRapidOverride THEN FinalRapidRateOverride_W = 100

;Send Percentage to CNC12
; Send Final Rapid Rate Override % to CNC12
; If FeedRapidLink or UsingFeedrateKnob_M (Pot Style Knob found on Physical
;  Centroid Control Panels) then set SV_PLC_RAPID_FEEDRATE_OVERRIDE to 0 for
;  "Old" Functionality.
; In this case, we set FinalRapidRateOverride_W to FinalFeedOverride_W for
;  graphical purposes.
IF RapidRateOverrideEnabled_M THEN SV_PLC_RAPID_FEEDRATE_OVERRIDE = FinalRapidRateOverride_W * 0.01
IF FeedRapidLinkLED || UsingFeedrateKnob_M || !RapidRateOverrideEnabled_M
  THEN SV_PLC_RAPID_FEEDRATE_OVERRIDE = 0

;We need to link Feed and Rapid depending on what currently is being adjusted.
;Adjust both based on Feed Rate
IF RapidRateOverrideEnabled_M && FeedRapidLinkLED && Initialize_T &&
  (FinalFeedOverride_W != LastFinalFeedOverride_W)
  THEN FinalRapidRateOverride_W = FinalFeedOverride_W,
       RapidRateOverride_W = FinalFeedOverride_W
IF True_M THEN LastFinalFeedOverride_W = FinalFeedOverride_W

;Adjust both based on Rapid Rate
IF RapidRateOverrideEnabled_M && FeedRapidLinkLED && Initialize_T &&
  (FinalRapidRateOverride_W != LastFinalRapidOverride_W)
  THEN FinalFeedOverride_W = FinalRapidRateOverride_W,
       KbOverride_W = FinalRapidRateOverride_W
IF True_M THEN LastFinalRapidOverride_W = FinalRapidRateOverride_W

;Activate LED's
IF FinalRapidRateOverride_W == 100 THEN (RapidOver100LED), (ExtUsb_RapidOver100Out_SV)
IF FinalRapidRateOverride_W == 75 THEN (RapidOver75LED), (ExtUsb_RapidOver75Out_SV)
IF FinalRapidRateOverride_W == 50 THEN (RapidOver50LED), (ExtUsb_RapidOver50Out_SV)
IF FinalRapidRateOverride_W == 25 THEN (RapidOver25LED), (ExtUsb_RapidOver25Out_SV)
IF FinalRapidRateOverride_W == SV_MACHINE_PARAMETER_456 THEN (ExtUsb_RapidOverCustomOut_SV)

;--MPU11 Jog Panel Key Functions
IF (CycleCancelKey_I || KbCycleCancel_M || SkinCycleCancel_SV || MpgResetKey_M || CycleCancel2 ||
  SkinRestartCycleCancel_M || ExtUsb_CycleCancel_SV)
  || ErrorFlag_M THEN (DoCycleCancel)
IF !SV_PROGRAM_RUNNING THEN (ExtUsb_CycleCancelOut_SV)
IF SV_STOP THEN RST SkinRestartCycleStart_M
IF SkinRestartCycleStart_M THEN (RestartCycleStart_PD)
IF ((CycleStartKey_I || KbCycleStart_M || SkinCycleStart_SV || MpgCycleStart_M || CycleStart2 || ExtUsb_CycleStart_SV)
   && !DoorFeedHold_M && !TorchRestartModeLED_O) || RestartCycleStart_PD THEN (DoCycleStart)
IF SV_PROGRAM_RUNNING THEN (ExtUsb_CycleStartOut_SV)

IF True_M THEN RST JogKeysNormalStage,
             RST JogKeysInvert2Stage,
             RST JogKeysSwappedStage,
             RST JogKeysSwapAndInvert2Stage,
             RST JogKeysNormalXInvertStage,
             RST JogKeysInvert2XInvertStage,
             RST JogKeysSwappedXInvertStage,
             RST JogKeysSwapandInvert2XInvertStage

IF True_M THEN JogKeyCfg_W = SV_MACHINE_PARAMETER_1
IF True_M THEN BITTST JogKeyCfg_W 1 InvertYJogKeys_M
IF True_M THEN BITTST JogKeyCfg_W 2 SwapAxes_M
IF True_M THEN BITTST JogKeyCfg_W 4 InvertXJogKeys_M

IF !(InvertYJogKeys_M || SwapAxes_M || InvertXJogKeys_M) THEN SET JogKeysNormalStage
IF InvertYJogKeys_M && !SwapAxes_M && !InvertXJogKeys_M THEN SET JogKeysInvert2Stage
IF !InvertYJogKeys_M && SwapAxes_M && !InvertXJogKeys_M THEN SET JogKeysSwappedStage
IF InvertYJogKeys_M && SwapAxes_M && !InvertXJogKeys_M THEN SET JogKeysSwapAndInvert2Stage

IF !InvertYJogKeys_M && !SwapAxes_M && InvertXJogKeys_M THEN SET JogKeysNormalXInvertStage
IF  InvertYJogKeys_M && !SwapAxes_M && InvertXJogKeys_M THEN SET JogKeysInvert2XInvertStage
IF !InvertYJogKeys_M &&  SwapAxes_M && InvertXJogKeys_M THEN SET JogKeysSwappedXInvertStage
IF  InvertYJogKeys_M &&  SwapAxes_M && InvertXJogKeys_M THEN SET JogKeysSwapandInvert2XInvertStage

; First and second axis jogging is in configuration-specific
; stages following JogPanelStage

IF (Ax3PlusJogKey_I  || KbJogAx3Plus_M || SkinJogAx3Plus_SV || UsbMpgAxis3JogPlus_M || ExtUsb_Ax3PlusJog_SV ||
  (ShuttleAxisJogPlusKey && ShuttleAxis3Selected)) && !AllJogDisabled_M &&
   !(IncrContLED && FinalFeedOverride_W == 0) THEN (DoAx3PlusJog_SV), (ExtUsb_Ax3PlusJogOut_SV)
IF (Ax3MinusJogKey_I || KbJogAx3Minus_M || SkinJogAx3Minus_SV || UsbMpgAxis3JogMinus_M || ExtUsb_Ax3MinusJog_SV ||
  (ShuttleAxisJogMinusKey && ShuttleAxis3Selected)) && !Ax3MinusJogDisabled_M && !AllJogDisabled_M &&
   !(IncrContLED && FinalFeedOverride_W == 0) THEN (DoAx3MinusJog_SV), (ExtUsb_Ax3MinusJogOut_SV)
IF (Ax4PlusJogKey_I  || KbJogAx4Plus_M || SkinJogAx4Plus_SV || UsbMpgAxis4JogPlus_M || ExtUsb_Ax4PlusJog_SV ||
  (ShuttleAxisJogPlusKey && ShuttleAxis4Selected)) && !AllJogDisabled_M &&
   !(IncrContLED && FinalFeedOverride_W == 0) THEN (DoAx4PlusJog_SV), (ExtUsb_Ax4PlusJogOut_SV)
IF (Ax4MinusJogKey_I || KbJogAx4Minus_M || SkinJogAx4Minus_SV || UsbMpgAxis4JogMinus_M || ExtUsb_Ax4MinusJog_SV ||
  (ShuttleAxisJogMinusKey && ShuttleAxis4Selected)) && !AllJogDisabled_M &&
   !(IncrContLED && FinalFeedOverride_W == 0) THEN (DoAx4MinusJog_SV), (ExtUsb_Ax4MinusJogOut_SV)
   
IF (SkinJogAx5Plus_SV || UsbMpgAxis5JogPlus_M || ExtUsb_Ax5PlusJog_SV) && !(IncrContLED && FinalFeedOverride_W == 0) &&
   !AllJogDisabled_M THEN (DoAx5PlusJog_SV), (ExtUsb_Ax5PlusJogOut_SV)
IF (SkinJogAx5Minus_SV || UsbMpgAxis5JogMinus_M || ExtUsb_Ax5MinusJog_SV) && !(IncrContLED && FinalFeedOverride_W == 0) &&
   !AllJogDisabled_M THEN (DoAx5MinusJog_SV), (ExtUsb_Ax5MinusJogOut_SV)
IF (SkinJogAx6Plus_SV || UsbMpgAxis6JogPlus_M || ExtUsb_Ax6PlusJog_SV) && !(IncrContLED && FinalFeedOverride_W == 0) &&
   !AllJogDisabled_M THEN (DoAx6PlusJog_SV), (ExtUsb_Ax6PlusJogOut_SV)
IF (SkinJogAx6Minus_SV || UsbMpgAxis6JogMinus_M || ExtUsb_Ax6MinusJog_SV) && !(IncrContLED && FinalFeedOverride_W == 0) &&
   !AllJogDisabled_M THEN (DoAx6MinusJog_SV), (ExtUsb_Ax6MinusJogOut_SV)

IF (Aux1Key  || KbAux1Key_M || SkinAux1_M || ExtUsb_Aux1_SV) THEN (DoAux1Key), (ExtUsb_Aux1Out_SV)
IF (Aux2Key  || KbAux2Key_M || SkinAux2_M || ExtUsb_Aux2_SV) THEN (DoAux2Key), (ExtUsb_Aux2Out_SV)
IF (Aux3Key  || KbAux3Key_M || SkinAux3_M || ExtUsb_Aux3_SV) THEN (DoAux3Key), (ExtUsb_Aux3Out_SV)
IF (Aux4Key  || KbAux4Key_M || SkinAux4_M || ExtUsb_Aux4_SV) THEN (DoAux4Key), (ExtUsb_Aux4Out_SV)
IF (Aux5Key  || KbAux5Key_M || SkinAux5_M || ExtUsb_Aux5_SV) ||
	(SkinSpindleMed_M && !BackGearDisabled_M) THEN (DoAux5Key), (ExtUsb_Aux5Out_SV)
IF (Aux6Key  || KbAux6Key_M || SkinAux6_M || ExtUsb_Aux6_SV) THEN (DoAux6Key), (ExtUsb_Aux6Out_SV)
IF (Aux7Key  || KbAux7Key_M || SkinAux7_M || ExtUsb_Aux7_SV) THEN (DoAux7Key), (ExtUsb_Aux7Out_SV)
IF (Aux8Key  || KbAux8Key_M  || SkinAux8_M || ExtUsb_Aux8_SV)  THEN (DoAux8Key), (ExtUsb_Aux8Out_SV)
IF (Aux9Key  || KbAux9Key_M  || SkinAux9_M || ExtUsb_Aux9_SV)  THEN (DoAux9Key), (ExtUsb_Aux9Out_SV)
IF (Aux10Key || KbAux10Key_M || SkinAux10_M || ExtUsb_Aux10_SV) THEN (DoAux10Key), (ExtUsb_Aux10Out_SV)
IF (Aux11Key || KbAux11Key_M || SkinAux11_M || ExtUsb_Aux11_SV) THEN (DoAux11Key), (ExtUsb_Aux11Out_SV)
IF (Aux12Key || KbAux12Key_M || SkinAux12_M || ExtUsb_Aux12_SV) THEN (DoAux12Key), (ExtUsb_Aux12Out_SV)
IF (Aux13Key || KbAux13Key_M || SkinAux13_M || ExtUsb_Aux13_SV) THEN (DoAux13Key), (ExtUsb_Aux13Out_SV)
IF (Aux14Key || KbAux14Key_M || SkinAux14_M || ExtUsb_Aux14_SV) THEN (DoAux14Key), (ExtUsb_Aux14Out_SV)
IF (Aux15Key || KbAux15Key_M || SkinAux15_M || ExtUsb_Aux15_SV) THEN (DoAux15Key), (ExtUsb_Aux15Out_SV)
IF (Aux16Key || KbAux16Key_M || SkinAux16_M || ExtUsb_Aux16_SV) THEN (DoAux16Key), (ExtUsb_Aux16Out_SV)

IF x1JogLED_O    THEN (SelectX1JogInc)
IF x10JogLED_O   THEN (SelectX10JogInc)
IF x100JogLED_O  THEN (SelectX100JogInc)
IF IncrContLED   THEN (SelectIncContJog)
IF FastSlowLED_O THEN (SelectFastSlowJog)
IF MPGLED        THEN (SelectMpgMode)
IF FeedHoldLED && SV_PC_OVERRIDE_CONTROL_FEEDHOLD THEN (DoFeedHold)

;--Coolant Functions

;--Toggle auto coolant mode
IF CoolAutoManKey || KbTogCoolAutoMan_M || SkinCoolAutoMan_M || ExtUsb_CoolAutoMan_SV THEN (CoolantAutoManualPD)

IF (!CoolAutoModeLED && CoolantAutoManualPD) || OnAtPowerUp_M
  THEN SET CoolAutoModeLED

IF (CoolAutoModeLED && CoolantAutoManualPD)
  THEN RST CoolAutoModeLED

;--Report coolant mode to CNC12
IF CoolAutoModeLED THEN (SelectCoolAutoMan), (ExtUsb_CoolantAutoManualOut_SV)

;--Display coolant mode message
;changing to auto coolant mode ;2050 Auto Coolant Selected 2 + 50*256
IF (!CoolAutoModeLED && CoolantAutoManualPD && AllowKbInput_M)
  THEN InfoMsg_W = AUTO_COOL_MSG

;changing to manual coolant mode ;2051 Manual Coolant Selected 2 + 51*256
IF (CoolAutoModeLED && CoolantAutoManualPD && AllowKbInput_M)
  THEN InfoMsg_W = MAN_COOL_MSG

;--Flood coolant on/off
; In auto mode:
;  Turn on if M8
;  Turn off if fault, toolcheck, or not M8
; In manual mode:
;  Turn off if entering manual mode
;  Toggle by key press
IF CoolFloodKey || KbFloodOnOff_M || SkinCoolFlood_M || ExtUsb_Flood_SV || ExtUsb_RouterDustCollection_SV
  THEN (CoolantFloodPD)
IF (((Flood || RouterDustCollection) ^ (!CoolAutoModeLED && CoolantFloodPD)) ||
   (CoolAutoModeLED && M8)) &&
   !(SV_STOP || CoolantAutoManualPD || (CoolAutoModeLED && !M8) || ErrorFlag_M || DoToolCheck)
   THEN (Flood), (CoolFloodLED), (SelectCoolantFlood), (RouterDustCollection)

IF CoolFloodLED THEN (ExtUsb_FloodOut_SV), (ExtUsb_RouterDustCollectionOut_SV)

;--Mist coolant on/off
IF CoolMistKey || KbMistOnOff_M || SkinCoolMist_M || ExtUsb_Mist_SV || ExtUsb_RouterVacuumHoldDown_SV
  THEN (CoolantMistPD)
IF (((Mist || RouterVacuumHoldDown) ^ (!CoolAutoModeLED && CoolantMistPD))
   || CoolAutoModeLED && M7)
   && !(SV_STOP || (CoolantAutoManualPD && !RouterVacuumHoldDown) ||
   CoolAutoModeLED && !M7 || ErrorFlag_M || DoToolCheck)
  THEN (Mist), (CoolMistLED), (SelectCoolantMist), (RouterVacuumHoldDown)

IF CoolMistLED THEN (ExtUsb_MistOut_SV), (ExtUsb_RouterVacuumHoldDownOut_SV)

;==============================================================================
                                 SpindleStage
;==============================================================================
;--Spindle Control
;------------------------------------------------------------------------------
; JOGBOARD SPINDLE CONTROL
; Spindle Auto Mode / Manual mode toggles via Auto/Man jog panel key
; CW/CCW jog keys determine spindle direction in manual mode
; M3/M4 system variables determine spindle direction in Auto mode
; Spindle can be stopped and restarted in auto mode using
; spin stop/start jog keys
;------------------------------------------------------------------------------
;--Select Auto or Manual Spindle Operation Mode
;Triggers to Toggle Auto/Manual Spindle Mode
IF SpinAutoManKey || KbTogSpinAutoMan_M || SkinSpinAutoMan_M || (MpgSpinAutoMan_M && !PlasmaWMPG_M) ||
    ExtUsb_SpinAutoMan_SV THEN (SpinAutoManPD)

;--Set spindle to auto mode on startup
IF (SpinAutoManPD && !SpinAutoModeLED) || OnAtPowerUp_M
  THEN SET SpinAutoModeLED

;--Set spindle to manual mode
IF SpinAutoManPD && SpinAutoModeLED THEN RST SpinAutoModeLED

;--Report the Spindle mode to CNC12
IF SpinAutoModeLED THEN (SelectManAutoSpindle), (ExtUsb_SpinAutoManOut_SV)

;--Set triggers to start and stop the spindle
;Handle for Single Button Toggle of Spindle by WMPG and/or External USB Devices.
IF MpgSpinOnOff_M || ExtUsb_SpinOnOff_SV THEN (SpindleToggle_PD)

IF !(MpgSpinOnOff_M || ExtUsb_SpinOnOff_SV) THEN RST SpinToggleOn_M, RST SpinToggleOff_M
IF SpindleToggle_PD && !SpindleEnableOut_M THEN SET SpinToggleOn_M, RST SpinToggleOff_M
IF SpindleToggle_PD &&  SpindleEnableOut_M THEN RST SpinToggleOn_M, SET SpinToggleOff_M

; NOTE: SpindlePause_M allows the operator to start and stop the
; spindle with the spin start and stop keys while in a job.  In
; this case, pressing the spindle start key will only restart
; the spindle if an M3 or M4 had previously been issued and is
; still active.

IF (SpinAutoModeLED && (M3_SV || M4_SV) && (SpinStopKey || KbSpinStop_M || SkinSpinStop_M || SpinToggleOff_M ||
  ExtUsb_SpinStop_SV)) THEN SET SpindlePause_M
IF ((M3_SV || M4_SV) && (SpinStartKey || KbSpinStart_M || SkinSpinStart_M || SpinToggleOn_M || ExtUsb_SpinStart_SV) ||
    !(SV_PROGRAM_RUNNING || SV_MDI_MODE))
  THEN RST SpindlePause_M

IF ((SpinStartKey || KbSpinStart_M || SkinSpinStart_M || SpinToggleOn_M || ExtUsb_SpinStart_SV) && !SpinAutoModeLED) ||
  (SpinAutoModeLED && (M3_SV || M4_SV) && !SpindlePause_M && !FeedHoldLED) ||
  ((SpinStartKey || KbSpinStart_M || SkinSpinStart_M || SpinToggleOn_M || ExtUsb_SpinStart_SV) && ((M3_SV || M4_SV) &&
  SpinAutoModeLED))
  THEN (SpinStart_M)

IF ((ProbeDetect && !ProbeDetectDisabled_M || SV_FORCE_PROBE_DETECTION_ON) &&
  ((SV_MACHINE_PARAMETER_416 == 1) || SV_MACHINE_PARAMETER_416 == 3)) ||
	(ToolTouchOffDetect && !TTDetectDisabled_M && ((SV_MACHINE_PARAMETER_416 == 1) || SV_MACHINE_PARAMETER_416 == 2))
	THEN (ProbeSpindleInhibit_M)

IF (SpinStopKey || KbSpinStop_M || SkinSpinStop_M || SpinToggleOff_M || ExtUsb_SpinStop_SV) ||
	(SpinAutoModeLED && !(M3_SV || M4_SV)) ||
	(SV_PC_RIGID_TAP_SPINDLE_OFF && SpinAutoModeLED) ||
	ProbeSpindleInhibit_M || SV_STOP || ErrorFlag_M || SV_LIMIT_TRIPPED ||
	!ChuckOpenCloseComplete_M || M51_SV || UnclampTool
   THEN (SpinStop_M)

;--Adjust spindle override when entering manual or auto spin mode
;Set the override value to 100% when spin auto mode is first selected
IF SpinAutoManPD && !SpinAutoModeLED
  THEN SV_PLC_SPINDLE_KNOB = 100,
       SET SpinAutoModeLED

;Set the override value to 10% whenever manual mode is entered
IF SpinAutoManPD && SpinAutoModeLED
  THEN SV_PLC_SPINDLE_KNOB = 10, RST SpinAutoModeLED

;--Set spindle direction
;------------------Set Clockwise direction
IF ((KbSpinCW_M || SpinCWKey || SkinSpinCW_M || ExtUsb_SpinCW_SV) && !SpinAutoModeLED) || (M3_SV && SpinAutoModeLED)
  THEN RST SpindleDirection_M
IF !SpindleDirection_M THEN (SpindleCWLED), (SelectSpindleCW)
IF SpindleCWLED THEN (ExtUsb_SpinCWOut_SV)

;---------------Set Counterclockwise direction
IF ((KbSpinCCW_M || SpinCCWKey || SkinSpinCCW_M || ExtUsb_SpinCCW_SV) && !SpinAutoModeLED) || (M4_SV && SpinAutoModeLED)
  THEN SET SpindleDirection_M
IF SpindleDirection_M THEN (SpindleCCWLED), (SelectSpindleCCW)
IF (SpindleCCWLED) THEN (ExtUsb_SpinCCWOut_SV)

;IF (SpindleDirection_M ^ SpinRangeReversed_M) && !SpindleForwardOut THEN (SpindleDirectionOut)
IF SpindleDirection_M ^ SpinRangeReversed_M THEN (SpindleDirectionOut_M)

;-------------------------------------------------------------------------------
;                                Turn spindle on/off
;-------------------------------------------------------------------------------
IF ProbeSpindleInhibit_M && SpinStart_M THEN SET ProbeFault_M

;-----DOOR INTERLOCK-----------------------------------------------------------
;Prevent Spin if Door Open
IF (SpindleEnableOut_M || SpinStart_M) && ((DoorInterlockMode_M || DoorInterlockShutdown_M)  && !SafetyDoorSwitchClosed_I)
     THEN ErrorMsg_W = DOOR_NOT_CLOSED, RST SpindleEnableOut_M
;-----DOOR INTERLOCK-----------------------------------------------------------

;------------------------------------------------------------------------------
;          SPINDLE OVERRIDE CONTROL
;       Jogboard (-, +, and 100% keys),
; Keyboard "ctrl" + "<", "ctrl" + ">", "ctrl" + "/"
;------------------------------------------------------------------------------
IF SpinOverPlusKey || KbIncSpinOver_M || SkinSpinOverPlus_M || ExtUsb_SpinOverPlus_SV
  THEN SV_PLC_SPINDLE_KNOB = SV_PLC_SPINDLE_KNOB + 1
IF SpinOverMinusKey || KbDecSpinOver_M || SkinSpinOverMinus_M || ExtUsb_SpinOverMinus_SV
  THEN SV_PLC_SPINDLE_KNOB = SV_PLC_SPINDLE_KNOB - 1
IF SpinOver100Key || KbSpinOver100_M || OnAtPowerUp_M || SkinSpin100_M || ExtUsb_SpinOver100_SV
  THEN SV_PLC_SPINDLE_KNOB = 100

;Custom %
IF ExtUsb_SpinOverCustom_SV THEN SV_PLC_SPINDLE_KNOB = SV_MACHINE_PARAMETER_455

;MPG Spindle Logic
IF !MpgSpinWheelSelect_M THEN RST MpgSpinWheelSet_M
IF (MpgSpinWheelSelect_M && !MpgSpinWheelSet_M) THEN SET MpgSpinWheelSet_M
IF MpgSpinWheelSet_M THEN SV_PLC_SPINDLE_KNOB = (SV_PLC_SPINDLE_KNOB + UsbWheelDelta_W)

;Ext Usb Spindle Override Logic
;Divide Knob by 4 as every "tick" is 4 counts.
;Initialize LastKnob Value to Current on Startup. Prevents a "jump" in value
; from occurring on startup if the knob value reported by External panel is not 0.
IF !Initialize_T THEN ExtUsbLastSpinKnob_W = ExtUsbSpinKnob_W / 4
IF Initialize_T THEN ExtUsbSpinDelta_W = (((ExtUsbSpinKnob_W / 4) - ExtUsbLastSpinKnob_W) * SV_MACHINE_PARAMETER_451)
IF Initialize_T THEN ExtUsbLastSpinKnob_W = ExtUsbSpinKnob_W / 4

;Check if Panel is Online, if not then we set Delta to 0, this prevents
; "jumps" to Feedrate value in the case panel is disconnected/reconnected.
IF SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbSpinDelta_W = 0

;Check if Software is Ready and if Panel is Online.
; If Software is not ready, then assume panel is still connected but
; 	software was restarted. In this case, we set Delta to 0 until software
;   comes back online.
; If Software is ready and panel is not online, then assume board was unplugged
;	and lost power, we need to set delta to 0 and also set Last Spin Knob to 0.
IF SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbSpinDelta_W = 0
IF !SoftwareNotReady_M && !ExtUsbPanel1Online_M THEN ExtUsbSpinDelta_W = 0,
                                                     ExtUsbLastSpinKnob_W = 0

IF True_M THEN SV_PLC_SPINDLE_KNOB = (SV_PLC_SPINDLE_KNOB + ExtUsbSpinDelta_W)

IF SV_PLC_SPINDLE_KNOB < 1  THEN SV_PLC_SPINDLE_KNOB = 1
IF SV_PLC_SPINDLE_KNOB > 200 THEN SV_PLC_SPINDLE_KNOB = 200

IF SV_PLC_SPINDLE_KNOB == 100 THEN
  (SpinOver100LED),
  (SelectSpinOr100),
  (ExtUsb_SpinOver100Out_SV)

IF SV_PLC_SPINDLE_KNOB < 100 THEN
  (SpinOverMinusLED),
  (DoDecreaseSpindleOr),
  (ExtUsb_SpinOverMinusOut_SV)

IF SV_PLC_SPINDLE_KNOB > 100 THEN
  (SpinOverPlusLED),
  (DoIncreaseSpindleOr),
  (ExtUsb_SpinOverPlusOut_SV)
  
IF SV_PLC_SPINDLE_KNOB == SV_MACHINE_PARAMETER_455 THEN (ExtUsb_SpinOverCustomOut_SV)

;--Output 12-bit DAC value for spindle control
;-----------------------------------------------------------------------------
;             Read spindle range inputs and/or range M codes
;
; NOTE: SV_SPINDLE_LOW_RANGE & SV_SPINDLE_MID_RANGE M are used to report the
; selected spindle range to CNC12
;-----------------------------------------------------------------------------
;   4 hi   3 med-high  2 med-low  1 low
;    0          1         1         0   SV_SPINDLE_MID_RANGE M
;    0          0         1         1   SV_SPINDLE_LOW_RANGE

; Use input switches, M functions, or other means to determine the gear
; range number (1-4).  For basic mills, look for one low-range switch.
; Default to high range until proven otherwise (fail-safe choice)
IF Aux4Key THEN (Aux4PD)
IF Aux5Key THEN (Aux5PD)
IF Aux6Key THEN (Aux6PD)

; Restore the use of Aux 5 key when BackGear mode is enabled.
;IF (SkinSpindleMed_M && BackGearDisabled_M) THEN (DoAux5Key)

IF M41_SV || SkinSpindleLow_M || ExtUsb_SpindleLow_SV || (SpindleLowRange || (!BackGear && !BackGearDisabled_M))
  THEN SpindleRange_W = 1, SET SpindleLowLED, RST SpindleMedLED, RST SpindleHighLED, RST M42_SV, RST M43_SV
IF SpindleLowLED THEN (ExtUsb_SpindleLowOut_SV)

IF ((M42_SV || SkinSpindleMed_M || ExtUsb_SpindleMed_SV || SpindleMedRange) && BackGearDisabled_M)
  THEN SpindleRange_W = 2, RST SpindleLowLED, SET SpindleMedLED, RST SpindleHighLED, RST M41_SV, RST M43_SV
IF SpindleMedLED THEN (ExtUsb_SpindleMedOut_SV)

IF OnAtPowerUp_M || M43_SV || SkinSpindleHigh_M || ExtUsb_SpindleHigh_SV || (SpindleHighRange ||
  (BackGear && !BackGearDisabled_M))
  THEN SpindleRange_W = 3, RST SpindleLowLED, RST SpindleMedLED, SET SpindleHighLED, RST M41_SV, RST M42_SV
IF SpindleHighLED THEN (ExtUsb_SpindleHighOut_SV)

IF OnAtPowerUp_M || (SpindleRange_W == 0) THEN SpindleRange_W = 4, SET SpindleHighLED

; Use the gear range number to set the range flags and speed ratio.
IF SpindleRange_W == 1 THEN SET SV_SPINDLE_LOW_RANGE,
                            RST SV_SPINDLE_MID_RANGE,
                            SpinRangeAdjust_FW = SV_MACHINE_PARAMETER_65

IF SpindleRange_W == 2 THEN SET SV_SPINDLE_LOW_RANGE,
                            SET SV_SPINDLE_MID_RANGE,
                            SpinRangeAdjust_FW = SV_MACHINE_PARAMETER_66

IF SpindleRange_W == 3 THEN RST SV_SPINDLE_LOW_RANGE,
                            SET SV_SPINDLE_MID_RANGE,
                            SpinRangeAdjust_FW = 1.0

IF SpindleRange_W == 4 THEN RST SV_SPINDLE_LOW_RANGE,
                            RST SV_SPINDLE_MID_RANGE,
                            SpinRangeAdjust_FW = 1.0

; If the speed ratio parameter is negative, reverse the motor.
; Always use the absolute value of the parameter as the real ratio.
IF SpinRangeAdjust_FW < 0.0 THEN (SpinRangeReversed_M),
                                 SpinRangeAdjust_FW = -SpinRangeAdjust_FW

; Force the ratio to be non-zero, because we are going to divide by it later.
IF SpinRangeAdjust_FW < 0.001 THEN SpinRangeAdjust_FW = 0.001

;------------------------------------------------------------------------------
;              Read commanded spindle speed, max & min
;
; ***NOTE***  SV_PC_COMMANDED_SPINDLE_SPEED already has override
;             factored in.
;------------------------------------------------------------------------------
IF True_M THEN CfgMinSpeed_FW = SV_PC_CONFIG_MIN_SPINDLE_SPEED,
             CfgMaxSpeed_FW = SV_PC_CONFIG_MAX_SPINDLE_SPEED

; Calculate #RPM's per bit of resolution
IF CfgMaxSpeed_FW > 0.0 THEN RPMPerBit_FW = CfgMaxSpeed_FW/65535.0
IF CfgMaxSpeed_FW <= 0.0 THEN RPMPerBit_FW = 1.0

; In auto mode, assuming M3 or M4 present, use given RPM from CNC11/CNC12
IF SpinAutoModeLED THEN SpinSpeedCommand_FW = SV_PC_COMMANDED_SPINDLE_SPEED
IF SpinSpeedCommand_FW > 1 THEN SET MEM999
IF SpinSpeedCommand_FW < 1 THEN RST MEM999

; In manual mode, assuming spindle is on, use speed scaled from CCFG max
IF !SpinAutoModeLED THEN SpinSpeedCommand_FW = CfgMaxSpeed_FW *
                                               SV_PLC_SPINDLE_KNOB / 200.0 *
                                               SpinRangeAdjust_FW
                                               
;Spindle Speed Variation
;This helps reduce vibration due to resonance. We reduce resonance by
; varying the speed a certain amount above and below requested spindle speed.
IF ExtUsb_SpindleSpeedVariationMode_SV THEN (SpindleSpeedVariationMode_PD)
IF SpindleSpeedVariationMode_PD ^ SpindleSpeedVariation_SV THEN (SpindleSpeedVariation_SV)

;Set Timer when SSV is enabled
IF SpindleSpeedVariation_SV THEN SET SpindleSpeedVariation_T
IF !SpindleSpeedVariation_SV THEN RST SpindleSpeedVariation_T

;Adjust SpinSpeedCommand_FW over period of time.
;We take the modulo of the SpindleSpeedVariation_T timer using P982 and "normalize" it so its a value from 0 to 2.
; this value is then used in a sin function and multiplied with P983 the adjustment amount, which is then added to
; SpinSpeedCommand_FW to get the current spindle speed in this plc scan.
IF SpindleSpeedVariation_SV THEN SpindleSpeedVariationCycle_FW = (SpindleSpeedVariation_T % SpindleSpeedVariationCycle_W) / (SpindleSpeedVariationCycle_W / 2.0)
IF SpindleSpeedVariation_SV THEN SpinSpeedCommand_FW = SpinSpeedCommand_FW + (SV_MACHINE_PARAMETER_983 * SIN (3.14 * SpindleSpeedVariationCycle_FW))

;SSV Status LED
IF SpindleSpeedVariation_SV THEN (ExtUsb_SpindleSpeedVariationModeOut_SV)
                                               
IF DoSpindleStop THEN SpinSpeedCommand_FW = 0.0

;------------------------------------------------------------------------------
; If commanded spindle speed is < Min Spin Speed * SpinRangeAdjust
; & commanded spindle speed > 0, force to commanded spindle speed
; = min spin speed value * SpinRangeAdjust.
;------------------------------------------------------------------------------
IF (SpinSpeedCommand_FW > 0.0) &&
   (SpinSpeedCommand_FW < (CfgMinSpeed_FW * SpinRangeAdjust_FW))
  THEN SpinSpeedCommand_FW = (CfgMinSpeed_FW * SpinRangeAdjust_FW),
       InfoMsg_W = MIN_SPEED_MSG

;------------------------------------------------------------------------------
; If SpinSpeedCommand_FW > Max Spin Speed * SpinRangeAdjust, force
; SpinSpeedCommand_FW = max spin speed value * SpinRangeAdjust.
;------------------------------------------------------------------------------
IF SpinSpeedCommand_FW > (CfgMaxSpeed_FW * SpinRangeAdjust_FW)
  THEN SpinSpeedCommand_FW = (CfgMaxSpeed_FW * SpinRangeAdjust_FW)
  
  ; The following bits control the actual analog hardware output on the ACORN_6
; Output = 16bit (0-65535) Default 0-10VDC.
; Different analog ranges are available by setting mode bits:
; -------------------------------------------
; | Mode bit A | Mode bit B | Range         |
; |     0      |     0      | 0 to +10VDC   |
; |     1      |     0      | 0 to +5VDC    |
; |     0      |     1      | -5 to +5VDC   |
; |     1      |     1      | -10 to +10VDC |
; -------------------------------------------
; -------------------------------------------
; | Mode Bit A | Mode Bit B |   Frequency   |
; |     1      |     1      |      76Hz     |
; |     0      |     1      |     610Hz     |
; |     1      |     0      |     1221Hz    |
; |     0      |     0      |     4883Hz    |
; -------------------------------------------
;Wizard Sets Parameter 420 to desired Analog Option
IF SV_MACHINE_PARAMETER_420 == 0 THEN RST SpindleDACModeBitA_O, RST SpindleDACModeBitB_O ;4883Hz
IF SV_MACHINE_PARAMETER_420 == 1 THEN SET SpindleDACModeBitA_O, RST SpindleDACModeBitB_O ;1221Hz
IF SV_MACHINE_PARAMETER_420 == 2 THEN RST SpindleDACModeBitA_O, SET SpindleDACModeBitB_O ;610Hz
IF SV_MACHINE_PARAMETER_420 == 3 THEN SET SpindleDACModeBitA_O, SET SpindleDACModeBitB_O ;76Hz

;Wizard Sets Parameter 814 to desired PWM Option or Second Spindle Option
IF SV_MACHINE_PARAMETER_814 == 76   THEN SET AuxDACModeBitA_O, SET AuxDACModeBitB_O
IF SV_MACHINE_PARAMETER_814 == 610  THEN RST AuxDACModeBitA_O, SET AuxDACModeBitB_O
IF SV_MACHINE_PARAMETER_814 == 1221 THEN SET AuxDACModeBitA_O, RST AuxDACModeBitB_O
IF SV_MACHINE_PARAMETER_814 == 4883 THEN RST AuxDACModeBitA_O, RST AuxDACModeBitB_O

IF (!SpindleDACModeBitA_O && !SpindleDACModeBitB_O) ||
  (SpindleDACModeBitA_O && !SpindleDACModeBitB_O)
  THEN SET ZeroTo5Or10Stage, RST Minus5Or10ToPlus5Or10Stage
  
IF (!SpindleDACModeBitA_O && SpindleDACModeBitB_O) ||
  (SpindleDACModeBitA_O && SpindleDACModeBitB_O)
  THEN RST ZeroTo5Or10Stage, SET Minus5Or10ToPlus5Or10Stage

;==============================================================================
                               LaserAnalogStage
;==============================================================================
;Tell CNC12 that Spindle is always in Auto Mode.
; This allows S commands to take effect.
IF True_M THEN (SelectManAutoSpindle)

;Set Spindle Knob to 100% always, so that S command is unaffected.
IF True_M THEN SV_PLC_SPINDLE_KNOB = 100

;------------------------------------------------------------------------------
;              Read commanded spindle speed, max & min
;
; ***NOTE***  SV_PC_COMMANDED_SPINDLE_SPEED already has override
;             factored in.
;------------------------------------------------------------------------------
IF True_M THEN CfgMinSpeed_FW = SV_PC_CONFIG_MIN_SPINDLE_SPEED,
               CfgMaxSpeed_FW = SV_PC_CONFIG_MAX_SPINDLE_SPEED

; Calculate #RPM's per bit of resolution
IF CfgMaxSpeed_FW > 0.0 THEN RPMPerBit_FW = CfgMaxSpeed_FW/65535.0
IF CfgMaxSpeed_FW <= 0.0 THEN RPMPerBit_FW = 1.0

; In auto mode, assuming M3 or M4 present, use given RPM from CNC11/CNC12
IF True_M THEN SpinSpeedCommand_FW = SV_PC_COMMANDED_SPINDLE_SPEED
IF SpinSpeedCommand_FW > 1 THEN SET MEM999
IF SpinSpeedCommand_FW < 1 THEN RST MEM999
                                               
IF DoSpindleStop THEN SpinSpeedCommand_FW = 0.0

;------------------------------------------------------------------------------
; If commanded spindle speed is < Min Spin Speed * SpinRangeAdjust
; & commanded spindle speed > 0, force to commanded spindle speed
; = min spin speed value * SpinRangeAdjust.
;------------------------------------------------------------------------------
IF (SpinSpeedCommand_FW > 0.0) && (SpinSpeedCommand_FW < (CfgMinSpeed_FW))
  THEN SpinSpeedCommand_FW = (CfgMinSpeed_FW),
       InfoMsg_W = MIN_SPEED_MSG

;------------------------------------------------------------------------------
; If SpinSpeedCommand_FW > Max Spin Speed * SpinRangeAdjust, force
; SpinSpeedCommand_FW = max spin speed value * SpinRangeAdjust.
;------------------------------------------------------------------------------
IF SpinSpeedCommand_FW > CfgMaxSpeed_FW THEN SpinSpeedCommand_FW = CfgMaxSpeed_FW
  
  ; The following bits control the actual analog hardware output on the ACORN_6
; Output = 16bit (0-65535) Default 0-10VDC.
; Different analog ranges are available by setting mode bits:
; -------------------------------------------
; | Mode bit A | Mode bit B | Range         |
; |     0      |     0      | 0 to +10VDC   |
; |     1      |     0      | 0 to +5VDC    |
; |     0      |     1      | -5 to +5VDC   |
; |     1      |     1      | -10 to +10VDC |
; -------------------------------------------
; -------------------------------------------
; | Mode Bit A | Mode Bit B |   Frequency   |
; |     1      |     1      |      76Hz     |
; |     0      |     1      |     610Hz     |
; |     1      |     0      |     1221Hz    |
; |     0      |     0      |     4883Hz    |
; -------------------------------------------
;Wizard Sets Parameter 420 to desired Analog Option
IF SV_MACHINE_PARAMETER_420 == 0 THEN RST SpindleDACModeBitA_O, RST SpindleDACModeBitB_O ;4883Hz
IF SV_MACHINE_PARAMETER_420 == 1 THEN SET SpindleDACModeBitA_O, RST SpindleDACModeBitB_O ;1221Hz
IF SV_MACHINE_PARAMETER_420 == 2 THEN RST SpindleDACModeBitA_O, SET SpindleDACModeBitB_O ;610Hz
IF SV_MACHINE_PARAMETER_420 == 3 THEN SET SpindleDACModeBitA_O, SET SpindleDACModeBitB_O ;76Hz

;Wizard Sets Parameter 814 to desired PWM Option or Second Spindle Option
IF SV_MACHINE_PARAMETER_814 == 76   THEN SET AuxDACModeBitA_O, SET AuxDACModeBitB_O
IF SV_MACHINE_PARAMETER_814 == 610  THEN RST AuxDACModeBitA_O, SET AuxDACModeBitB_O
IF SV_MACHINE_PARAMETER_814 == 1221 THEN SET AuxDACModeBitA_O, RST AuxDACModeBitB_O
IF SV_MACHINE_PARAMETER_814 == 4883 THEN RST AuxDACModeBitA_O, RST AuxDACModeBitB_O

;Convert RPM to 16 bit value
IF True_M THEN SixteenBitSpeed_FW = SpinSpeedCommand_FW/RPMPerBit_FW

;Convert to integer word for DAC & I/O Display
IF True_M THEN SixteenBitSpeed_W = SixteenBitSpeed_FW

;Bound min 0 to max 65535
IF SixteenBitSpeed_W < 0 THEN SixteenBitSpeed_W = 0
IF SixteenBitSpeed_W > 65535 THEN SixteenBitSpeed_W = 65535

; Output to DAC
IF True_M THEN WTB SixteenBitSpeed_W SpinAnalogOutBit0_O 16

;------------------------------------------------------------------------------
;                               Laser Frequency
;------------------------------------------------------------------------------
;Calculate # of hz per bit
IF SV_MACHINE_PARAMETER_814 > 0.0 THEN HZPerBit_FW = SV_MACHINE_PARAMETER_814/65535.0
IF SV_MACHINE_PARAMETER_814 <= 0.0 THEN HZPerBit_FW = 1.0

;Get Frequency Command
IF True_M THEN FrequencyCommand_FW = SV_MACHINE_PARAMETER_950

IF DoSpindleStop THEN FrequencyCommand_FW = 0.0

;Convert Frequency to 16 bit value
IF True_M THEN SixteenBitFrequency_FW = FrequencyCommand_FW/HZPerBit_FW

;Convert to Integer for DAC/PWM
IF True_M THEN SixteenBitFrequency_W = SixteenBitFrequency_FW

;Bound min 0 to max 65535
IF SixteenBitFrequency_W < 0 THEN SixteenBitFrequency_W = 0
IF SixteenBitFrequency_W > 65535 THEN SixteenBitFrequency_W = 65535

; Output to DAC
;For PWM VM Mode (P969 == 1), the PLC must not write to the analog bits, as
; it will conflict with the commands of PWM VM.
IF SV_MACHINE_PARAMETER_969 == 0 THEN WTB SixteenBitFrequency_W AuxAnalogOutBit0_O 16

;------------------------------------------------------------------------------
                               ZeroTo5Or10Stage
;------------------------------------------------------------------------------
;----------------------------------------------------------------
; Convert Spindle "S" command to 16 bit value for output to DAC
;----------------------------------------------------------------
; Commanded Spindle speed (includes override factor) is sent down from CNC11
; in SV_PC_COMMANDED_SPINDLE_SPEED.  This value needs to be converted to a
; 16 bit value (0-65535) where full scale = SV_PC_CONFIG_MAX_SPINDLE_SPEED.

;Display calculated RPM value on PC
IF RPMSensorDisabled_M THEN SV_PLC_SPINDLE_SPEED = SpinSpeedCommand_FW

;Display Calculated RPM Value from Sensor
IF SpinSensorTimer_FW <= 0 THEN SpinSensorTimer_FW = 60000
IF True_M then SpinSensorSpeed_FW = ((1/SpinSensorTimer_FW) * 60000)
IF SpinSensorSpeed_FW <=20 THEN SpinSensorSpeed_FW = 0

IF !RPMSensorDisabled_M THEN SV_PLC_SPINDLE_SPEED = SpinSensorSpeed_FW

;Save Value for PWM Before Adjustments are Made
IF True_M THEN PWMBitSpeed_FW = SpinSpeedCommand_FW

;Scale Spindle Speed if Enabled
; This allows 0V to be the minimum Spindle Speed.
IF SpindleScalingEnable_M && SpinSpeedCommand_FW > 0.0 && CfgMaxSpeed_FW > 0.0
  THEN SpinSpeedCommand_FW = (((SpinSpeedCommand_FW - CfgMinSpeed_FW) /
                             (CfgMaxSpeed_FW - CfgMinSpeed_FW)) * CfgMaxSpeed_FW)

;Scale PWM if Enabled
IF !PWMFloorVOnly_M && PWMBitSpeed_FW > 0.0 && CfgMaxSpeed_FW > 0.0
  THEN PWMBitSpeed_FW = ((PWMBitSpeed_FW / CfgMaxSpeed_FW) *
                        (CfgMaxSpeed_FW - PWMDutyFloor_W)) + PWMDutyFloor_W

;Convert RPM to 16 bit value
IF True_M THEN SixteenBitSpeed_FW = SpinSpeedCommand_FW/RPMPerBit_FW
IF True_M THEN PWMBitSpeed_FW = PWMBitSpeed_FW/RPMPerBit_FW

; Factor in gear range
IF True_M THEN SixteenBitSpeed_FW = (SixteenBitSpeed_FW/SpinRangeAdjust_FW)

;Convert to integer word for DAC & I/O display
IF True_M THEN SixteenBitSpeed_W = SixteenBitSpeed_FW
IF True_M THEN PWMBitSpeed_W = PWMBitSpeed_FW

;Disable Spindle if M37 Active
IF M37 THEN SixteenBitSpeed_W = 0

; Bound min to 0, max to 65535
IF SixteenBitSpeed_W < 0 THEN SixteenBitSpeed_W = 0
IF SixteenBitSpeed_W > 65535 THEN SixteenBitSpeed_W = 65535
IF PWMBitSpeed_W < 0 THEN PWMBitSpeed_W = 0
IF PWMBitSpeed_W > 65535 THEN PWMBitSpeed_W = 65535

; Output to DAC
IF True_M THEN WTB SixteenBitSpeed_W SpinAnalogOutBit0_O 16

;Output to Second Analog
;For PWM VM Mode (P969 == 1), the PLC must not write to the analog bits, as
; it will conflict with the commands of PWM VM.
;When M37 is not active, ensure PWM is 0.
IF !M37 THEN PWMBitSpeed_W = 0

;If Second Spindle Disabled, Use PWMBitSpeed_W
IF (!M37 && SV_MACHINE_PARAMETER_459 == 0) ||
  (M37 && SV_MACHINE_PARAMETER_969 == 0)
  THEN WTB PWMBitSpeed_W AuxAnalogOutBit0_O 16

;If Second Spindle Active, Use SixteenBitSpeed_W
IF SV_MACHINE_PARAMETER_459 != 0 THEN WTB SixteenBitSpeed_W AuxAnalogOutBit0_O 16

;------------------------------------------------------------------------------
                          Minus5Or10ToPlus5Or10Stage
;------------------------------------------------------------------------------
;*****************************************************************

; Output to DAC

;Standard twelve bit value spindle analog output not used in this program, 
;instead, 16 bit SpindleCommand (0-65536) is sent to -10-+10 output for axis4
;on GPIO4D. SixteenBitSpeed_W:  0 = -10VDC, 32768 = 0VDC, 65536 = +10VDC  

;Display calculated RPM value on PC
IF RPMSensorDisabled_M THEN SV_PLC_SPINDLE_SPEED = SpinSpeedCommand_FW

;Display Calculated RPM Value from Sensor
IF SpinSensorTimer_FW <= 0 THEN SpinSensorTimer_FW = 60000
IF True_M then SpinSensorSpeed_FW = ((1/SpinSensorTimer_FW) * 60000)
IF SpinSensorSpeed_FW <=20 THEN SpinSensorSpeed_FW = 0

IF !RPMSensorDisabled_M THEN SV_PLC_SPINDLE_SPEED = SpinSensorSpeed_FW

;Scale Spindle Speed if Enabled
; This allows 0V to be the minimum Spindle Speed.
IF SpindleScalingEnable_M && SpinSpeedCommand_FW > 0.0 && CfgMaxSpeed_FW > 0.0
  THEN SpinSpeedCommand_FW = (((SpinSpeedCommand_FW - CfgMinSpeed_FW) /
                             (CfgMaxSpeed_FW - CfgMinSpeed_FW)) * CfgMaxSpeed_FW)

;Scale RPM command to 16 bit 
IF True_M THEN SixteenBitSpeed_FW = SpinSpeedCommand_FW/RPMPerBit_FW

;Save Value for PWM Before Gear Conversion and save to Integer
IF True_M THEN PWMBitSpeed_W = SixteenBitSpeed_FW

;Factor in gear range
IF True_M THEN SixteenBitSpeed_FW = (SixteenBitSpeed_FW/SpinRangeAdjust_FW)

;Convert to integer word for DAC & I/O display
IF True_M THEN SixteenBitSpeed_W = SixteenBitSpeed_FW

;Disable Spindle if M37 Active
IF M37 THEN SixteenBitSpeed_W = 0

;0 RPM = 32768
;IF command is CW (SpindleDirectionOut = OFF) + 32768
;IF command is CCW (SpindleDirectionOut = OFF), negate SixteenBitSpeed_W
;and add to 32768
IF !SpindleDirectionOut_M THEN SixteenBitSpeed_W = ((SixteenBitSpeed_W*.5) + 32768) 
IF SpindleDirectionOut_M THEN SixteenBitSpeed_W = (((SixteenBitSpeed_W * -1)*.5) + 32768)

; Bound min to 0, max to 65535
IF SixteenBitSpeed_W < 0 THEN SixteenBitSpeed_W = 0
IF SixteenBitSpeed_W > 65535 THEN SixteenBitSpeed_W = 65535
IF PWMBitSpeed_W < 0 THEN PWMBitSpeed_W = 0
IF PWMBitSpeed_W > 65535 THEN PWMBitSpeed_W = 65535

IF True_M THEN WTB SixteenBitSpeed_W SpinAnalogOutBit0_O 16

;Output to Second Analog
;For PWM VM Mode (P969 == 1), the PLC must not write to the analog bits, as
; it will conflict with the commands of PWM VM.
;When M37 is not active, ensure PWM is 0.
IF !M37 THEN PWMBitSpeed_W = 0
  
;If Second Spindle Disabled, Use PWMBitSpeed_W
IF (!M37 && SV_MACHINE_PARAMETER_459 == 0) ||
  (M37 && SV_MACHINE_PARAMETER_969 == 0)
  THEN WTB PWMBitSpeed_W AuxAnalogOutBit0_O 16

;If Second Spindle Active, Use SixteenBitSpeed_W
IF SV_MACHINE_PARAMETER_459 != 0 THEN WTB SixteenBitSpeed_W AuxAnalogOutBit0_O 16

;=============================================================================
                            JogKeysNormalStage
;=============================================================================
;        X+  LATHE                     MILL   Y+       Z+
;        |                           4+       |
;   Z- -- -- Z+                          X- -- -- X+
;        |                                    |
;        X-                          4-       Y-       Z-
IF (Ax1PlusJogKey_I  || KbJogAx1Plus_M || SkinJogAx1Plus_SV || UsbMpgAxis1JogPlus_M ||
  SkinJogAx1Ax2Plus_SV || SkinJogAx1PlusAx2Minus_SV || Ax1_PlusJoystick_I || ExtUsb_Ax1PlusJog_SV ||
  ExtUsb_Ax1Ax2PlusJog_SV || ExtUsb_Ax1PlusAx2MinusJog_SV || KbJogAx1PlusAx2Minus_M || KbJogAx1Ax2Plus_M ||
  (ShuttleAxisJogPlusKey && ShuttleAxis1Selected)) && !Ax1PlusJogDisabled_M && !AllJogDisabled_M &&
  !(IncrContLED && FinalFeedOverride_W == 0) THEN (DoAx1PlusJog_SV), (ExtUsb_Ax1PlusJogOut_SV), (ExtUsb_Ax1Ax2PlusJogOut_SV), (ExtUsb_Ax1PlusAx2MinusJogOut_SV)
IF (Ax1MinusJogKey_I || KbJogAx1Minus_M || SkinJogAx1Minus_SV || UsbMpgAxis1JogMinus_M ||
  SkinJogAx1Ax2Minus_SV || SkinJogAx1MinusAx2Plus_SV || Ax1_MinusJoystick_I || ExtUsb_Ax1MinusJog_SV ||
  ExtUsb_Ax1Ax2MinusJog_SV || ExtUsb_Ax1MinusAx2PlusJog_SV || KbJogAx1Ax2Minus_M || KbJogAx1MinusAx2Plus_M ||
  (ShuttleAxisJogMinusKey && ShuttleAxis1Selected)) && !Ax1MinusJogDisabled_M && !AllJogDisabled_M &&
   !(IncrContLED && FinalFeedOverride_W == 0) THEN (DoAx1MinusJog_SV), (ExtUsb_Ax1Ax2MinusJogOut_SV), (ExtUsb_Ax1MinusAx2PlusJogOut_SV), (ExtUsb_Ax1MinusJogOut_SV)
IF (Ax2PlusJogKey_I  || KbJogAx2Plus_M || SkinJogAx2Plus_SV || UsbMpgAxis2JogPlus_M ||
  SkinJogAx1Ax2Plus_SV || SkinJogAx1MinusAx2Plus_SV || Ax2_PlusJoystick_I || ExtUsb_Ax2PlusJog_SV ||
  ExtUsb_Ax1Ax2PlusJog_SV || ExtUsb_Ax1MinusAx2PlusJog_SV || KbJogAx1Ax2Plus_M || KbJogAx1MinusAx2Plus_M ||
  (ShuttleAxisJogPlusKey && ShuttleAxis2Selected)) && !Ax2PlusJogDisabled_M  && !AllJogDisabled_M &&
  !(IncrContLED && FinalFeedOverride_W == 0) THEN (DoAx2PlusJog_SV), (ExtUsb_Ax1Ax2PlusJogOut_SV), (ExtUsb_Ax2PlusJogOut_SV), (ExtUsb_Ax1MinusAx2PlusJogOut_SV)
IF (Ax2MinusJogKey_I || KbJogAx2Minus_M || SkinJogAx2Minus_SV || UsbMpgAxis2JogMinus_M ||
  SkinJogAx1Ax2Minus_SV || SkinJogAx1PlusAx2Minus_SV || Ax2_MinusJoystick_I || ExtUsb_Ax2MinusJog_SV ||
  ExtUsb_Ax1Ax2MinusJog_SV || ExtUsb_Ax1PlusAx2MinusJog_SV || KbJogAx1Ax2Minus_M || KbJogAx1PlusAx2Minus_M ||
  (ShuttleAxisJogMinusKey && ShuttleAxis2Selected)) && !Ax2MinusJogDisabled_M && !AllJogDisabled_M &&
  !(IncrContLED && FinalFeedOverride_W == 0) THEN (DoAx2MinusJog_SV), (ExtUsb_Ax1PlusAx2MinusJogOut_SV), (ExtUsb_Ax2MinusJogOut_SV), (ExtUsb_Ax1Ax2MinusJogOut_SV)

;=============================================================================
                              JogKeysInvert2Stage
;=============================================================================
;        X-  LATHE                    MILL   Y-       Z+
;        |                          4+       |
;   Z- -- -- Z+                         X- -- -- X+
;        |                                   |
;        X+                         4-       Y+       Z-
IF (Ax1PlusJogKey_I  || KbJogAx1Plus_M || SkinJogAx1Plus_SV || UsbMpgAxis1JogPlus_M ||
  SkinJogAx1Ax2Plus_SV || SkinJogAx1PlusAx2Minus_SV || Ax1_PlusJoystick_I || ExtUsb_Ax1PlusJog_SV ||
  ExtUsb_Ax1Ax2PlusJog_SV || ExtUsb_Ax1PlusAx2MinusJog_SV || KbJogAx1Ax2Plus_M || KbJogAx1PlusAx2Minus_M ||
  (ShuttleAxisJogPlusKey && ShuttleAxis1Selected)) && !Ax1PlusJogDisabled_M && !AllJogDisabled_M &&
   !(IncrContLED && FinalFeedOverride_W == 0) THEN (DoAx1PlusJog_SV), (ExtUsb_Ax1PlusJogOut_SV), (ExtUsb_Ax1Ax2PlusJogOut_SV), (ExtUsb_Ax1PlusAx2MinusJogOut_SV)
IF (Ax1MinusJogKey_I || KbJogAx1Minus_M || SkinJogAx1Minus_SV || UsbMpgAxis1JogMinus_M ||
  SkinJogAx1Ax2Minus_SV || SkinJogAx1MinusAx2Plus_SV || Ax1_MinusJoystick_I || ExtUsb_Ax1MinusJog_SV ||
  ExtUsb_Ax1Ax2MinusJog_SV || ExtUsb_Ax1MinusAx2PlusJog_SV || KbJogAx1Ax2Minus_M || KbJogAx1MinusAx2Plus_M ||
  (ShuttleAxisJogMinusKey && ShuttleAxis1Selected) ) && !Ax1MinusJogDisabled_M && !AllJogDisabled_M &&
   !(IncrContLED && FinalFeedOverride_W == 0) THEN (DoAx1MinusJog_SV), (ExtUsb_Ax1Ax2MinusJogOut_SV), (ExtUsb_Ax1MinusAx2PlusJogOut_SV), (ExtUsb_Ax1MinusJogOut_SV)
IF (Ax2MinusJogKey_I  || KbJogAx2Minus_M || SkinJogAx2Minus_SV || UsbMpgAxis2JogPlus_M ||
  SkinJogAx1Ax2Minus_SV || SkinJogAx1PlusAx2Minus_SV || Ax2_MinusJoystick_I || ExtUsb_Ax2PlusJog_SV ||
  ExtUsb_Ax1Ax2PlusJog_SV || ExtUsb_Ax1MinusAx2PlusJog_SV || KbJogAx1Ax2Minus_M || KbJogAx1PlusAx2Minus_M ||
  (ShuttleAxisJogMinusKey && ShuttleAxis2Selected)) && !Ax2PlusJogDisabled_M  && !AllJogDisabled_M &&
   !(IncrContLED && FinalFeedOverride_W == 0) THEN (DoAx2PlusJog_SV), (ExtUsb_Ax1Ax2PlusJogOut_SV), (ExtUsb_Ax2PlusJogOut_SV), (ExtUsb_Ax1MinusAx2PlusJogOut_SV)
IF (Ax2PlusJogKey_I || KbJogAx2Plus_M || SkinJogAx2Plus_SV || UsbMpgAxis2JogMinus_M ||
  SkinJogAx1Ax2Plus_SV || SkinJogAx1MinusAx2Plus_SV || Ax2_PlusJoystick_I || ExtUsb_Ax2MinusJog_SV ||
  ExtUsb_Ax1Ax2MinusJog_SV || ExtUsb_Ax1PlusAx2MinusJog_SV || KbJogAx1Ax2Plus_M || KbJogAx1MinusAx2Plus_M ||
  (ShuttleAxisJogPlusKey && ShuttleAxis2Selected)) && !Ax2MinusJogDisabled_M && !AllJogDisabled_M &&
  !(IncrContLED && FinalFeedOverride_W == 0) THEN (DoAx2MinusJog_SV), (ExtUsb_Ax1PlusAx2MinusJogOut_SV), (ExtUsb_Ax2MinusJogOut_SV), (ExtUsb_Ax1Ax2MinusJogOut_SV)

;=============================================================================
                              JogKeysSwappedStage
;=============================================================================
;        Z+  LATHE                       MILL   X+       Z+
;        |                             4+       |
;   X- -- -- X+                            Y- -- -- Y+
;        |                                      |
;        Z-                            4-       X-       Z-
IF (Ax2PlusJogKey_I  || KbJogAx2Plus_M || SkinJogAx2Plus_SV || UsbMpgAxis2JogPlus_M ||
  SkinJogAx1Ax2Plus_SV || SkinJogAx1MinusAx2Plus_SV || Ax2_PlusJoystick_I || ExtUsb_Ax1PlusJog_SV ||
  ExtUsb_Ax1Ax2PlusJog_SV || ExtUsb_Ax1PlusAx2MinusJog_SV || KbJogAx1Ax2Plus_M || KbJogAx1MinusAx2Plus_M ||
  (ShuttleAxisJogPlusKey && ShuttleAxis2Selected)) && !Ax1PlusJogDisabled_M && !AllJogDisabled_M &&
