;=============================================================================
                                AxesEnableStage
;=============================================================================

;allow MPU11 to turn on drives if no drive or drive fiber errors
IF !DriveComFltIn_M && !DriveComFltOut_M THEN SET SV_MASTER_ENABLE

;Report external drive faults
IF SV_AXIS_VALID_1 && SV_PC_POWER_AXIS_1 && (!Axis1DriveOk && DriveFaultTimer)
  THEN FaultMsg_W = AXIS1_DRIVE_FAULT_MSG, ; 6401(1+256*25)
    SET AxisFault_M
IF SV_AXIS_VALID_2 && SV_PC_POWER_AXIS_2 && (!Axis2DriveOk && DriveFaultTimer)
  THEN FaultMsg_W = AXIS2_DRIVE_FAULT_MSG, ; 6655(1+256*26)
    SET AxisFault_M
IF SV_AXIS_VALID_3 && SV_PC_POWER_AXIS_3 && (!Axis3DriveOk && DriveFaultTimer)
  THEN FaultMsg_W = AXIS3_DRIVE_FAULT_MSG, ; 6913(1+256*27)
    SET AxisFault_M
IF SV_AXIS_VALID_4 && SV_PC_POWER_AXIS_4 && (!Axis4DriveOk && DriveFaultTimer)
  THEN FaultMsg_W = AXIS4_DRIVE_FAULT_MSG, ; 7169(1+256*28)
    SET AxisFault_M
IF SV_AXIS_VALID_5 && SV_PC_POWER_AXIS_5 && (!Axis5DriveOk && DriveFaultTimer)
  THEN FaultMsg_W = AXIS5_DRIVE_FAULT_MSG, ; 7425(1+256*29)
    SET AxisFault_M
IF SV_AXIS_VALID_6 && SV_PC_POWER_AXIS_6 && (!Axis6DriveOk && DriveFaultTimer)
  THEN FaultMsg_W = AXIS6_DRIVE_FAULT_MSG, ; 12289(1+256*48)
    SET AxisFault_M

; Axis Brake Logic
IF (SV_PC_POWER_AXIS_1) THEN (Axis1BrakeRelease)
IF (SV_PC_POWER_AXIS_2) THEN (Axis2BrakeRelease)
IF (SV_PC_POWER_AXIS_3) THEN (Axis3BrakeRelease)
IF (SV_PC_POWER_AXIS_4) THEN (Axis4BrakeRelease)
IF (SV_PC_POWER_AXIS_5) THEN (Axis5BrakeRelease)
IF (SV_PC_POWER_AXIS_6) THEN (Axis6BrakeRelease)

;clear axis fault errors
IF !EStopOk_M THEN RST AxisFault_M

;----------------------------------------------------------------------------
;                               DriveOk Section
;----------------------------------------------------------------------------
IF !EStopOk_M || (DriveOk && Axis1DriveOk && Axis2DriveOk && Axis3DriveOk && Axis4DriveOk) ||
	(!SV_PC_POWER_AXIS_1 && !SV_PC_POWER_AXIS_2 && !SV_PC_POWER_AXIS_3 && !SV_PC_POWER_AXIS_4 &&
	!SV_PC_POWER_AXIS_5 && !SV_PC_POWER_AXIS_6) THEN RST DriveFaultTimer

IF Initialize_T && (!DriveOk && DriveFaultTimer) && EStopOk_M && (SV_PC_POWER_AXIS_1 || SV_PC_POWER_AXIS_2 ||
	SV_PC_POWER_AXIS_3 || SV_PC_POWER_AXIS_4 || SV_PC_POWER_AXIS_5 || SV_PC_POWER_AXIS_6)
	THEN FaultMsg_W = DRIVE_FAULT_MSG, SET DriveFault_M, SET OtherFault_M

; (SV_MASTER_ENABLE will be turned off by stalls and other
;  errors in the Fault-handling section of MainStage, below.)

;(If there is any drive or drive fiber error, then AxisFault_M will have
; been set previously, which will cause SV_STOP to be set, and SV_MASTER_ENABLE
; to be reset, later in MainStage)

;------------------------------------------------------------------------------
;                      Drive Status and Control Section
;------------------------------------------------------------------------------
;ACORN_6 drive status and control bits
; SV_DRIVE_STATUS_x
;  3 == Quadrature generator error
;
; SV_DRIVE_CONTROL_x
;	0 == A / step invert
;	1 == B / direction invert
;	2 == Z / enable invert
;	3 == Quadrature (1) or step and direction (0) output
;   15 == enable
;------------------------------------------------------------------------------
IF True_M THEN P961Value_W = SV_MACHINE_PARAMETER_961

;Axis 1
;Also Inverts EnableAll
IF True_M THEN BITTST P961Value_W 0 AxisStepInverted_M,
			 BITTST P961Value_W 1 AxisDirectionInverted_M,
			 BITTST P961Value_W 2 AxisEnabledInverted_M,
			 BITTST P961Value_W 3 AxisQuadrature_M,
			 AxisControlValue_W = SV_DRIVE_CONTROL_1
			 
IF AxisStepInverted_M THEN BITSET AxisControlValue_W 0
IF !AxisStepInverted_M THEN BITRST AxisControlValue_W 0
IF AxisDirectionInverted_M THEN BITSET AxisControlValue_W 1
IF !AxisDirectionInverted_M THEN BITRST AxisControlValue_W 1
IF AxisEnabledInverted_M THEN BITSET AxisControlValue_W 2
IF !AxisEnabledInverted_M THEN BITRST AxisControlValue_W 2
IF AxisQuadrature_M THEN BITSET AxisControlValue_W 3
IF !AxisQuadrature_M THEN BITRST AxisControlValue_W 3

IF True_M THEN SV_DRIVE_CONTROL_1 = AxisControlValue_W

;Axis 2
