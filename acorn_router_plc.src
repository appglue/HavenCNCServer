; #endregion


; These bits control the actual analog hardware output
; Output = 16bit (0-65536) 0-10VDC.
; WTB 16 Bits
SpinAnalogOutBit0_O             IS OUT17
SpinAnalogOutBit1_O             IS OUT18
SpinAnalogOutBit2_O             IS OUT19
SpinAnalogOutBit3_O             IS OUT20
SpinAnalogOutBit4_O             IS OUT21
SpinAnalogOutBit5_O             IS OUT22
SpinAnalogOutBit6_O             IS OUT23
SpinAnalogOutBit7_O             IS OUT24
SpinAnalogOutBit8_O             IS OUT25
SpinAnalogOutBit9_O             IS OUT26
SpinAnalogOutBit10_O            IS OUT27
SpinAnalogOutBit11_O            IS OUT28
SpinAnalogOutBit12_O            IS OUT29
SpinAnalogOutBit13_O            IS OUT30
SpinAnalogOutBit14_O            IS OUT31
SpinAnalogOutBit15_O            IS OUT32

;WTB 16 Bits
AuxAnalogOutBit0_O              IS OUT33
AuxAnalogOutBit1_O              IS OUT34
AuxAnalogOutBit2_O              IS OUT35
AuxAnalogOutBit3_O              IS OUT36
AuxAnalogOutBit4_O              IS OUT37
AuxAnalogOutBit5_O              IS OUT38
AuxAnalogOutBit6_O              IS OUT39
AuxAnalogOutBit7_O              IS OUT40
AuxAnalogOutBit8_O              IS OUT41
AuxAnalogOutBit9_O              IS OUT42
AuxAnalogOutBit10_O             IS OUT43
AuxAnalogOutBit11_O             IS OUT44
AuxAnalogOutBit12_O             IS OUT45
AuxAnalogOutBit13_O             IS OUT46
AuxAnalogOutBit14_O             IS OUT47
AuxAnalogOutBit15_O             IS OUT48

; The following bits control the actual analog hardware output on the ACORN_6.
; Output = 16bit (0-65535) Default 0-10VDC.
; Different analog ranges are available by setting mode bits A and B:
; -------------------------------------------
; | Mode bit A | Mode bit B | Range         |
; |     0      |     0      | 0 to +10VDC   |
; |     1      |     0      | 0 to +5VDC    |
; |     0      |     1      | -5 to +5VDC   |
; |     1      |     1      | -10 to +10VDC |
; -------------------------------------------
; -------------------------------------------
; | Mode Bit A | Mode Bit B |   Frequency   |
; |     1      |     1      |      76Hz     |
; |     0      |     1      |     610Hz     |
; |     1      |     0      |     1221Hz    |
; |     0      |     0      |     4883Hz    |
; -------------------------------------------
SpindleDACModeBitA_O            IS OUT49 ;Logical only
SpindleDACModeBitB_O            IS OUT50 ;Logical only

AuxDACModeBitA_O                IS OUT51 ;Logical only
AuxDACModeBitB_O                IS OUT52 ;Logical only

;WTB 7 Bits
StepRate1_O                     IS OUT57 ;Logical only
StepRate2_O                     IS OUT58 ;Logical only
StepRate3_O                     IS OUT59 ;Logical only
StepRate4_O                     IS OUT60 ;Logical only
StepRate5_O                     IS OUT61 ;Logical only
StepRate6_O                     IS OUT62 ;Logical only
StepRate7_O                     IS OUT63 ;Logical only

MPG_LED_OUT                     IS OUT769

