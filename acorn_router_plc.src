;       Jog Panel LED's can be addressed as OUT1057 - OUT1312
;                              OR
;                         JPO1 - JPO256
;------------------------------------------------------------------------------
; Definitions follow JOGBOARD layout top to bottom, left to right
;
SpinOverPlusLED               IS OUT1057; Row  1 Column 1
