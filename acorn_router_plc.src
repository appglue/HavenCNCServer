IF LimitOverridePD && Input_IsLimit_M && (!INP8 ^ Input_IsInverted_M) THEN BITSET Limit_Invert_W 15
IF LimitOverridePD && Input_IsLimit_M && (INP8 ^ Input_IsInverted_M) THEN BITRST Limit_Invert_W 15

;Invert Limit Inputs
IF LimitOverridePD THEN SV_INVERT_INP1_16_BITS = Limit_Invert_W

;---------------------------------------------------------------------------------------------------------------------------------------
