;------------------------------------------------------------------------------
; Filename: cncm.hom
; Description: Homing with Software Paired Axis
; Notes: Only 1 pair is squared, other is paired and home to Master Switch.
; Requires: CNC12 V5.32.00+
; Revision Date: 22 Aug 2025
; Please see TB300 or the following link for tips on writing custom macros.
; https://www.centroidcnc.com/centroid_diy/downloads/acorn_documentation/centroid_cnc_macro_programming.pdf
; Copyright SMC 2025
;------------------------------------------------------------------------------
;-Parameters:
;
;-System Variables:
;
;-PLC Variables:
;
;-User Variables:
; #100 : Message Timer (Infinite Timer)
; #101 : Message Timer
; #102 : Master Axis 1
; #103 : Slaved Axis 1
; #104 : Master Axis 2
; #105 : Slaved Axis 2
; #106 : AutoSquare Master Axis
; #107 : AutoSquare Slave Axis
; #108 : AutoSquare Master Input
; #109 : AutoSquare Slave Input
; #110 : AutoSquare Attempts Count
; #111 : Home Switch Tripped Error
; #113 : Slave Axis has been Homed.
; #121 : Axis 1 Home Input
; #122 : Axis 2 Home Input
; #123 : Axis 3 Home Input
; #124 : Axis 4 Home Input
; #125 : Axis 5 Home Input
; #126 : Axis 6 Home Input
; #127 : Axis 7 Home Input
; #128 : Axis 8 Home Input
; #159 : Saved P64 Value

;------------------------------------------------------------------------------
IF #50001                        ;Prevent lookahead from parsing past here
IF #4201 || #4202 THEN GOTO 1000 ;Skip macro if graphing or searching

;--Define Setup
G65 "#400\system\setup_defines.cnc"

DEFINE <SAVED_PAIRED_VALUE>   #159
DEFINE <MASTER_AXIS_1>        #102
DEFINE <SLAVE_AXIS_1>         #103
DEFINE <MASTER_AXIS_2>        #104
DEFINE <SLAVE_AXIS_2>         #105
DEFINE <MASTER_AXIS>          #106
DEFINE <SLAVE_AXIS>           #107
DEFINE <MASTER_INPUT>         #108
DEFINE <SLAVE_INPUT>          #109
DEFINE <AUTOSQUARE_ATTEMPTS>  #110
DEFINE <HOME_SWITCH_TRIPPED>  #111
DEFINE <MASTER_AXIS_LABEL>    #112

DEFINE <AXIS_1_HOME_INPUT>    #121
DEFINE <AXIS_2_HOME_INPUT>    #122
DEFINE <AXIS_3_HOME_INPUT>    #123
DEFINE <AXIS_4_HOME_INPUT>    #124
DEFINE <AXIS_5_HOME_INPUT>    #125
DEFINE <AXIS_6_HOME_INPUT>    #126
DEFINE <AXIS_7_HOME_INPUT>    #127
DEFINE <AXIS_8_HOME_INPUT>    #128

;--User Variable Setup
#100 = 0 ;Message Timer for "Permenant" Messages
#101 = 2 ;Message Timer for Timed Messages
#113 = 0 ;Slave has been Homed Flag
#114 = 0 ;Reset Loop Counter
<HOME_SWITCH_TRIPPED> = 0 ;Home Switch Tripped Error
<AUTOSQUARE_ATTEMPTS> = 0 ;Auto Square Attempts Count
<AXIS_1_HOME_INPUT> = 0 ;Axis Home Input for axis 1
<AXIS_2_HOME_INPUT> = 0 ;Axis Home Input for axis 2
<AXIS_3_HOME_INPUT> = 0 ;Axis Home Input for axis 3
<AXIS_4_HOME_INPUT> = 0 ;Axis Home Input for axis 4
<AXIS_5_HOME_INPUT> = 0 ;Axis Home Input for axis 5
<AXIS_6_HOME_INPUT> = 0 ;Axis Home Input for axis 6
<AXIS_7_HOME_INPUT> = 0 ;Axis Home Input for axis 7
<AXIS_8_HOME_INPUT> = 0 ;Axis Home Input for axis 8

;-----------------------------------------------------------------------------------------
;										Setup
;-----------------------------------------------------------------------------------------
N10 ;Look for Paired Axes
#114 = #114 + 1
IF <MASTER_AXIS_1> != 0 && #[9550 + #114] != 0 THEN <SLAVE_AXIS_2> = #114
IF <MASTER_AXIS_1> != 0 && #[9550 + #114] != 0 THEN <MASTER_AXIS_2> = #[9550 + #114]
IF <MASTER_AXIS_1> == 0 && #[9550 + #114] != 0 THEN <SLAVE_AXIS_1> = #114
IF <MASTER_AXIS_1> == 0 && #[9550 + #114] != 0 THEN <MASTER_AXIS_1> = #[9550 + #114]
IF <MASTER_AXIS_1> != 0 && <MASTER_AXIS_2> != 0 THEN GOTO 20
IF #114 < 8 THEN GOTO 10 ;Continue Search

N20 ;Determine the Auto Squared Pair
<MASTER_AXIS> = ABS[<PARAM_AUTO_SQUARE_MASTER_AXIS>]
<SLAVE_AXIS> = ABS[<PARAM_AUTO_SQUARE_SLAVE_AXIS>]

;Determine the Auto Squared Home Inputs
<MASTER_INPUT> = ABS[<PARAM_AUTO_SQUARE_MASTER_HOME_INPUT>]
<SLAVE_INPUT> = ABS[<PARAM_AUTO_SQUARE_SLAVE_HOME_INPUT>]

IF <MASTER_INPUT> <= 50000 THEN <MASTER_INPUT> = <MASTER_INPUT> + 50000
IF <SLAVE_INPUT> <= 50000 THEN <SLAVE_INPUT> = <SLAVE_INPUT> + 50000

;Determine Master Axis Label
<MASTER_AXIS_LABEL> = #[20100 + <MASTER_AXIS>]

;Determine Axes Home Inputs
IF <SV_AXIS_1_HOME_PLUS>  != 0 && <SV_AXIS_1_HOME_PLUS>  <= 50000 THEN <AXIS_1_HOME_INPUT> = <SV_AXIS_1_HOME_PLUS> + 50000
IF <SV_AXIS_1_HOME_PLUS>  != 0 && <SV_AXIS_1_HOME_PLUS>  >  50000 THEN <AXIS_1_HOME_INPUT> = <SV_AXIS_1_HOME_PLUS>
IF <SV_AXIS_1_HOME_MINUS> != 0 && <SV_AXIS_1_HOME_MINUS> <= 50000 THEN <AXIS_1_HOME_INPUT> = <SV_AXIS_1_HOME_MINUS> + 50000
IF <SV_AXIS_1_HOME_MINUS> != 0 && <SV_AXIS_1_HOME_MINUS> >  50000 THEN <AXIS_1_HOME_INPUT> = <SV_AXIS_1_HOME_MINUS>

IF <SV_AXIS_2_HOME_PLUS>  != 0 && <SV_AXIS_2_HOME_PLUS>  <= 50000 THEN <AXIS_2_HOME_INPUT> = <SV_AXIS_2_HOME_PLUS> + 50000
IF <SV_AXIS_2_HOME_PLUS>  != 0 && <SV_AXIS_2_HOME_PLUS>  >  50000 THEN <AXIS_2_HOME_INPUT> = <SV_AXIS_2_HOME_PLUS>
IF <SV_AXIS_2_HOME_MINUS> != 0 && <SV_AXIS_2_HOME_MINUS> <= 50000 THEN <AXIS_2_HOME_INPUT> = <SV_AXIS_2_HOME_MINUS> + 50000
IF <SV_AXIS_2_HOME_MINUS> != 0 && <SV_AXIS_2_HOME_MINUS> >  50000 THEN <AXIS_2_HOME_INPUT> = <SV_AXIS_2_HOME_MINUS>

IF <SV_AXIS_3_HOME_PLUS>  != 0 && <SV_AXIS_3_HOME_PLUS>  <= 50000 THEN <AXIS_3_HOME_INPUT> = <SV_AXIS_3_HOME_PLUS> + 50000
IF <SV_AXIS_3_HOME_PLUS>  != 0 && <SV_AXIS_3_HOME_PLUS>  >  50000 THEN <AXIS_3_HOME_INPUT> = <SV_AXIS_3_HOME_PLUS>
IF <SV_AXIS_3_HOME_MINUS> != 0 && <SV_AXIS_3_HOME_MINUS> <= 50000 THEN <AXIS_3_HOME_INPUT> = <SV_AXIS_3_HOME_MINUS> + 50000
IF <SV_AXIS_3_HOME_MINUS> != 0 && <SV_AXIS_3_HOME_MINUS> >  50000 THEN <AXIS_3_HOME_INPUT> = <SV_AXIS_3_HOME_MINUS>

IF <SV_AXIS_4_HOME_PLUS>  != 0 && <SV_AXIS_4_HOME_PLUS>  <= 50000 THEN <AXIS_4_HOME_INPUT> = <SV_AXIS_4_HOME_PLUS> + 50000
IF <SV_AXIS_4_HOME_PLUS>  != 0 && <SV_AXIS_4_HOME_PLUS>  >  50000 THEN <AXIS_4_HOME_INPUT> = <SV_AXIS_4_HOME_PLUS>
IF <SV_AXIS_4_HOME_MINUS> != 0 && <SV_AXIS_4_HOME_MINUS> <= 50000 THEN <AXIS_4_HOME_INPUT> = <SV_AXIS_4_HOME_MINUS> + 50000
IF <SV_AXIS_4_HOME_MINUS> != 0 && <SV_AXIS_4_HOME_MINUS> >  50000 THEN <AXIS_4_HOME_INPUT> = <SV_AXIS_4_HOME_MINUS>

IF <SV_AXIS_5_HOME_PLUS>  != 0 && <SV_AXIS_5_HOME_PLUS>  <= 50000 THEN <AXIS_5_HOME_INPUT> = <SV_AXIS_5_HOME_PLUS> + 50000
IF <SV_AXIS_5_HOME_PLUS>  != 0 && <SV_AXIS_5_HOME_PLUS>  >  50000 THEN <AXIS_5_HOME_INPUT> = <SV_AXIS_5_HOME_PLUS>
IF <SV_AXIS_5_HOME_MINUS> != 0 && <SV_AXIS_5_HOME_MINUS> <= 50000 THEN <AXIS_5_HOME_INPUT> = <SV_AXIS_5_HOME_MINUS> + 50000
IF <SV_AXIS_5_HOME_MINUS> != 0 && <SV_AXIS_5_HOME_MINUS> >  50000 THEN <AXIS_5_HOME_INPUT> = <SV_AXIS_5_HOME_MINUS>

IF <SV_AXIS_6_HOME_PLUS>  != 0 && <SV_AXIS_6_HOME_PLUS>  <= 50000 THEN <AXIS_6_HOME_INPUT> = <SV_AXIS_6_HOME_PLUS> + 50000
IF <SV_AXIS_6_HOME_PLUS>  != 0 && <SV_AXIS_6_HOME_PLUS>  >  50000 THEN <AXIS_6_HOME_INPUT> = <SV_AXIS_6_HOME_PLUS>
IF <SV_AXIS_6_HOME_MINUS> != 0 && <SV_AXIS_6_HOME_MINUS> <= 50000 THEN <AXIS_6_HOME_INPUT> = <SV_AXIS_6_HOME_MINUS> + 50000
IF <SV_AXIS_6_HOME_MINUS> != 0 && <SV_AXIS_6_HOME_MINUS> >  50000 THEN <AXIS_6_HOME_INPUT> = <SV_AXIS_6_HOME_MINUS>

IF <SV_AXIS_7_HOME_PLUS>  != 0 && <SV_AXIS_7_HOME_PLUS>  <= 50000 THEN <AXIS_7_HOME_INPUT> = <SV_AXIS_7_HOME_PLUS> + 50000
IF <SV_AXIS_7_HOME_PLUS>  != 0 && <SV_AXIS_7_HOME_PLUS>  >  50000 THEN <AXIS_7_HOME_INPUT> = <SV_AXIS_7_HOME_PLUS>
IF <SV_AXIS_7_HOME_MINUS> != 0 && <SV_AXIS_7_HOME_MINUS> <= 50000 THEN <AXIS_7_HOME_INPUT> = <SV_AXIS_7_HOME_MINUS> + 50000
IF <SV_AXIS_7_HOME_MINUS> != 0 && <SV_AXIS_7_HOME_MINUS> >  50000 THEN <AXIS_7_HOME_INPUT> = <SV_AXIS_7_HOME_MINUS>

IF <SV_AXIS_8_HOME_PLUS>  != 0 && <SV_AXIS_8_HOME_PLUS>  <= 50000 THEN <AXIS_8_HOME_INPUT> = <SV_AXIS_8_HOME_PLUS> + 50000
IF <SV_AXIS_8_HOME_PLUS>  != 0 && <SV_AXIS_8_HOME_PLUS>  >  50000 THEN <AXIS_8_HOME_INPUT> = <SV_AXIS_8_HOME_PLUS>
IF <SV_AXIS_8_HOME_MINUS> != 0 && <SV_AXIS_8_HOME_MINUS> <= 50000 THEN <AXIS_8_HOME_INPUT> = <SV_AXIS_8_HOME_MINUS> + 50000
IF <SV_AXIS_8_HOME_MINUS> != 0 && <SV_AXIS_8_HOME_MINUS> <  50000 THEN <AXIS_8_HOME_INPUT> = <SV_AXIS_8_HOME_MINUS>

GOTO 110

;-----------------------------------------------------------------------------------------
;								Axes Home Tripped Checking
;-----------------------------------------------------------------------------------------
;Check to ensure Home switches are not tripped and only one home input is assigned.
N100

M225 #100 "Configuration errors were detected\nPress Cycle Cancel to Abort\nVerify Setup in Wizard"

GOTO 100

N110

;Check to Ensure Master and Slave Inputs exist.
IF <MASTER_AXIS> == 1 && <SV_AXIS_1_HOME_PLUS> == 0 && <SV_AXIS_1_HOME_MINUS> == 0 THEN M225 #100 "Master Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <MASTER_AXIS> == 2 && <SV_AXIS_2_HOME_PLUS> == 0 && <SV_AXIS_2_HOME_MINUS> == 0 THEN M225 #100 "Master Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <MASTER_AXIS> == 3 && <SV_AXIS_3_HOME_PLUS> == 0 && <SV_AXIS_3_HOME_MINUS> == 0 THEN M225 #100 "Master Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <MASTER_AXIS> == 4 && <SV_AXIS_4_HOME_PLUS> == 0 && <SV_AXIS_4_HOME_MINUS> == 0 THEN M225 #100 "Master Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <MASTER_AXIS> == 5 && <SV_AXIS_5_HOME_PLUS> == 0 && <SV_AXIS_5_HOME_MINUS> == 0 THEN M225 #100 "Master Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <MASTER_AXIS> == 6 && <SV_AXIS_6_HOME_PLUS> == 0 && <SV_AXIS_6_HOME_MINUS> == 0 THEN M225 #100 "Master Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <MASTER_AXIS> == 7 && <SV_AXIS_7_HOME_PLUS> == 0 && <SV_AXIS_7_HOME_MINUS> == 0 THEN M225 #100 "Master Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <MASTER_AXIS> == 8 && <SV_AXIS_8_HOME_PLUS> == 0 && <SV_AXIS_8_HOME_MINUS> == 0 THEN M225 #100 "Master Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <SLAVE_AXIS> == 1 && <SV_AXIS_1_HOME_PLUS> == 0 && <SV_AXIS_1_HOME_MINUS> == 0 THEN M225 #100 "Slave Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <SLAVE_AXIS> == 2 && <SV_AXIS_2_HOME_PLUS> == 0 && <SV_AXIS_2_HOME_MINUS> == 0 THEN M225 #100 "Slave Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <SLAVE_AXIS> == 3 && <SV_AXIS_3_HOME_PLUS> == 0 && <SV_AXIS_3_HOME_MINUS> == 0 THEN M225 #100 "Slave Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <SLAVE_AXIS> == 4 && <SV_AXIS_4_HOME_PLUS> == 0 && <SV_AXIS_4_HOME_MINUS> == 0 THEN M225 #100 "Slave Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <SLAVE_AXIS> == 5 && <SV_AXIS_5_HOME_PLUS> == 0 && <SV_AXIS_5_HOME_MINUS> == 0 THEN M225 #100 "Slave Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <SLAVE_AXIS> == 6 && <SV_AXIS_6_HOME_PLUS> == 0 && <SV_AXIS_6_HOME_MINUS> == 0 THEN M225 #100 "Slave Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <SLAVE_AXIS> == 7 && <SV_AXIS_7_HOME_PLUS> == 0 && <SV_AXIS_7_HOME_MINUS> == 0 THEN M225 #100 "Slave Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>
IF <SLAVE_AXIS> == 8 && <SV_AXIS_8_HOME_PLUS> == 0 && <SV_AXIS_8_HOME_MINUS> == 0 THEN M225 #100 "Slave Axis home direction not set on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <MASTER_AXIS_LABEL>

;Check to ensure only one home direction assigned
IF #50001
IF <SV_AXIS_1_HOME_PLUS> && <SV_AXIS_1_HOME_MINUS> THEN M225 #100 "Home switches set in both directions on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_1_LABEL>
IF <SV_AXIS_2_HOME_PLUS> && <SV_AXIS_2_HOME_MINUS> THEN M225 #100 "Home switches set in both directions on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_2_LABEL>
IF <SV_AXIS_3_HOME_PLUS> && <SV_AXIS_3_HOME_MINUS> THEN M225 #100 "Home switches set in both directions on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_3_LABEL>
IF <SV_AXIS_4_HOME_PLUS> && <SV_AXIS_4_HOME_MINUS> THEN M225 #100 "Home switches set in both directions on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_4_LABEL>
IF <SV_AXIS_5_HOME_PLUS> && <SV_AXIS_5_HOME_MINUS> THEN M225 #100 "Home switches set in both directions on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_5_LABEL>
IF <SV_AXIS_6_HOME_PLUS> && <SV_AXIS_6_HOME_MINUS> THEN M225 #100 "Home switches set in both directions on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_6_LABEL>
IF <SV_AXIS_7_HOME_PLUS> && <SV_AXIS_7_HOME_MINUS> THEN M225 #100 "Home switches set in both directions on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_7_LABEL>
IF <SV_AXIS_8_HOME_PLUS> && <SV_AXIS_8_HOME_MINUS> THEN M225 #100 "Home switches set in both directions on %c axis\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_8_LABEL>

;Check to ensure home switches are not tripped
N111
IF !<AXIS_1_HOME_INPUT> THEN GOTO 112
IF <AXIS_1_HOME_INPUT> && !#<AXIS_1_HOME_INPUT> THEN M225 #100 "%c AXIS HOME TRIPPED!\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_1_LABEL>
IF <AXIS_1_HOME_INPUT> && !#<AXIS_1_HOME_INPUT> THEN <HOME_SWITCH_TRIPPED> = 1

N112
IF !<AXIS_2_HOME_INPUT> THEN GOTO 113
IF <AXIS_2_HOME_INPUT> && !#<AXIS_2_HOME_INPUT> THEN M225 #100 "%c AXIS HOME TRIPPED!\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_2_LABEL>
IF <AXIS_2_HOME_INPUT> && !#<AXIS_2_HOME_INPUT> THEN <HOME_SWITCH_TRIPPED> = 1

N113
IF !<AXIS_3_HOME_INPUT> THEN GOTO 114
IF <AXIS_3_HOME_INPUT> && !#<AXIS_3_HOME_INPUT> THEN M225 #100 "%c AXIS HOME TRIPPED!\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_3_LABEL>
IF <AXIS_3_HOME_INPUT> && !#<AXIS_3_HOME_INPUT> THEN <HOME_SWITCH_TRIPPED> = 1

N114
IF !<AXIS_4_HOME_INPUT> THEN GOTO 115
IF <AXIS_4_HOME_INPUT> && !#<AXIS_4_HOME_INPUT> && <SLAVE_AXIS_1> != 4 THEN M225 #100 "%c AXIS HOME TRIPPED!\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_4_LABEL>
IF <AXIS_4_HOME_INPUT> && !#<AXIS_4_HOME_INPUT> && <SLAVE_AXIS_1> == 4 THEN M225 #100 "AXIS 4 HOME TRIPPED!\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort"
IF <AXIS_4_HOME_INPUT> && !#<AXIS_4_HOME_INPUT> THEN <HOME_SWITCH_TRIPPED> = 1

N115
IF !<AXIS_5_HOME_INPUT> THEN GOTO 116
IF <AXIS_5_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> && <SLAVE_AXIS_2> != 5 THEN M225 #100 "%c AXIS HOME TRIPPED!\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_5_LABEL>
IF <AXIS_5_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> && <SLAVE_AXIS_2> == 5 THEN M225 #100 "AXIS 5 HOME TRIPPED!\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort"
IF <AXIS_5_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN <HOME_SWITCH_TRIPPED> = 1

N116
IF !<AXIS_6_HOME_INPUT> THEN GOTO 117
IF <AXIS_6_HOME_INPUT> && !#<AXIS_6_HOME_INPUT> THEN M225 #100 "%c AXIS HOME TRIPPED!\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_6_LABEL>
IF <AXIS_6_HOME_INPUT> && !#<AXIS_6_HOME_INPUT> THEN <HOME_SWITCH_TRIPPED> = 1

N117
IF !<AXIS_7_HOME_INPUT> THEN GOTO 118
IF <AXIS_7_HOME_INPUT> && !#<AXIS_7_HOME_INPUT> THEN M225 #100 "%c AXIS HOME TRIPPED!\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_7_LABEL>
IF <AXIS_7_HOME_INPUT> && !#<AXIS_7_HOME_INPUT> THEN <HOME_SWITCH_TRIPPED> = 1

N118
IF !<AXIS_8_HOME_INPUT> THEN GOTO 120
IF <AXIS_8_HOME_INPUT> && !#<AXIS_8_HOME_INPUT> THEN M225 #100 "%c AXIS HOME TRIPPED!\nPress Cycle Start to continue configuration check.\nPress Cycle Cancel to abort" <SV_AXIS_8_LABEL>
IF <AXIS_8_HOME_INPUT> && !#<AXIS_8_HOME_INPUT> THEN <HOME_SWITCH_TRIPPED> = 1

N120;Prevent moving pass this point if the above errors were detected
IF <MASTER_AXIS> == 1 && <SV_AXIS_1_HOME_PLUS> == 0 && <SV_AXIS_1_HOME_MINUS> == 0 THEN GOTO 100
IF <MASTER_AXIS> == 2 && <SV_AXIS_2_HOME_PLUS> == 0 && <SV_AXIS_2_HOME_MINUS> == 0 THEN GOTO 100
IF <MASTER_AXIS> == 3 && <SV_AXIS_3_HOME_PLUS> == 0 && <SV_AXIS_3_HOME_MINUS> == 0 THEN GOTO 100
IF <MASTER_AXIS> == 4 && <SV_AXIS_4_HOME_PLUS> == 0 && <SV_AXIS_4_HOME_MINUS> == 0 THEN GOTO 100
IF <MASTER_AXIS> == 5 && <SV_AXIS_5_HOME_PLUS> == 0 && <SV_AXIS_5_HOME_MINUS> == 0 THEN GOTO 100
IF <MASTER_AXIS> == 6 && <SV_AXIS_6_HOME_PLUS> == 0 && <SV_AXIS_6_HOME_MINUS> == 0 THEN GOTO 100
IF <MASTER_AXIS> == 7 && <SV_AXIS_7_HOME_PLUS> == 0 && <SV_AXIS_7_HOME_MINUS> == 0 THEN GOTO 100
IF <MASTER_AXIS> == 8 && <SV_AXIS_8_HOME_PLUS> == 0 && <SV_AXIS_8_HOME_MINUS> == 0 THEN GOTO 100
IF <SLAVE_AXIS> == 1 && <SV_AXIS_1_HOME_PLUS> == 0 && <SV_AXIS_1_HOME_MINUS> == 0 THEN GOTO 100
IF <SLAVE_AXIS> == 2 && <SV_AXIS_2_HOME_PLUS> == 0 && <SV_AXIS_2_HOME_MINUS> == 0 THEN GOTO 100
IF <SLAVE_AXIS> == 3 && <SV_AXIS_3_HOME_PLUS> == 0 && <SV_AXIS_3_HOME_MINUS> == 0 THEN GOTO 100
IF <SLAVE_AXIS> == 4 && <SV_AXIS_4_HOME_PLUS> == 0 && <SV_AXIS_4_HOME_MINUS> == 0 THEN GOTO 100
IF <SLAVE_AXIS> == 5 && <SV_AXIS_5_HOME_PLUS> == 0 && <SV_AXIS_5_HOME_MINUS> == 0 THEN GOTO 100
IF <SLAVE_AXIS> == 6 && <SV_AXIS_6_HOME_PLUS> == 0 && <SV_AXIS_6_HOME_MINUS> == 0 THEN GOTO 100
IF <SLAVE_AXIS> == 7 && <SV_AXIS_7_HOME_PLUS> == 0 && <SV_AXIS_7_HOME_MINUS> == 0 THEN GOTO 100
IF <SLAVE_AXIS> == 8 && <SV_AXIS_8_HOME_PLUS> == 0 && <SV_AXIS_8_HOME_MINUS> == 0 THEN GOTO 100
IF <SV_AXIS_1_HOME_PLUS> && <SV_AXIS_1_HOME_MINUS> THEN GOTO 100
IF <SV_AXIS_2_HOME_PLUS> && <SV_AXIS_2_HOME_MINUS> THEN GOTO 100
IF <SV_AXIS_3_HOME_PLUS> && <SV_AXIS_3_HOME_MINUS> THEN GOTO 100
IF <SV_AXIS_4_HOME_PLUS> && <SV_AXIS_4_HOME_MINUS> THEN GOTO 100
IF <SV_AXIS_5_HOME_PLUS> && <SV_AXIS_5_HOME_MINUS> THEN GOTO 100
IF <SV_AXIS_6_HOME_PLUS> && <SV_AXIS_6_HOME_MINUS> THEN GOTO 100
IF <SV_AXIS_7_HOME_PLUS> && <SV_AXIS_7_HOME_MINUS> THEN GOTO 100
IF <SV_AXIS_8_HOME_PLUS> && <SV_AXIS_8_HOME_MINUS> THEN GOTO 100
IF <HOME_SWITCH_TRIPPED> != 0 THEN GOTO 100

M94 /105 ;Disable Limit for HomeLimitAll

;-----------------------------------------------------------------------------------------
;								     Home Third Axis
;-----------------------------------------------------------------------------------------
;Home the 3rd Axis (Assumes 3rd Axis is Z)
N200
;Skip 3rd Axis Homing if Home Input not assigned
IF !<AXIS_3_HOME_INPUT> THEN GOTO 300

;Check to see if 3rd axis is paired
IF <MASTER_AXIS_1> != 3 && <MASTER_AXIS_2> != 3 && <AXIS_3_HOME_INPUT> THEN M221 #100 "Homing %c axis" <SV_AXIS_3_LABEL> ELSE GOTO 210

;Not Paired 3rd Axis Homing
IF <SV_AXIS_3_HOME_PLUS> THEN M92 /$<SV_AXIS_3_LABEL> L1   ;Move to 3rd axis + home switch
IF <SV_AXIS_3_HOME_MINUS> THEN M91 /$<SV_AXIS_3_LABEL> L1  ;Move to 3rd axis - home switch

GOTO 300

;Paired 3rd Axis Homing
N210

;Ensure Axis is Paired
M225 #101 "Ensuring %c axis is paired..." <SV_AXIS_3_LABEL>
IF #50001
M295 /$<SV_AXIS_3_LABEL>
M225 #101 "%c axis paired successfully." <SV_AXIS_3_LABEL>

;Skip To AutoSquare Homing if 3rd Axis is AutoSquare.
IF <MASTER_AXIS> == 3 THEN GOTO 500

;Home Non-AutoSquare Paired Axis to Master Switch
M221 #100 "Homing %c axis" <SV_AXIS_3_LABEL>
IF <SV_AXIS_3_HOME_PLUS> THEN M92 /$<SV_AXIS_3_LABEL> L1
IF <SV_AXIS_3_HOME_MINUS> THEN M91 /$<SV_AXIS_3_LABEL> L1
M225 #101 "%c axis homed successfully" <SV_AXIS_3_LABEL>

;-----------------------------------------------------------------------------------------
;							     Independent Axis Homing
;-----------------------------------------------------------------------------------------
;Home all Indepedent Axes
N300

IF <MASTER_AXIS_1> != 1 && <MASTER_AXIS_2> != 1 && <AXIS_1_HOME_INPUT> THEN M221 #100 "Homing %c axis" <SV_AXIS_1_LABEL> ELSE GOTO 310
IF <SV_AXIS_1_HOME_PLUS> THEN M92 /$<SV_AXIS_1_LABEL> L1
IF <SV_AXIS_1_HOME_MINUS> THEN M91 /$<SV_AXIS_1_LABEL> L1

N310
IF <MASTER_AXIS_1> != 2 && <MASTER_AXIS_2> != 2 && <AXIS_2_HOME_INPUT> THEN M221 #100 "Homing %c axis" <SV_AXIS_2_LABEL> ELSE GOTO 320
IF <SV_AXIS_2_HOME_PLUS> THEN M92 /$<SV_AXIS_2_LABEL> L1
IF <SV_AXIS_2_HOME_MINUS> THEN M91 /$<SV_AXIS_2_LABEL> L1

N320
IF <MASTER_AXIS_2> != 4 && <SLAVE_AXIS_1> != 4 && <AXIS_4_HOME_INPUT> THEN M221 #100 "Homing %c axis" <SV_AXIS_4_LABEL> ELSE GOTO 330
IF <SV_AXIS_4_HOME_PLUS> THEN M92 /$<SV_AXIS_4_LABEL> L1
IF <SV_AXIS_4_HOME_MINUS> THEN M91 /$<SV_AXIS_4_LABEL> L1

N330
IF <SLAVE_AXIS_2> != 5 && <AXIS_5_HOME_INPUT> THEN M221 #100 "Homing %c axis" <SV_AXIS_5_LABEL> ELSE GOTO 340
IF <SV_AXIS_5_HOME_PLUS> THEN M92 /$<SV_AXIS_5_LABEL> L1
IF <SV_AXIS_5_HOME_MINUS> THEN M91 /$<SV_AXIS_5_LABEL> L1

N340
IF <AXIS_6_HOME_INPUT> THEN M221 #100 "Homing %c axis" <SV_AXIS_6_LABEL> ELSE GOTO 350
IF <SV_AXIS_6_HOME_PLUS> THEN M92 /$<SV_AXIS_6_LABEL> L1
IF <SV_AXIS_6_HOME_MINUS> THEN M91 /$<SV_AXIS_6_LABEL> L1

N350
IF <AXIS_7_HOME_INPUT> THEN M225 #101 "Homing %c axis" <SV_AXIS_7_LABEL> ELSE GOTO 360
IF <SV_AXIS_7_HOME_PLUS> THEN M92 /$<SV_AXIS_7_LABEL> L1
IF <SV_AXIS_7_HOME_MINUS> THEN M91 /$<SV_AXIS_7_LABEL> L1

N360
IF <AXIS_8_HOME_INPUT> THEN M225 #101 "Homing %c axis" <SV_AXIS_8_LABEL> ELSE GOTO 400
IF <SV_AXIS_8_HOME_PLUS> THEN M92 /$<SV_AXIS_8_LABEL> L1
IF <SV_AXIS_8_HOME_MINUS> THEN M91 /$<SV_AXIS_8_LABEL> L1

;-----------------------------------------------------------------------------------------
;							        Paired Axis Homing
;-----------------------------------------------------------------------------------------
;Home Non-Square Paired Axes
N400
M225 #101 "Ensuring axes are paired..."
IF #50001
IF <MASTER_AXIS_1> != 0 THEN M295 /$#[20100 + <MASTER_AXIS_1>]
IF <MASTER_AXIS_2> != 0 THEN M295 /$#[20100 + <MASTER_AXIS_2>]
M225 #101 "Axes paired successfully"

;Check if Axis 1 is Master Axis 1
IF <MASTER_AXIS_1> == 1 && <MASTER_AXIS> != 1 && [<AXIS_1_HOME_INPUT> || <AXIS_4_HOME_INPUT>] THEN M221 #100 "Homing %c axis" <SV_AXIS_1_LABEL> ELSE GOTO 410
IF <AXIS_1_HOME_INPUT> && <AXIS_4_HOME_INPUT> THEN GOTO 401 ;Skip homing off master switch if both axes have home switches
IF <SV_AXIS_1_HOME_PLUS>  THEN M92 /$<SV_AXIS_1_LABEL> L1
IF <SV_AXIS_1_HOME_MINUS> THEN M91 /$<SV_AXIS_1_LABEL> L1
GOTO 410

N401 ;Dual Switch Homing
IF <SV_AXIS_1_HOME_PLUS>  && <SV_AXIS_4_HOME_PLUS>  THEN M106 /$<SV_AXIS_1_LABEL> P<AXIS_1_HOME_INPUT> Q<AXIS_4_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <SV_AXIS_4_HOME_MINUS> THEN M105 /$<SV_AXIS_1_LABEL> P<AXIS_1_HOME_INPUT> Q<AXIS_4_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>

;Clear Switch Based on Input
IF <SV_AXIS_1_HOME_PLUS>  && <SV_AXIS_4_HOME_PLUS>  && !#<AXIS_1_HOME_INPUT> && !#<AXIS_4_HOME_INPUT> THEN M105 /$<SV_AXIS_1_LABEL> P-<AXIS_1_HOME_INPUT> Q-<AXIS_4_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_PLUS>  && <SV_AXIS_4_HOME_PLUS>  && !#<AXIS_1_HOME_INPUT> &&  #<AXIS_4_HOME_INPUT> THEN M105 /$<SV_AXIS_1_LABEL> P-<AXIS_1_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_PLUS>  && <SV_AXIS_4_HOME_PLUS>  &&  #<AXIS_1_HOME_INPUT> && !#<AXIS_4_HOME_INPUT> THEN M105 /$<SV_AXIS_1_LABEL> P-<AXIS_4_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <SV_AXIS_4_HOME_MINUS> && !#<AXIS_1_HOME_INPUT> && !#<AXIS_4_HOME_INPUT> THEN M106 /$<SV_AXIS_1_LABEL> P-<AXIS_1_HOME_INPUT> Q-<AXIS_4_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <SV_AXIS_4_HOME_MINUS> && !#<AXIS_1_HOME_INPUT> &&  #<AXIS_4_HOME_INPUT> THEN M106 /$<SV_AXIS_1_LABEL> P-<AXIS_1_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <SV_AXIS_4_HOME_MINUS> &&  #<AXIS_1_HOME_INPUT> && !#<AXIS_4_HOME_INPUT> THEN M106 /$<SV_AXIS_1_LABEL> P-<AXIS_4_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>

N410 ;Check if Axis 1 is Master Axis 2
IF <MASTER_AXIS_2> == 1 && <MASTER_AXIS> != 1 && [<AXIS_1_HOME_INPUT> || <AXIS_5_HOME_INPUT>] THEN M221 #100 "Homing %c axis" <SV_AXIS_1_LABEL> ELSE GOTO 420
IF <AXIS_1_HOME_INPUT> && <AXIS_5_HOME_INPUT> THEN GOTO 411 ;Skip homing off master switch if both axes have home switches
IF <SV_AXIS_1_HOME_PLUS>  THEN M92 /$<SV_AXIS_1_LABEL> L1
IF <SV_AXIS_1_HOME_MINUS> THEN M91 /$<SV_AXIS_1_LABEL> L1
GOTO 420

N411 ;Dual Switch Homing
IF <SV_AXIS_1_HOME_PLUS>  && <SV_AXIS_5_HOME_PLUS>  THEN M106 /$<SV_AXIS_1_LABEL> P<AXIS_1_HOME_INPUT> Q<AXIS_5_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <SV_AXIS_5_HOME_MINUS> THEN M105 /$<SV_AXIS_1_LABEL> P<AXIS_1_HOME_INPUT> Q<AXIS_5_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>

;Clear Switch Based on Input
IF <SV_AXIS_1_HOME_PLUS>  && <SV_AXIS_5_HOME_PLUS>  && !#<AXIS_1_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN M105 /$<SV_AXIS_1_LABEL> P-<AXIS_1_HOME_INPUT> Q-<AXIS_5_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_PLUS>  && <SV_AXIS_5_HOME_PLUS>  && !#<AXIS_1_HOME_INPUT> &&  #<AXIS_5_HOME_INPUT> THEN M105 /$<SV_AXIS_1_LABEL> P-<AXIS_1_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_PLUS>  && <SV_AXIS_5_HOME_PLUS>  &&  #<AXIS_1_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN M105 /$<SV_AXIS_1_LABEL> P-<AXIS_5_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <SV_AXIS_5_HOME_MINUS> && !#<AXIS_1_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN M106 /$<SV_AXIS_1_LABEL> P-<AXIS_1_HOME_INPUT> Q-<AXIS_5_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <SV_AXIS_5_HOME_MINUS> && !#<AXIS_1_HOME_INPUT> &&  #<AXIS_5_HOME_INPUT> THEN M106 /$<SV_AXIS_1_LABEL> P-<AXIS_1_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <SV_AXIS_5_HOME_MINUS> &&  #<AXIS_1_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN M106 /$<SV_AXIS_1_LABEL> P-<AXIS_5_HOME_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>

N420 ;Check if Axis 2 is Master Axis 1
IF <MASTER_AXIS_1> == 2 && <MASTER_AXIS> != 2 && [<AXIS_2_HOME_INPUT> || <AXIS_4_HOME_INPUT>] THEN M221 #100 "Homing %c axis" <SV_AXIS_2_LABEL> ELSE GOTO 430
IF <AXIS_2_HOME_INPUT> && <AXIS_4_HOME_INPUT> THEN GOTO 421 ;Skip homing off master switch if both axes have home switches
IF <SV_AXIS_2_HOME_PLUS>  THEN M92 /$<SV_AXIS_2_LABEL> L1
IF <SV_AXIS_2_HOME_MINUS> THEN M91 /$<SV_AXIS_2_LABEL> L1
GOTO 430

N421 ;Dual Switch Homing
IF <SV_AXIS_2_HOME_PLUS>  && <SV_AXIS_4_HOME_PLUS>  THEN M106 /$<SV_AXIS_2_LABEL> P<AXIS_2_HOME_INPUT> Q<AXIS_4_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <SV_AXIS_4_HOME_MINUS> THEN M105 /$<SV_AXIS_2_LABEL> P<AXIS_2_HOME_INPUT> Q<AXIS_4_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>

;Clear Switch Based on Input
IF <SV_AXIS_2_HOME_PLUS>  && <SV_AXIS_4_HOME_PLUS>  && !#<AXIS_2_HOME_INPUT> && !#<AXIS_4_HOME_INPUT> THEN M105 /$<SV_AXIS_2_LABEL> P-<AXIS_2_HOME_INPUT> Q-<AXIS_4_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_PLUS>  && <SV_AXIS_4_HOME_PLUS>  && !#<AXIS_2_HOME_INPUT> &&  #<AXIS_4_HOME_INPUT> THEN M105 /$<SV_AXIS_2_LABEL> P-<AXIS_2_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_PLUS>  && <SV_AXIS_4_HOME_PLUS>  &&  #<AXIS_2_HOME_INPUT> && !#<AXIS_4_HOME_INPUT> THEN M105 /$<SV_AXIS_2_LABEL> P-<AXIS_4_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <SV_AXIS_4_HOME_MINUS> && !#<AXIS_2_HOME_INPUT> && !#<AXIS_4_HOME_INPUT> THEN M106 /$<SV_AXIS_2_LABEL> P-<AXIS_2_HOME_INPUT> Q-<AXIS_4_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <SV_AXIS_4_HOME_MINUS> && !#<AXIS_2_HOME_INPUT> &&  #<AXIS_4_HOME_INPUT> THEN M106 /$<SV_AXIS_2_LABEL> P-<AXIS_2_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <SV_AXIS_4_HOME_MINUS> &&  #<AXIS_2_HOME_INPUT> && !#<AXIS_4_HOME_INPUT> THEN M106 /$<SV_AXIS_2_LABEL> P-<AXIS_4_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>

N430 ;Check if Axis 2 is Master Axis 2
IF <MASTER_AXIS_2> == 2 && <MASTER_AXIS> != 2 && [<AXIS_2_HOME_INPUT> || <AXIS_5_HOME_INPUT>] THEN M221 #100 "Homing %c axis" <SV_AXIS_2_LABEL> ELSE GOTO 440
IF <AXIS_2_HOME_INPUT> && <AXIS_5_HOME_INPUT> THEN GOTO 431 ;Skip homing off master switch if both axes have home switches
IF <SV_AXIS_2_HOME_PLUS>  THEN M92 /$<SV_AXIS_2_LABEL> L1
IF <SV_AXIS_2_HOME_MINUS> THEN M91 /$<SV_AXIS_2_LABEL> L1
GOTO 440

N431 ;Dual Switch Homing
IF <SV_AXIS_2_HOME_PLUS>  && <SV_AXIS_5_HOME_PLUS>  THEN M106 /$<SV_AXIS_2_LABEL> P<AXIS_2_HOME_INPUT> Q<AXIS_5_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <SV_AXIS_5_HOME_MINUS> THEN M105 /$<SV_AXIS_2_LABEL> P<AXIS_2_HOME_INPUT> Q<AXIS_5_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>

;Clear Switch Based on Input
IF <SV_AXIS_2_HOME_PLUS>  && <SV_AXIS_5_HOME_PLUS>  && !#<AXIS_2_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN M105 /$<SV_AXIS_2_LABEL> P-<AXIS_2_HOME_INPUT> Q-<AXIS_5_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_PLUS>  && <SV_AXIS_5_HOME_PLUS>  && !#<AXIS_2_HOME_INPUT> &&  #<AXIS_5_HOME_INPUT> THEN M105 /$<SV_AXIS_2_LABEL> P-<AXIS_2_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_PLUS>  && <SV_AXIS_5_HOME_PLUS>  &&  #<AXIS_2_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN M105 /$<SV_AXIS_2_LABEL> P-<AXIS_5_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <SV_AXIS_5_HOME_MINUS> && !#<AXIS_2_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN M106 /$<SV_AXIS_2_LABEL> P-<AXIS_2_HOME_INPUT> Q-<AXIS_5_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <SV_AXIS_5_HOME_MINUS> && !#<AXIS_2_HOME_INPUT> &&  #<AXIS_5_HOME_INPUT> THEN M106 /$<SV_AXIS_2_LABEL> P-<AXIS_2_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <SV_AXIS_5_HOME_MINUS> &&  #<AXIS_2_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN M106 /$<SV_AXIS_2_LABEL> P-<AXIS_5_HOME_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>

N440 ;Check if Axis 4 is Master Axis 2
IF <MASTER_AXIS_2> == 4 && <MASTER_AXIS> != 4 && [<AXIS_4_HOME_INPUT> || <AXIS_5_HOME_INPUT>] THEN M221 #100 "Homing %c axis" <SV_AXIS_4_LABEL> ELSE GOTO 450
IF <AXIS_4_HOME_INPUT> && <AXIS_5_HOME_INPUT> THEN GOTO 441 ;Skip homing off master switch if both axes have home switches
IF <SV_AXIS_4_HOME_PLUS>  THEN M92 /$<SV_AXIS_4_LABEL> L1
IF <SV_AXIS_4_HOME_MINUS> THEN M91 /$<SV_AXIS_4_LABEL> L1
GOTO 450

N441 ;Dual Switch Homing
IF <SV_AXIS_4_HOME_PLUS>  && <SV_AXIS_5_HOME_PLUS>  THEN M106 /$<SV_AXIS_2_LABEL> P<AXIS_4_HOME_INPUT> Q<AXIS_5_HOME_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_MINUS> && <SV_AXIS_5_HOME_MINUS> THEN M105 /$<SV_AXIS_2_LABEL> P<AXIS_4_HOME_INPUT> Q<AXIS_5_HOME_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>

;Clear Switch Based on Input
IF <SV_AXIS_4_HOME_PLUS>  && <SV_AXIS_5_HOME_PLUS>  && !#<AXIS_4_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN M105 /$<SV_AXIS_4_LABEL> P-<AXIS_4_HOME_INPUT> Q-<AXIS_5_HOME_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_PLUS>  && <SV_AXIS_5_HOME_PLUS>  && !#<AXIS_4_HOME_INPUT> &&  #<AXIS_5_HOME_INPUT> THEN M105 /$<SV_AXIS_4_LABEL> P-<AXIS_4_HOME_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_PLUS>  && <SV_AXIS_5_HOME_PLUS>  &&  #<AXIS_4_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN M105 /$<SV_AXIS_4_LABEL> P-<AXIS_5_HOME_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_MINUS> && <SV_AXIS_5_HOME_MINUS> && !#<AXIS_4_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN M106 /$<SV_AXIS_4_LABEL> P-<AXIS_4_HOME_INPUT> Q-<AXIS_5_HOME_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_MINUS> && <SV_AXIS_5_HOME_MINUS> && !#<AXIS_4_HOME_INPUT> &&  #<AXIS_5_HOME_INPUT> THEN M106 /$<SV_AXIS_4_LABEL> P-<AXIS_4_HOME_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_MINUS> && <SV_AXIS_5_HOME_MINUS> &&  #<AXIS_4_HOME_INPUT> && !#<AXIS_5_HOME_INPUT> THEN M106 /$<SV_AXIS_4_LABEL> P-<AXIS_5_HOME_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>

N450
;Skip Auto Square Paired Axis if 3rd Axis is AutoSquare
; This is skipped at this point as it should of been done already.
IF <MASTER_AXIS> == 3 THEN GOTO 600

;-----------------------------------------------------------------------------------------
;							  Auto Square Paired Axis Homing
;-----------------------------------------------------------------------------------------
N500
IF #50001
IF <AUTOSQUARE_ATTEMPTS> >= 10 THEN M225 #100 "Master Switch is tripped first!\nPlease re-configure machine to trip the slave first and try again.\n\nPress ESC or Cycle Cancel to abort."
IF <AUTOSQUARE_ATTEMPTS> >= 10 THEN GOTO 500

M221 #100 "Moving %c Paired Axes until slave switch is tripped" <MASTER_AXIS_LABEL>

;Move Until either Master or Slave input is Open
IF <SV_AXIS_1_HOME_PLUS>  && <MASTER_AXIS> == 1 THEN M106 /$<SV_AXIS_1_LABEL> P<MASTER_INPUT> Q<SLAVE_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <MASTER_AXIS> == 1 THEN M105 /$<SV_AXIS_1_LABEL> P<MASTER_INPUT> Q<SLAVE_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_PLUS>  && <MASTER_AXIS> == 2 THEN M106 /$<SV_AXIS_2_LABEL> P<MASTER_INPUT> Q<SLAVE_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <MASTER_AXIS> == 2 THEN M105 /$<SV_AXIS_2_LABEL> P<MASTER_INPUT> Q<SLAVE_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_3_HOME_PLUS>  && <MASTER_AXIS> == 3 THEN M106 /$<SV_AXIS_3_LABEL> P<MASTER_INPUT> Q<SLAVE_INPUT> F<SV_AXIS_3_HOME_FEEDRATE>
IF <SV_AXIS_3_HOME_MINUS> && <MASTER_AXIS> == 3 THEN M105 /$<SV_AXIS_3_LABEL> P<MASTER_INPUT> Q<SLAVE_INPUT> F<SV_AXIS_3_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_PLUS>  && <MASTER_AXIS> == 4 THEN M106 /$<SV_AXIS_4_LABEL> P<MASTER_INPUT> Q<SLAVE_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_MINUS> && <MASTER_AXIS> == 4 THEN M105 /$<SV_AXIS_4_LABEL> P<MASTER_INPUT> Q<SLAVE_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>

N510 ;Determine which Switch Tripped
;When Master is tripped and not slave, we will begin a routine to try to "nudge" gantry to hit slave first.
; this process will fail after 10 tries.
;When Slave is tripped, we continue normally.
IF !#<SLAVE_INPUT> THEN GOTO 520 ELSE GOTO 530

N520 ;Move off Slave Switch
M221 #100 "Moving %c Paired Axes until slave switch is un-tripped" <MASTER_AXIS_LABEL>
IF <SV_AXIS_1_HOME_PLUS>  && <MASTER_AXIS> == 1 THEN M105 /$<SV_AXIS_1_LABEL> P-<SLAVE_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <MASTER_AXIS> == 1 THEN M106 /$<SV_AXIS_1_LABEL> P-<SLAVE_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_PLUS>  && <MASTER_AXIS> == 2 THEN M105 /$<SV_AXIS_2_LABEL> P-<SLAVE_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <MASTER_AXIS> == 2 THEN M106 /$<SV_AXIS_2_LABEL> P-<SLAVE_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_3_HOME_PLUS>  && <MASTER_AXIS> == 3 THEN M105 /$<SV_AXIS_3_LABEL> P-<SLAVE_INPUT> F<SV_AXIS_3_HOME_FEEDRATE>
IF <SV_AXIS_3_HOME_MINUS> && <MASTER_AXIS> == 3 THEN M106 /$<SV_AXIS_3_LABEL> P-<SLAVE_INPUT> F<SV_AXIS_3_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_PLUS>  && <MASTER_AXIS> == 4 THEN M105 /$<SV_AXIS_4_LABEL> P-<SLAVE_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_MINUS> && <MASTER_AXIS> == 4 THEN M106 /$<SV_AXIS_4_LABEL> P-<SLAVE_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>

;Set that Slave has been Homed off Switch Flag
#113 = 1

N530 ;Unpair Axis and Move Master off Switch if Needed
IF #50001
M294 /$<MASTER_AXIS_LABEL>
M225 #101 "Un-pairing %c axis" <MASTER_AXIS_LABEL>

;If Master is not tripped, Proceed normally with moving to switch
; otherwise move off switch for "nudge routine"
IF #<MASTER_INPUT> && #113 == 1 THEN GOTO 540

;Move Master Off Switch
IF <AUTOSQUARE_ATTEMPTS> == 0 THEN M225 #101 "Master Switch Tripped First!\nAttempting Automatic Square Routine until slave trips first!"
M221 #100 "Moving Master %c Axis until master switch is un-tripped" <MASTER_AXIS_LABEL>
IF <SV_AXIS_1_HOME_PLUS>  && <MASTER_AXIS> == 1 THEN M105 /$<SV_AXIS_1_LABEL> P-<MASTER_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <MASTER_AXIS> == 1 THEN M106 /$<SV_AXIS_1_LABEL> P-<MASTER_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_PLUS>  && <MASTER_AXIS> == 2 THEN M105 /$<SV_AXIS_2_LABEL> P-<MASTER_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <MASTER_AXIS> == 2 THEN M106 /$<SV_AXIS_2_LABEL> P-<MASTER_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_3_HOME_PLUS>  && <MASTER_AXIS> == 3 THEN M105 /$<SV_AXIS_3_LABEL> P-<MASTER_INPUT> F<SV_AXIS_3_HOME_FEEDRATE>
IF <SV_AXIS_3_HOME_MINUS> && <MASTER_AXIS> == 3 THEN M106 /$<SV_AXIS_3_LABEL> P-<MASTER_INPUT> F<SV_AXIS_3_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_PLUS>  && <MASTER_AXIS> == 4 THEN M105 /$<SV_AXIS_4_LABEL> P-<MASTER_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_MINUS> && <MASTER_AXIS> == 4 THEN M106 /$<SV_AXIS_4_LABEL> P-<MASTER_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>

;Re-pair axis to continue AutoSquare
IF #50001
M295 /$<MASTER_AXIS_LABEL>
M225 #101 "Re-pairing %c Axis" <MASTER_AXIS_LABEL>

IF #50001
<AUTOSQUARE_ATTEMPTS> = <AUTOSQUARE_ATTEMPTS> + 1

GOTO 500 ;Repeat Cycle Until slave hits first.

N540 ;Move Master until Master input is open
M221 #100 "Moving Master %c Axis until master switch is tripped" <MASTER_AXIS_LABEL>
IF <SV_AXIS_1_HOME_PLUS>  && <MASTER_AXIS> == 1 THEN M106 /$<SV_AXIS_1_LABEL> P<MASTER_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <MASTER_AXIS> == 1 THEN M105 /$<SV_AXIS_1_LABEL> P<MASTER_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_PLUS>  && <MASTER_AXIS> == 2 THEN M106 /$<SV_AXIS_2_LABEL> P<MASTER_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <MASTER_AXIS> == 2 THEN M105 /$<SV_AXIS_2_LABEL> P<MASTER_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_3_HOME_PLUS>  && <MASTER_AXIS> == 3 THEN M106 /$<SV_AXIS_3_LABEL> P<MASTER_INPUT> F<SV_AXIS_3_HOME_FEEDRATE>
IF <SV_AXIS_3_HOME_MINUS> && <MASTER_AXIS> == 3 THEN M105 /$<SV_AXIS_3_LABEL> P<MASTER_INPUT> F<SV_AXIS_3_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_PLUS>  && <MASTER_AXIS> == 4 THEN M106 /$<SV_AXIS_4_LABEL> P<MASTER_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_MINUS> && <MASTER_AXIS> == 4 THEN M105 /$<SV_AXIS_4_LABEL> P<MASTER_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>

N550 ;Move Master Off Switch
M221 #100 "Moving Master %c Axis until master switch is un-tripped" <MASTER_AXIS_LABEL>
IF <SV_AXIS_1_HOME_PLUS>  && <MASTER_AXIS> == 1 THEN M105 /$<SV_AXIS_1_LABEL> P-<MASTER_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_1_HOME_MINUS> && <MASTER_AXIS> == 1 THEN M106 /$<SV_AXIS_1_LABEL> P-<MASTER_INPUT> F<SV_AXIS_1_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_PLUS>  && <MASTER_AXIS> == 2 THEN M105 /$<SV_AXIS_2_LABEL> P-<MASTER_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_2_HOME_MINUS> && <MASTER_AXIS> == 2 THEN M106 /$<SV_AXIS_2_LABEL> P-<MASTER_INPUT> F<SV_AXIS_2_HOME_FEEDRATE>
IF <SV_AXIS_3_HOME_PLUS>  && <MASTER_AXIS> == 3 THEN M105 /$<SV_AXIS_3_LABEL> P-<MASTER_INPUT> F<SV_AXIS_3_HOME_FEEDRATE>
IF <SV_AXIS_3_HOME_MINUS> && <MASTER_AXIS> == 3 THEN M106 /$<SV_AXIS_3_LABEL> P-<MASTER_INPUT> F<SV_AXIS_3_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_PLUS>  && <MASTER_AXIS> == 4 THEN M105 /$<SV_AXIS_4_LABEL> P-<MASTER_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>
IF <SV_AXIS_4_HOME_MINUS> && <MASTER_AXIS> == 4 THEN M106 /$<SV_AXIS_4_LABEL> P-<MASTER_INPUT> F<SV_AXIS_4_HOME_FEEDRATE>

N560 ;Move Master Axis back to Square Position

;Home Master
;This allows following AutoSquare G1 moves if it is "behind" the travel limits on a re-home.
M26 /$<MASTER_AXIS_LABEL>

;Move Master back
M221 #100 "Moving Master %c Axis back to square position" <MASTER_AXIS_LABEL>
IF <MASTER_AXIS> == 1 && <SV_AXIS_1_HOME_PLUS>  THEN G91 G1 $<SV_AXIS_1_LABEL> [-<PARAM_AUTO_SQUARE_DISTANCE>] F<SV_AXIS_1_HOME_FEEDRATE>
IF <MASTER_AXIS> == 1 && <SV_AXIS_1_HOME_MINUS> THEN G91 G1 $<SV_AXIS_1_LABEL> [ <PARAM_AUTO_SQUARE_DISTANCE>] F<SV_AXIS_1_HOME_FEEDRATE>
IF <MASTER_AXIS> == 2 && <SV_AXIS_2_HOME_PLUS>  THEN G91 G1 $<SV_AXIS_2_LABEL> [-<PARAM_AUTO_SQUARE_DISTANCE>] F<SV_AXIS_2_HOME_FEEDRATE>
IF <MASTER_AXIS> == 2 && <SV_AXIS_2_HOME_MINUS> THEN G91 G1 $<SV_AXIS_2_LABEL> [ <PARAM_AUTO_SQUARE_DISTANCE>] F<SV_AXIS_2_HOME_FEEDRATE>
IF <MASTER_AXIS> == 3 && <SV_AXIS_3_HOME_PLUS>  THEN G91 G1 $<SV_AXIS_3_LABEL> [-<PARAM_AUTO_SQUARE_DISTANCE>] F<SV_AXIS_3_HOME_FEEDRATE>
IF <MASTER_AXIS> == 3 && <SV_AXIS_3_HOME_MINUS> THEN G91 G1 $<SV_AXIS_3_LABEL> [ <PARAM_AUTO_SQUARE_DISTANCE>] F<SV_AXIS_3_HOME_FEEDRATE>
IF <MASTER_AXIS> == 4 && <SV_AXIS_4_HOME_PLUS>  THEN G91 G1 $<SV_AXIS_4_LABEL> [-<PARAM_AUTO_SQUARE_DISTANCE>] F<SV_AXIS_4_HOME_FEEDRATE>
IF <MASTER_AXIS> == 4 && <SV_AXIS_4_HOME_MINUS> THEN G91 G1 $<SV_AXIS_4_LABEL> [ <PARAM_AUTO_SQUARE_DISTANCE>] F<SV_AXIS_4_HOME_FEEDRATE>

N570 ;Re-pair Axis
IF #50001
M295 /$<MASTER_AXIS_LABEL>
M225 #101 "Re-pairing %c Axis" <MASTER_AXIS_LABEL>

;Go Back and Home rest of Axes if AutoSquare Axis was 3rd Axis.
IF <MASTER_AXIS> == 3 THEN GOTO 300

;-----------------------------------------------------------------------------------------
;							            Home Axes
;-----------------------------------------------------------------------------------------
N600
M221 #100 "Setting Home Positions"
IF <SV_AXIS_1_LABEL> != <AXIS_LABEL_IS_N> THEN M26 /$<SV_AXIS_1_LABEL>
IF <SV_AXIS_2_LABEL> != <AXIS_LABEL_IS_N> THEN M26 /$<SV_AXIS_2_LABEL>
IF <SV_AXIS_3_LABEL> != <AXIS_LABEL_IS_N> THEN M26 /$<SV_AXIS_3_LABEL>
IF <SV_AXIS_4_LABEL> != <AXIS_LABEL_IS_N> THEN M26 /$<SV_AXIS_4_LABEL>
IF <SV_AXIS_5_LABEL> != <AXIS_LABEL_IS_N> THEN M26 /$<SV_AXIS_5_LABEL>
IF <SV_AXIS_6_LABEL> != <AXIS_LABEL_IS_N> THEN M26 /$<SV_AXIS_6_LABEL>
IF <SV_AXIS_7_LABEL> != <AXIS_LABEL_IS_N> THEN M26 /$<SV_AXIS_7_LABEL>
IF <SV_AXIS_8_LABEL> != <AXIS_LABEL_IS_N> THEN M26 /$<SV_AXIS_8_LABEL>

N1000                            ;End of Macro