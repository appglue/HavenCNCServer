<Window x:Class="HavenCNCServer.WPF.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Settings"
        Height="600"
        Width="700"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar with Close Button -->
        <Grid Grid.Row="0"
              Background="{DynamicResource MaterialDesign.Brush.Primary}"
              Height="50">
            <TextBlock Text="Settings"
                       FontSize="20"
                       FontWeight="Medium"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>
            <Button Content="✕"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    Width="40"
                    Height="40"
                    FontSize="20"
                    Foreground="White"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Cancel_Click"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,20,30,20">
                <!-- API URL -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="API URL"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               FontWeight="Medium"
                               FontSize="14"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="txtApiUrl"
                             Text="http://localhost:5000"
                             materialDesign:HintAssist.Hint="Enter API URL"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="13"/>
                </StackPanel>

                <!-- Swagger URL -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Swagger URL"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               FontWeight="Medium"
                               FontSize="14"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="txtSwaggerUrl"
                             Text="http://localhost:5000/swagger"
                             materialDesign:HintAssist.Hint="Enter Swagger URL"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="13"/>
                </StackPanel>

                <!-- CNC12 Path -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="CNC12 Installation Path"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               FontWeight="Medium"
                               FontSize="14"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="txtCnc12Path"
                             Text="C:\\cncm"
                             materialDesign:HintAssist.Hint="Enter CNC12 path"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                Background="{DynamicResource MaterialDesign.Brush.Background}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,15,20,15">
                <Button Content="CANCEL"
                        Width="120"
                        Height="36"
                        Margin="0,0,15,0"
                        Click="Cancel_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                <Button Content="SAVE"
                        Width="120"
                        Height="36"
                        Click="Save_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
