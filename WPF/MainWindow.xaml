<Window x:Class="HavenCNCServer.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HavenCNCServer.WPF.ViewModels"
        xmlns:controls="clr-namespace:HavenCNCServer.WPF.Controls"
        Title="HavenCNC Server (WPF)"
        Width="650"
        WindowStartupLocation="Manual"
        Topmost="{Binding IsAlwaysOnTop}"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings"
                          Command="{Binding OpenSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Always on Top"
                          IsCheckable="True"
                          IsChecked="{Binding IsAlwaysOnTop}"
                          Command="{Binding ToggleAlwaysOnTopCommand}"/>
                <Separator/>
                <MenuItem Header="_Logs"
                          Command="{Binding ShowLogsCommand}"/>
                <MenuItem Header="_Messages"
                          Command="{Binding ShowMessagesCommand}"/>
                <MenuItem Header="_G-Code"
                          Command="{Binding ShowGCodeCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_G-Code Test"
                          Command="{Binding ShowGCodeTestCommand}"/>
                <MenuItem Header="Open _Browser UI"
                          Command="{Binding OpenBrowserUICommand}"/>
                <MenuItem Header="Open _Swagger"
                          Command="{Binding OpenSwaggerCommand}"/>
            </MenuItem>
            <MenuItem Header="_Admin">
                <MenuItem Header="Open _Data Folder"
                          Command="{Binding OpenDataFolderCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom"
                   Height="30">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CNC12: "/>
                    <TextBlock Text="{Binding IsCnc12Running}"
                               FontWeight="Bold"/>
                    <TextBlock Text="  |  Connection: "
                               Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding IsConnected}"
                               FontWeight="Bold"/>
                    <TextBlock Text="  |  Retries: "
                               Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding ConnectionRetryCount}"
                               FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Large Launch UI Button -->
            <Button Grid.Row="0"
                    Content="LAUNCH UI"
                    Command="{Binding OpenBrowserUICommand}"
                    Height="60"
                    Margin="0,0,0,15"
                    Background="#2196F3"
                    Foreground="White"
                    FontSize="20"
                    FontWeight="Bold"
                    BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background"
                                Value="#2196F3"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderThickness="0"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#0D47A1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- CNC Control Buttons -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="CNC Control"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <!-- Primary Control Buttons (2x2 Grid) -->
                <UniformGrid Columns="2"
                             Rows="2"
                             Margin="0,0,0,10">
                    <Button Content="{Binding ResetButtonLabel}"
                            Command="{Binding ResetButtonCommand}"
                            Height="50"
                            Margin="0,0,2.5,2.5"
                            Background="Red"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RequiresReset}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="White"/>
                                        <Setter Property="Foreground"
                                                Value="Red"/>
                                        <Setter Property="BorderBrush"
                                                Value="Red"/>
                                        <Setter Property="BorderThickness"
                                                Value="3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="STOP"
                            Command="{Binding StopButtonCommand}"
                            Height="50"
                            Margin="2.5,0,0,2.5"
                            Background="Orange"
                            FontSize="14"
                            FontWeight="Bold"/>
                    <Button Content="CANCEL CYCLE"
                            Command="{Binding CancelCycleButtonCommand}"
                            Height="50"
                            Margin="0,2.5,2.5,0"
                            Background="Blue"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"/>
                    <Button Content="START CYCLE"
                            Command="{Binding StartCycleButtonCommand}"
                            Height="50"
                            Margin="2.5,2.5,0,0"
                            Background="Green"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"/>
                </UniformGrid>

                <!-- Secondary Toggle Buttons (1x3 Grid) -->
                <TextBlock Text="Toggle Controls"
                           FontSize="12"
                           Margin="0,5,0,5"/>
                <UniformGrid Columns="3"
                             Rows="1">
                    <ToggleButton Content="TOOL CHECK"
                                  Command="{Binding ToolCheckToggleCommand}"
                                  IsChecked="{Binding IsToolCheckActive, Mode=TwoWay}"
                                  Height="40"
                                  Margin="0,0,2.5,0"
                                  FontSize="12"
                                  FontWeight="Bold">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background"
                                        Value="White"/>
                                <Setter Property="Foreground"
                                        Value="Black"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="DarkGray"/>
                                        <Setter Property="Foreground"
                                                Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <ToggleButton Content="FEED HOLD"
                                  Command="{Binding FeedHoldToggleCommand}"
                                  IsChecked="{Binding IsFeedHoldActive, Mode=TwoWay}"
                                  Height="40"
                                  Margin="2.5,0,2.5,0"
                                  FontSize="12"
                                  FontWeight="Bold">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background"
                                        Value="White"/>
                                <Setter Property="Foreground"
                                        Value="Black"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="DarkGray"/>
                                        <Setter Property="Foreground"
                                                Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <ToggleButton Content="HOMED"
                                  Command="{Binding HomedToggleCommand}"
                                  IsChecked="{Binding IsMachineHomed, Mode=TwoWay}"
                                  Height="40"
                                  Margin="2.5,0,0,0"
                                  FontSize="12"
                                  FontWeight="Bold">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background"
                                        Value="White"/>
                                <Setter Property="Foreground"
                                        Value="Black"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="DarkGray"/>
                                        <Setter Property="Foreground"
                                                Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </UniformGrid>

                <!-- CNC12 Control Buttons -->
                <TextBlock Text="CNC12 Control"
                           FontSize="12"
                           Margin="0,15,0,5"/>
                <UniformGrid Columns="3"
                             Rows="1">
                    <Button Content="START CNC12"
                            Command="{Binding StartCnc12Command}"
                            IsEnabled="{Binding CanStartCnc12}"
                            Height="40"
                            Margin="0,0,2.5,0"
                            Background="#4CAF50"
                            Foreground="White"
                            FontSize="11"
                            FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    CornerRadius="3"
                                                    Opacity="{TemplateBinding Opacity}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled"
                                             Value="False">
                                        <Setter Property="Opacity"
                                                Value="0.5"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#45A049"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="RESTART CNC12"
                            Command="{Binding RestartCnc12Command}"
                            IsEnabled="{Binding CanRestartCnc12}"
                            Height="40"
                            Margin="2.5,0,2.5,0"
                            Background="#FF9800"
                            Foreground="White"
                            FontSize="11"
                            FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    CornerRadius="3"
                                                    Opacity="{TemplateBinding Opacity}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled"
                                             Value="False">
                                        <Setter Property="Opacity"
                                                Value="0.5"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#F57C00"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="SHUTDOWN CNC12"
                            Command="{Binding ShutdownCnc12Command}"
                            IsEnabled="{Binding CanShutdownCnc12}"
                            Height="40"
                            Margin="2.5,0,0,0"
                            Background="#F44336"
                            Foreground="White"
                            FontSize="11"
                            FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    CornerRadius="3"
                                                    Opacity="{TemplateBinding Opacity}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled"
                                             Value="False">
                                        <Setter Property="Opacity"
                                                Value="0.5"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#D32F2F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>
            </StackPanel>

            <!-- Coordinate Display (DRO) -->
            <controls:CoordinateDisplayControl Grid.Row="2"
                                               Margin="0,20,0,0"/>

            <!-- Tabs for Messages/Logs/GCode -->
            <TabControl Grid.Row="3"
                        Margin="0,20,0,0">
                <TabItem Header="Messages">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="5">
                            <Button Content="Clear"
                                    Command="{Binding ClearMessagesCommand}"
                                    Width="80"
                                    Margin="5,0"/>
                            <Button Content="Open"
                                    Command="{Binding ShowMessagesCommand}"
                                    Width="80"
                                    Margin="5,0"/>
                        </StackPanel>
                        <controls:MessageDisplayControl/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Logs">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="5">
                            <Button Content="Clear"
                                    Command="{Binding ClearLogsCommand}"
                                    Width="80"
                                    Margin="5,0"/>
                            <Button Content="Open"
                                    Command="{Binding ShowLogsCommand}"
                                    Width="80"
                                    Margin="5,0"/>
                        </StackPanel>
                        <controls:LogViewerControl/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="G-Code">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="5">
                            <Button Content="Open"
                                    Command="{Binding ShowGCodeCommand}"
                                    Width="80"
                                    Margin="5,0"/>
                        </StackPanel>
                        <controls:GCodeViewerControl/>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
